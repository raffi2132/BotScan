			local root = newChar:WaitForChild("HumanoidRootPart", 10)
			if root and LocalPlayer.Character == newChar then
				Character = newChar
				PlayerHumpart = root
			end
		end)
		pcall(function()
			ZQ5.cutsceneAt = tick() + 1.5
			ZQ5.lease = 0
			ZQ5.enemy = nil
			ZQ5.hover = false
			ZQ5.attack = false
			ZQ5.lastPin = nil
			ZQ5.lastHoverAt = 0
			ZQ5.blockHoldUntil = 0
			ZQ5.aboveUntil = 0
			ZQ5.jStepTarget = nil
			ZQ5.fruitDodge = nil
			ZQ5.vdodge = nil
			ZQ5.dodgeUntil = 0
			print("[RESPAWN] new character: old fight state cleared, holding still for 3s")
		end)
	end)
	function ZQ5.move(destination, speed, ctl)
		ctl = ctl or {}
		local hrp = PlayerHumpart
		if not hrp or not hrp.Parent then
			return false, "nohrp"
		end
		-- AFTER A GAME TELEPORT (user 2026-11-01: teleported to the finished base, the walk carried on with the old
		-- Floor 5 path's next points -- off the platform into the air, Greater Flight Strike). For 10s after one, a
		-- move to a spot that's 300+ away and nearer where we were teleported FROM than where we are is refused.
		do
			local goal = ctl.route and ctl.route[#ctl.route] or destination
			if typeof(goal) == "CFrame" then
				goal = goal.Position
			end
			if ZQ5.tpFrom and tick() - (ZQ5.tpAt or 0) < 10 and typeof(goal) == "Vector3" then
				local dNew = (goal - hrp.Position).Magnitude
				if dNew > 300 and (goal - ZQ5.tpFrom).Magnitude < dNew then
					if tick() - (ZQ5.tpRefuseSaid or 0) > 3 then
						ZQ5.tpRefuseSaid = tick()
						print(string.format("[WALK] teleported %.0fs ago - not walking back toward the old spot (%.0f away)", tick() - ZQ5.tpAt, dNew))
					end
					return false, "teleported"
				end
			end
		end

		for _, obj in ipairs(hrp:GetChildren()) do
			if obj:IsA("BodyMover") or obj:IsA("Constraint") then
				obj:Destroy()
			end
		end

		local RunSvc = game:GetService("RunService")
		local cam = workspace.CurrentCamera
		local maxCamDist = (cam and (cam.CFrame.Position - hrp.Position).Magnitude or 0) + 3

		-- water fix (quest5): swimming buoyancy cancels downward moves
		local hum = Character and Character:FindFirstChildOfClass("Humanoid")
		local swimWasEnabled = true
		if hum then
			pcall(function()
				swimWasEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Swimming)
				hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
				-- PlatformStand only, NOT ChangeState(Physics): the game's RagdollHandler
				-- (ReplicatedStorage.RagdollHandler, StateChanged) ragdolls the character the moment
				-- it enters the Physics state -- every limb's joint detached -- and un-ragdolls it on
				-- any other state. Every walk dragged a ragdoll: the loose limbs pulled the root back
				-- 1.3-3 studs per physics step (measured 2026-10-15: ~7 studs/s net at speed 40).
				hum.PlatformStand = true
				if hum:GetState() == Enum.HumanoidStateType.Physics then
					hum:ChangeState(Enum.HumanoidStateType.GettingUp) -- leaves a ragdoll left over from before
				end
			end)
		end

		-- ctl.route: a list of points followed in ONE move (no stop, no humanoid state reset
		-- between them). Per-point moves toggled PlatformStand / GettingUp at every waypoint:
		-- the humanoid stood up for a frame and pushed the root up/down -> visible bobbing.
		local st = {
			finished = false,
			reason = nil,
			lastSet = nil,
			stuckT = 0,
			speed = speed or 80,
			dest = ctl.route and ctl.route[1] or destination,
			route = ctl.route,
			idx = 1,
			paused = false,
		}
		local id = "ZephyronMove_" .. tostring(math.random(1, 1e9))
		ZQ5.moving = true

		-- BODYVELOCITY MOVER (user, 2026-10-26; ZephyronCombat.MoveMode = "cframe": the old way). Was:
		-- the root CFrame set every frame with velocity 0 -- the server saw us cover ground while our
		-- velocity said 0, and the CFrame went straight through walls (389 maze noclip flags on one
		-- account). Now a BodyVelocity aims at the next route point every frame: real velocity that
		-- matches the movement, and walls stop us (the no-progress check below then ends the move as
		-- "stuck", and walkTo backs up and re-paths).
		local useBV = (getgenv().ZephyronCombat or {}).MoveMode ~= "cframe"

		-- (Zephyron's travel protections, user 2026-10-26)
		-- #2 SPEED FOLLOWS THE SERVER: the character's SpeedBypass attribute is the speed the server
		-- currently allows on top (movement skills etc.). Walk at the higher of our speed and
		-- SpeedBypass - 10 (Zephyron: max(SpeedBypass, base) - 10), read live every frame.
		st.baseSpeed = st.speed
		st.liveSpeed = function()
			local spb = 0
			pcall(function()
				spb = tonumber(Character:GetAttribute("SpeedBypass")) or 0
			end)
			return math.max(st.baseSpeed, spb - 10)
		end
		-- #1 SHORT SNAP: a single short move (<= 8 studs, no route) is one direct position set
		-- instead of a walk -- at most once every 3s. (Zephyron's 1200+ stud instant jump is NOT
		-- copied: that's a TP Check.)
		if not ctl.route and typeof(destination) == "Vector3" and tick() - (ZQ5.lastSnapAt or 0) >= 3 then
			local d = destination - hrp.Position
			if Vector3.new(d.X, 0, d.Z).Magnitude <= 8 and d.Magnitude <= 8 then
				ZQ5.lastSnapAt = tick()
				hrp.CFrame = CFrame.new(destination) * (hrp.CFrame - hrp.CFrame.Position)
				hrp.AssemblyLinearVelocity = Vector3.zero
				ZQ5.moving = false
				if hum then
					pcall(function()
						hum.PlatformStand = false
						hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, swimWasEnabled)
					end)
				end
				return true, nil
			end
		end
		-- #4 DASH REPORT + #6 KEY TAPS while walking (both off while paused / when done):
		--  #4: tell the server we dashed (takestam "dash", safeDash's 1s cooldown) every 1s, only with
		--      stamina > 50 so it never runs us dry
		--  #6: Zephyron's "shadow-ban bypass": tap W, A, S, D (private VIM) every ~0.4s with WalkSpeed
		--      held at 0, so the client looks like a player pressing keys. ValuesTable.shadowbanbypass
		--      tells the anti-stun not to restore WalkSpeed meanwhile.
		local keyHum = hum
		local savedSpeed = keyHum and keyHum.WalkSpeed or 16
		task.spawn(function()
			local keys = { Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D }
			local lastDash = 0
			while ZQ5.moving and not st.finished do
				pcall(function()
					if st.paused then
						ValuesTable.shadowbanbypass = false
						return
					end
					if tick() - lastDash >= 1 then
						lastDash = tick()
						local stats = game.ReplicatedStorage:FindFirstChild("Stats" .. LocalPlayer.Name)
						local stam = stats and stats:FindFirstChild("Stamina")
						if stam and stam.Value > 50 and safeDash then
							safeDash()
						end
					end
					ValuesTable.shadowbanbypass = true
					for _, key in ipairs(keys) do
						if not ZQ5.moving or st.finished or st.paused then
							break
						end
						if keyHum and keyHum.Parent then
							keyHum.WalkSpeed = 0
						end
						ImpelVim():SendKeyEvent(true, key, false, game)
						task.wait(0.08)
						ImpelVim():SendKeyEvent(false, key, false, game)
						task.wait(0.05)
					end
				end)
				task.wait(0.2)
			end
			pcall(function()
				ValuesTable.shadowbanbypass = false
				for _, key in ipairs(keys) do
					ImpelVim():SendKeyEvent(false, key, false, game) -- never leave a key held
				end
				if keyHum and keyHum.Parent and keyHum.WalkSpeed == 0 then
					keyHum.WalkSpeed = savedSpeed > 0 and savedSpeed or 16
				end
			end)
		end)
		local function moveBV(h)
			local bv = st.bv
			if not (bv and bv.Parent == h) then
				bv = Instance.new("BodyVelocity")
				bv.Name = "ZQ5MoveVel"
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bv.P = 1e5
				bv.Velocity = Vector3.zero
				bv.Parent = h
				st.bv = bv
			end
			return bv
		end

		-- stepped on Heartbeat, not RenderStepped: a minimized / background Roblox window stops
		-- rendering, the walk froze ("no progress for 3s") and nothing held the body up -> it sank
		-- into the floor (noclip). Heartbeat keeps running with the window in the background.
		local moveConn = RunSvc.Heartbeat:Connect(function(dt)
			pcall(function() -- (never an uncaught error: code 691)
			local h = PlayerHumpart
			if not h or not h.Parent then
				st.finished = true
				st.reason = "nohrp"
				return
			end
			for _, mover in ipairs(h:GetChildren()) do
				if mover:IsA("BodyMover") and mover ~= st.bv then
					mover:Destroy()
				end
			end
			-- a game teleport (floor change, cutscene) moves us far in one frame: end the move
			if useBV and st.prevPos and (h.Position - st.prevPos).Magnitude > 40 then
				ZQ5.tpAt, ZQ5.tpFrom = tick(), st.prevPos
				st.finished = true
				st.reason = "teleported"
				return
			end
			st.prevPos = h.Position
			-- STUN HOLD: a mob hit us mid-walk. The anti-stun clears the stun on our side, but the
			-- server still holds us for it: walking on got snapped back -> [AC] tpcheck + "no
			-- progress", 1:1 with the stuns (2026-10-15, maze). Stand still for StunHold (0.6s).
			local stunHeld = tick() - (ZQ5.stunnedAt or 0) < ((getgenv().ZephyronCombat or {}).StunHold or 0.6)
			-- ...EXCEPT under a falling spike trap (user 2026-10-28): holding there let the next spike re-stun us
			-- until the knockback threw us out -- keep walking and get out of the column (a TP check from the
			-- server's stun is cheaper than the spikes). ZephyronCombat.SpikeWalkThrough = false: hold as before.
			if stunHeld and (getgenv().ZephyronCombat or {}).SpikeWalkThrough ~= false
				and ZQ5.inSpikeColumn and ZQ5.inSpikeColumn(h.Position) then
				stunHeld = false
				if tick() - (ZQ5.spikeWalkSaid or 0) > 3 then
					ZQ5.spikeWalkSaid = tick()
					print("[TRAP] stunned under a falling spike trap - walking on out of it")
				end
			end
			-- (Blugori's spin lock: the walker never moves us while he spins -- the hover / block stand has us)
			if st.paused or stunHeld or ZQ5.inCutscene() or tick() < (ZQ5.spinLockUntil or 0) then -- (cutscene: stand still, the game holds us)
				-- hold the spot while paused (anticheat wait). Only zeroing velocity let gravity
				-- pull us down 2-3 studs a frame with noclip on: fell through Floor 2 into the void.
				st.pauseAt = st.pauseAt or h.Position
				if useBV then
					moveBV(h).Velocity = Vector3.zero -- holds us up (infinite force), no CFrame snap
				else
					h.CFrame = CFrame.new(st.pauseAt) * (h.CFrame - h.CFrame.Position)
				end
				h.AssemblyLinearVelocity = Vector3.zero
				return
			end
			st.pauseAt = nil

			local pos = h.Position
			local rot = h.CFrame - h.CFrame.Position
			local route = st.route
			local budget = st.liveSpeed() * dt
			local toTarget = st.dest - pos
			local dist = toTarget.Magnitude
			-- reached a route point: carry the rest of this frame's step on to the next one
			while route and st.idx < #route and dist <= math.max(budget, 0.5) do
				budget = budget - dist
				pos = st.dest
				if ctl.onReach then
					pcall(ctl.onReach, st.idx, st.dest)
				end
				st.idx = st.idx + 1
				st.dest = route[st.idx]
				toTarget = st.dest - pos
				dist = toTarget.Magnitude
			end

			if dist <= 0.5 then
				if st.bv then
					st.bv.Velocity = Vector3.zero
				end
				h.CFrame = CFrame.new(st.dest) * rot -- (at most 0.5 studs)
				h.AssemblyLinearVelocity = Vector3.zero
				st.lastSet = st.dest
				if route and ctl.onReach then
					pcall(ctl.onReach, st.idx, st.dest)
				end
				st.finished = true
				return
			end

			local nextPos = pos + toTarget.Unit * math.min(math.max(budget, 0), dist)

			-- flame trap ahead that's burning (or about to): wait at its edge (ZQ5.trapBlocks, set up
			-- with the trap tracker). Gives up waiting on one move after 15s.
			if ZQ5.trapBlocks and not st.trapIgnore then
				local okB, blocked = pcall(ZQ5.trapBlocks, pos, nextPos, st.speed, st.dest)
				if okB and blocked then
					if not st.trapHold then
						st.trapHold = tick()
						print("[TRAPS] flame trap ahead, waiting for it to go out")
					elseif tick() - st.trapHold > 15 then
						st.trapIgnore = true
						print("[TRAPS] waited 15s, crossing anyway")
					end
					if useBV then
						moveBV(h).Velocity = Vector3.zero
					else
						h.CFrame = CFrame.new(pos) * rot
					end
					h.AssemblyLinearVelocity = Vector3.zero
					st.lastSet = pos
					return
				elseif st.trapHold then
					st.trapHold = nil
				end
			end

			if ctl.wallMargin then
				local valid, blocked = getValidMovementPosition(pos, nextPos, ctl.wallMargin)
				if blocked then
					nextPos = valid
					if (valid - pos).Magnitude < 0.05 then
						st.stuckT = st.stuckT + dt
					else
						st.stuckT = 0
					end
				else
					st.stuckT = 0
				end
			end

			if useBV then
				-- the velocity that carries us from where we ARE to this frame's point, never faster
				-- than the walk speed
				local v = (nextPos - h.Position) / math.max(dt, 1 / 240)
				local cap = st.liveSpeed()
				if v.Magnitude > cap then
					v = v.Unit * cap
				end
				moveBV(h).Velocity = v
				-- stay upright and keep the facing we started with (bumps would tip the limp body):
				-- a rotation-only set, at the position we're already at
				if not st.rot then
					local lv = rot.LookVector
					local flat = Vector3.new(lv.X, 0, lv.Z)
					st.rot = flat.Magnitude > 1e-3 and CFrame.lookAt(Vector3.zero, flat) or CFrame.new() -- yaw only
				end
				h.CFrame = CFrame.new(h.Position) * st.rot
				h.AssemblyAngularVelocity = Vector3.zero
			else
				h.CFrame = CFrame.new(nextPos) * rot
				h.AssemblyLinearVelocity = Vector3.zero
			end
			st.lastSet = nextPos
			end)
		end)

		local driftConn = RunSvc.Heartbeat:Connect(function()
			if useBV then
				return -- physics moves us: nothing to snap back (teleports are caught in the mover)
			end
			local h = PlayerHumpart
			if not h or not st.lastSet or st.finished or st.paused then
				return
			end
			local drift = (h.Position - st.lastSet).Magnitude
			if drift > 40 then
				-- the GAME moved us (floor change, cutscene): never drag the body back
				ZQ5.tpAt, ZQ5.tpFrom = tick(), st.lastSet
				st.finished = true
				st.reason = "teleported"
				return
			end
			local hum2 = Character and Character:FindFirstChildOfClass("Humanoid")
			local d = h.Position - st.lastSet
			local sideways = Vector3.new(d.X, 0, d.Z).Magnitude
			if drift > 3 and sideways > 2 and d.Y > -sideways then
				-- knocked sideways (an NPC hit / ragdoll): just keep going from where it left us.
				-- No snap back (a teleport for the server), no stopping the move.
				st.lastSet = h.Position
			elseif drift > 0.05 then
				local rot = h.CFrame - h.CFrame.Position
				h.CFrame = CFrame.new(st.lastSet) * rot
			end
			h.AssemblyLinearVelocity = Vector3.zero
			h.AssemblyAngularVelocity = Vector3.zero
		end)

		RunSvc:BindToRenderStep(id .. "_cam", Enum.RenderPriority.Last.Value, function()
			local camera = workspace.CurrentCamera
			local h = PlayerHumpart
			if not camera or not h then
				return
			end
			local offset = camera.CFrame.Position - h.Position
			if offset.Magnitude > maxCamDist then
				local newPos = h.Position + offset.Unit * maxCamDist
				camera.CFrame = CFrame.new(newPos) * (camera.CFrame - camera.CFrame.Position)
			end
		end)

		-- the poll runs on the normal scheduler, so it may yield (anticheat waits, hops)
		local bestDist, bestAt = math.huge, tick()
		pcall(function()
			while not st.finished do
				task.wait()
				if getgenv().ZQ_PAUSE then
					st.reason = "paused"
					break
				end
				-- no progress for 3s (not paused): give up this move ("stuck" -> walkTo backs up
				-- and re-paths). Was: stood in one spot forever with a limp body.
				local hh = PlayerHumpart
				if hh and not st.paused and not st.trapHold and tick() - (ZQ5.stunnedAt or 0) > 1 then
					local d = (hh.Position - st.dest).Magnitude
					if d < bestDist - 1 or (st.idx or 1) ~= (st.lastIdx or 1) then
						bestDist, bestAt = d, tick()
						st.lastIdx = st.idx
					elseif tick() - bestAt > ((ZQ5.inMazeFloor and ZQ5.inMazeFloor()) and 1.2 or 3) then
						-- (the maze: 1.2s -- pressing into a wall for 3s looked like trying to walk through it)
						print(string.format("[WALK] no progress for %.1fs at %s, ending this move", tick() - bestAt, tostring(hh.Position)))
						st.reason = "stuck"
						break
					end
				else
					bestAt = tick()
				end
				if ctl.poll then
					local r = ctl.poll(st)
					if r then
						st.reason = r
						break
					end
				end
			end
		end)

		moveConn:Disconnect()
		RunSvc:UnbindFromRenderStep(id .. "_cam")
		driftConn:Disconnect()
		if st.bv then
			pcall(function()
				st.bv:Destroy()
			end)
			st.bv = nil
		end
		ZQ5.moving = false
		if PlayerHumpart then
			PlayerHumpart.AssemblyLinearVelocity = Vector3.zero
		end
		if hum then
			pcall(function()
				hum.PlatformStand = false
				hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, swimWasEnabled)
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
		return st.finished and st.reason == nil, st.reason
	end


	-- MAZE BLOCKERS: walls the server has and our client doesn't (Floor 1). Each noclip flag in the
	-- maze drops invisible, solid, client-only blocks where we were (now and ~0.25s ago: the notice
	-- arrives a beat late). The pathfinder and the wall-clearance check then route around them, so
	-- the same hidden wall can't flag us twice. They're removed when Floor 1 is gone.
	ZQ5.inMazeFloor = function()
		local isl = workspace:FindFirstChild("Islands")
		return isl ~= nil and isl:FindFirstChild("Impel Base - Floor 1") ~= nil and isl:FindFirstChild("Impel Base - Floor 2") == nil
	end
	ZQ5.posTrail = ZQ5.posTrail or {}
	if not ZQ5.posTrailConn then
		ZQ5.posTrailConn = game:GetService("RunService").Heartbeat:Connect(function()
			local h = PlayerHumpart
			if h and h.Parent then
				local t = ZQ5.posTrail
				t[#t + 1] = { at = tick(), p = h.Position }
				if #t > 40 then
					table.remove(t, 1)
				end
			end
		end)
	end
	ZQ5.addMazeBlocker = function()
		local folder = workspace:FindFirstChild("ImpelMazeBlockers")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "ImpelMazeBlockers"
			folder.Parent = workspace
		end
		local now = PlayerHumpart and PlayerHumpart.Position
		local before = now
		for i = #ZQ5.posTrail, 1, -1 do
			if tick() - ZQ5.posTrail[i].at >= 0.25 then
				before = ZQ5.posTrail[i].p
				break
			end
		end
		local made = 0
		for _, p in ipairs({ now, before }) do
			if p then
				local dup = false
				for _, b in ipairs(folder:GetChildren()) do
					if (b.Position - p).Magnitude < 2 then
						dup = true
						break
					end
				end
				if not dup then
					local b = Instance.new("Part")
					b.Name = "Blocker"
					b.Anchored = true
					b.CanCollide = true
					b.CanQuery = true
					b.CanTouch = false
					b.Transparency = 1
					b.Size = Vector3.new(4, 10, 4)
					b.Position = Vector3.new(p.X, p.Y + 2, p.Z)
					b.Parent = folder
					made += 1
				end
			end
		end
		print(string.format("[WALK] maze: noclip flag at %s -> %d invisible blocker(s) there (%d total), finding another route",
			tostring(now), made, #folder:GetChildren()))
	end
	task.spawn(function()
		while task.wait(5) do
			pcall(function()
				local folder = workspace:FindFirstChild("ImpelMazeBlockers")
				if folder and not ZQ5.inMazeFloor() then
					folder:Destroy()
				end
			end)
		end
	end)

	-- GROUND WALK: the game now flags head-in-geometry (OverlapHead), flying more than 15
	-- studs over the floor (Greater Flight Strike) and moving too fast (TP check). So travel the
	-- way a player walks: PathfindingService waypoints, root at standing height, 30 studs/s.
	-- Falls back to the old straight move when no path is found.
	local PathfindingService = game:GetService("PathfindingService")
	-- 28, not 40 (2026-10-15): once walks stopped dragging a ragdoll (they really moved at 40
	-- instead of ~7-20) the server's speed check snapped us back -- [AC] tpcheck + "no progress"
	-- in a loop. ZephyronCombat.WalkSpeed overrides.
	local WALK_SPEED = (getgenv().ZephyronCombat or {}).WalkSpeed or 50 -- was 60 (2026-10-16); 50 keeps under the TP Check ("18 | 17" at 60, 2026-10-26)
	-- read live on every walk: ZephyronCombat.WalkSpeed (everywhere) and MazeWalkSpeed (Floor 1,
	-- default 50: outrun the maze mobs. The tpcheck flags at 34/40 came with mob stuns (the
	-- walk now stands still through a stun, see STUN HOLD), 2026-10-15)
	-- FLOOR 5 BRIDGE LEG (user 2026-10-27): the walk to Floor 5's Part2 (10594, 491, -28464) runs down a
	-- long bridge with a venom barrage and falling spike traps that break block. On that leg: no walking-
	-- protection block (ZQ5.f5BridgeLeg, read by the SetBlocking loop) and a faster walk.
	-- inside a FallingTrap's spike column (its "Primary" bar, +3 margin, anywhere below it)? Used by the walker's
	-- stun hold (user 2026-10-28): standing still for a stun UNDER the trap let the next spike re-stun us, again
	-- and again, until the knockback pushed us out
	local spikeCols, spikeColsAt = {}, 0
	function ZQ5.inSpikeColumn(p)
		if tick() - spikeColsAt > 2 then
			spikeColsAt = tick()
			spikeCols = {}
			for _, root in ipairs({ workspace:FindFirstChild("Islands"),
				workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("Environment") }) do
				for _, t in ipairs(root and root:GetChildren() or {}) do
					local bar = t.Name == "FallingTrap" and (t:FindFirstChild("Hitbox") or t.PrimaryPart or t:FindFirstChild("Primary", true)) -- (the "Hitbox" part, 42 x 42 x 78; "Primary" is inside "Log", never a direct child -- no trap was ever found, user 2026-11-01)
					if bar and bar:IsA("BasePart") then
						spikeCols[#spikeCols + 1] = bar
					end
				end
			end
		end
		for _, bar in ipairs(spikeCols) do
			if bar.Parent and p.Y < bar.Position.Y + bar.Size.Y / 2 + 10 and p.Y > bar.Position.Y - 150 then
				local lp = bar.CFrame:PointToObjectSpace(p)
				if math.abs(lp.X) <= bar.Size.X / 2 + 3 and math.abs(lp.Z) <= bar.Size.Z / 2 + 3 then
					return true
				end
			end
		end
		return false
	end

	-- SPIKE-TRAP MOBS (user 2026-10-31, the fight before Vera): a mob within SpikeMobRadius (20) of a falling spike
	-- trap -- under its bar or within 20 of the bar's edge, anywhere below it -- is never hovered onto: every
	-- picker skips it and the rest are fought first. When only those are left, ZQ5.spikeLure walks us 45-75 out
	-- from the trap (on the far side of the mob, ground under the spot, clear of every trap) and waits for the
	-- mob to come out to us -- melee mobs chase. One that stays put (a gunner shooting from under it) is fought
	-- there after SpikeLureTime (15s), for 30s, with the hover spot moved beside the bar (spikeShift) as before.
	-- ZephyronCombat.SpikeMobAvoid = false: off.
	function ZQ5.nearSpike(p, r)
		ZQ5.inSpikeColumn(p) -- (refreshes the trap list)
		for _, bar in ipairs(spikeCols) do
			if bar.Parent and p.Y < bar.Position.Y + bar.Size.Y / 2 + 10 and p.Y > bar.Position.Y - 150 then
				local lp = bar.CFrame:PointToObjectSpace(p)
				local dx = math.max(math.abs(lp.X) - bar.Size.X / 2, 0)
				local dz = math.max(math.abs(lp.Z) - bar.Size.Z / 2, 0)
				if math.sqrt(dx * dx + dz * dz) <= r then
					return bar
				end
			end
		end
		return nil
	end
	ZQ5.spikeGaveUp = setmetatable({}, { __mode = "k" })
	function ZQ5.spikeMob(npc)
		local cfg = getgenv().ZephyronCombat or {}
		if cfg.SpikeMobAvoid == false or not npc then
			return false
		end
		-- FLOOR 5 ONLY (user 2026-11-04): only Floor 5's step loop ever calls spikeLure. On Floor 3 a pistol
		-- Impel Prisoner 11 studs from the trap was skipped by every picker with nothing to lure it, so
		-- FirstBarrier stayed shut and we re-walked to Part1 until the 15-min rejoin (imparalyzedstill1).
		if not workspace.Islands:FindFirstChild("Impel Base - Floor 5") then
			return false
		end
		local r = npc:FindFirstChild("HumanoidRootPart")
		local h = npc:FindFirstChildOfClass("Humanoid")
		if not (r and h and h.Health > 0) then
			return false
		end
		if tick() < (ZQ5.spikeGaveUp[npc] or 0) then
			return false -- waited it out: fight it where it is
		end
		if string.find(npc.Name, "Vera", 1, true) or string.find(tostring(npc:GetAttribute("RealName") or ""), "Vera", 1, true) then
			return false -- (Vera is never one: her fight has its own handling)
		end
		return ZQ5.nearSpike(r.Position, cfg.SpikeMobRadius or 20) ~= nil
	end
	function ZQ5.spikeLure(mob)
		local cfg = getgenv().ZephyronCombat or {}
		local mr = mob and mob:FindFirstChild("HumanoidRootPart")
		if not (mr and PlayerHumpart) then
			return
		end
		local st = ZQ5.lure
		if st and tick() - (st.last or 0) > 3 then
			st = nil -- (a new lure: the last one ended -- it came out, or we fought in between)
		end
		if not st or st.mob ~= mob then
			st = { mob = mob, at = tick() }
			ZQ5.lure = st
			print("[TRAP] " .. tostring(mob:GetAttribute("RealName") or mob.Name) .. " is by a falling spike trap - luring it out")
		end
		st.last = tick()
		-- (user 2026-11-01) not out after SpikeLureTime: a second try from closer -- 28-40 from the mob, just outside
		-- the trap zone, so it notices us -- for another SpikeLureTime before fighting it where it is
		if not st.close and tick() - st.at > (cfg.SpikeLureTime or 15) then
			st.close, st.spot = true, nil
			print("[TRAP] " .. tostring(mob:GetAttribute("RealName") or mob.Name) .. " didn't come out - luring from closer")
		end
		if tick() - st.at > (cfg.SpikeLureTime or 15) * 2 then
			ZQ5.spikeGaveUp[mob] = tick() + 30
			ZQ5.lure = nil
			print("[TRAP] " .. tostring(mob:GetAttribute("RealName") or mob.Name) .. " stayed by the trap - fighting it there (hover beside the trap)")
			return
		end
		if not st.spot then
			local bar = ZQ5.nearSpike(mr.Position, (cfg.SpikeMobRadius or 20) + 5)
			local from = bar and bar.Position or PlayerHumpart.Position
			local away = Vector3.new(mr.Position.X - from.X, 0, mr.Position.Z - from.Z)
			if away.Magnitude < 1 then
				away = Vector3.new(PlayerHumpart.Position.X - mr.Position.X, 0, PlayerHumpart.Position.Z - mr.Position.Z)
			end
			away = away.Magnitude > 1e-3 and away.Unit or Vector3.new(0, 0, 1)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			rp.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
			pcall(function()
				rp.RespectCanCollide = true
			end)
			for _, dist in ipairs(st.close and { 28, 34, 40 } or { 45, 60, 75 }) do
				for _, ang in ipairs({ 0, 40, -40, 80, -80 }) do
					local dir = CFrame.Angles(0, math.rad(ang), 0):VectorToWorldSpace(away)
					local p = mr.Position + dir * dist
					local g = workspace:Raycast(p + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), rp)
					if g and math.abs(g.Position.Y - mr.Position.Y) < 15
						and not ZQ5.nearSpike(g.Position + Vector3.new(0, 3, 0), (cfg.SpikeMobRadius or 20) + (st.close and 3 or 5)) then
						st.spot = g.Position + Vector3.new(0, 3, 0)
						break
					end
				end
				if st.spot then
					break
				end
			end
			if not st.spot then
				ZQ5.spikeGaveUp[mob] = tick() + 30
				ZQ5.lure = nil
				print("[TRAP] no clear spot to lure " .. tostring(mob.Name) .. " to - fighting it there (hover beside the trap)")
				return
			end
		end
		if (PlayerHumpart.Position - st.spot).Magnitude > 8 then
			pcall(tweenWithTeleport, CFrame.new(st.spot), Speed, selected_Offset)
		else
			task.wait(0.3) -- there: wait for it to come out of the trap zone
		end
	end

	-- FLOOR 5 "SEEN" HEARTBEAT (user 2026-10-28: 1v walked BACK to Part1 after a 61s Demon Jester fight at
	-- Part4). f5LastSeen was only refreshed by the Floor 5 step loop, which doesn't run during a fight-first
	-- fight -- a fight over 60s read as "Floor 5 unseen for 60s = a new run" -> FirstTimeFloor5 -> Part1.
	-- Refreshed here every 2s while the Floor 5 island exists, whatever else is running.
	task.spawn(function()
		while true do
			task.wait(2)
			pcall(function()
				local isl = workspace:FindFirstChild("Islands")
				if isl and isl:FindFirstChild("Impel Base - Floor 5") and ZQ5.f5LastSeen then
					ZQ5.f5LastSeen = tick()
				end
			end)
		end
	end)

	function ZQ5.f5BridgeLeg()
		local isl = workspace:FindFirstChild("Islands")
		local d = ZQ5.walkDest
		return isl ~= nil and isl:FindFirstChild("Impel Base - Floor 5") ~= nil and d ~= nil
			and Vector3.new(d.X - 10594.2, 0, d.Z + 28463.8).Magnitude < 60
	end
	local function walkSpeed()
		local cfg = getgenv().ZephyronCombat or {}
		if ZQ5.f5BridgeLeg() then
			return cfg.F5BridgeSpeed or 60
		end
		local isl = workspace:FindFirstChild("Islands")
		if isl and isl:FindFirstChild("Impel Base - Floor 1") and not isl:FindFirstChild("Impel Base - Floor 2") then
			return cfg.MazeWalkSpeed or 60
		end
		return cfg.WalkSpeed or WALK_SPEED
	end
	-- Moves walk pathfinding waypoints around walls. MAZE ONLY (Floor 1): if we stay stuck in
	-- the same spot (no path, repeated re-paths, or < 5 studs of progress for 6s), finish with
	-- ONE straight ZQ5.move line from there to the target, through the walls (noclip is on
	-- while moving; noclip flags do not stop that move).
	local MAZE_STUCK_SECONDS = 6
	ZQ5.straight = false
	local stuckPos, stuckSince = nil, 0

	-- the stuck -> straight-line fallback is allowed ONLY while walking to the Floor 2 boss-gate
	-- lever (ZQ5.leverMode); never in the maze
	local function inMaze()
		return ZQ5.leverMode == true
	end

	local function straightThrough(dest, poll, why)
		print(string.format("[WALK] lever: stuck (%s) at %s, going straight to %s", why, tostring(PlayerHumpart.Position), tostring(dest)))
		ZQ5.straight = true
		local ok, reason = ZQ5.move(dest, walkSpeed(), { poll = poll })
		ZQ5.straight = false
		stuckPos, stuckSince = nil, 0
		return ok, reason
	end
	local ROOT_ABOVE_GROUND = 3

	-- ground under `pos`, looking DOWN only from just above it (casting from higher up used to
	-- hit ceilings / tree crowns over the target and lift the destination onto them)
	local function groundYAt(pos, depth)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {
			Character,
			workspace:FindFirstChild("NPCs"),
			workspace:FindFirstChild("Effects"),
		}
		pcall(function()
			params.RespectCanCollide = true
		end)
		local hit = workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -(depth or 14), 0), params)
		return hit and hit.Position.Y or nil
	end

	-- where the root should be when standing at `pos`: on the REAL ground there (navmesh
	-- waypoints sit a little above/below the floor -> we bobbed up and down and sometimes ran a
	-- bit under the floor), at the character's own standing height plus a small margin
	local function standHeight()
		local hum = Character and Character:FindFirstChildOfClass("Humanoid")
		local root = PlayerHumpart
		if hum and root then
			local h = hum.HipHeight + root.Size.Y / 2
			if hum.RigType == Enum.HumanoidRigType.R6 then
				h = 2 + root.Size.Y / 2 -- R6 legs are 2 studs, HipHeight is 0
			end
			return math.max(h, 2.5) + 0.4
		end
		return ROOT_ABOVE_GROUND + 0.4
	end
	function standPointAt(pos, probeUp)
		local up = probeUp or 3
		local gy = groundYAt(pos + Vector3.new(0, up, 0), up + 8)
		if gy then
			return Vector3.new(pos.X, gy + standHeight(), pos.Z)
		end
		return Vector3.new(pos.X, pos.Y + ROOT_ABOVE_GROUND, pos.Z)
	end

	local function computePathExact(from, dest, radius, noJump)
		-- PATH ABORT (user 2026-10-31, the Floor 5 first-fight stand-still): one walkTo can run dozens of
		-- searches (exact, ring, short of it, gaps) x 4 attempts, each slow on the unstreamed first Floor 5 leg
		-- -- 30-50s with mobs in reach and nothing fighting (the in-reach check only ran once, before it all).
		-- Inside walkTo, every search first asks for a mob in reach; one there -> this and every search after
		-- it return at once and walkTo fights it.
		if ZQ5 and ZQ5.pathAbortOk then
			if ZQ5.pathAbort then
				return nil
			end
			if ZQ5.mobToFight then
				local okM, m = pcall(ZQ5.mobToFight)
				if okM and m then
					ZQ5.pathAbort = m
					return nil
				end
			end
		end
		local ok, path = pcall(function()
			local p = PathfindingService:CreatePath({
				AgentRadius = radius or 2.5,
				AgentHeight = 6,
				AgentCanJump = not noJump,
				WaypointSpacing = 4,
			})
			p:ComputeAsync(from, dest)
			return p
		end)
		if not (ok and path and path.Status == Enum.PathStatus.Success) then
			return nil
		end
		local wps = path:GetWaypoints()
		-- sanity, in GROUND heights: a path diving well below both ends (a lower level / under
		-- the floor) or climbing far above them (onto wall tops) is rejected
		local fromG = groundYAt(from, 60) or (from.Y - ROOT_ABOVE_GROUND)
		local destG = groundYAt(dest, 60) or (dest.Y - ROOT_ABOVE_GROUND)
		local lowEnd, highEnd = math.min(fromG, destG) - 15, math.max(fromG, destG) + 25
		-- FLOORS 4 / 5: wider (2026-10-27) -- Floor 5's stairs-and-bridge route dips 30 (Y 542 from 573) and
		-- Floor 4's routes climb 40+ over mounds; the old band rejected both ("waypoint Y ... outside ...")
		local islF = workspace:FindFirstChild("Islands")
		if islF and (islF:FindFirstChild("Impel Base - Floor 4") or islF:FindFirstChild("Impel Base - Floor 5"))
			and not islF:FindFirstChild("Impel Base - Finished") then
			lowEnd, highEnd = math.min(fromG, destG) - 45, math.max(fromG, destG) + 50
		end
		local minY, maxY = math.huge, -math.huge
		for _, w in ipairs(wps) do
			minY = math.min(minY, w.Position.Y)
			maxY = math.max(maxY, w.Position.Y)
		end
		if minY < lowEnd or maxY > highEnd then
			print(string.format("[WALK] rejected path to %s: waypoint Y %.0f..%.0f outside %.0f..%.0f", tostring(dest), minY, maxY, lowEnd, highEnd))
			return nil
		end
		return wps, minY, maxY
	end

	-- the exact target is often unreachable for the navmesh (a chest or key is a solid model
	-- standing right there): try points in a ring around it; the last few studs are a short hop
	local RING = { Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0), Vector3.new(0, 0, 3), Vector3.new(0, 0, -3),
		Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0), Vector3.new(0, 0, 5), Vector3.new(0, 0, -5),
		Vector3.new(4, 0, 4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, -4) }
	local function computePath(from, dest)
		-- a wide agent first: paths hugging walls / cutting corners put our head in the wall
		-- for the server (noclip strikes; enough of them and the game kills you, "eliminated
		-- by Game"). Narrow agent only when the wide one finds nothing.
		-- NO-JUMP paths first (user 2026-10-27: grabbing a Floor 1 chest it rammed a fence forever):
		-- a jump path goes over fences/rails, but the walker moves at ground height and can't jump,
		-- so it walked into the fence, backed up and took the same path again. A path that walks
		-- round them wins; a jump path is only used when there's no other way (and gets hop points).
		local wps, minY, maxY = computePathExact(from, dest, 4, true)
		if wps then
			return wps, minY, maxY, false
		end
		wps, minY, maxY = computePathExact(from, dest, nil, true)
		if wps then
			return wps, minY, maxY, false
		end
		wps, minY, maxY = computePathExact(from, dest, 4)
		if wps then
			return wps, minY, maxY, false
		end
		wps, minY, maxY = computePathExact(from, dest)
		if wps then
			return wps, minY, maxY, false
		end
		for _, off in ipairs(RING) do
			wps, minY, maxY = computePathExact(from, dest + off)
			if wps then
				return wps, minY, maxY, true
			end
		end
		-- still nothing: walk as close as we can get, stepping back along the line toward us. A
		-- target the navmesh can't reach (walled corner, behind a gate) used to give "no path" and
		-- the same move was retried forever with the character standing still.
		local back = Vector3.new(from.X - dest.X, 0, from.Z - dest.Z)
		if back.Magnitude > 2 then
			back = back.Unit
			for _, k in ipairs({ 8, 16, 24, 32, 40 }) do
				if k < Vector3.new(from.X - dest.X, 0, from.Z - dest.Z).Magnitude then
					wps, minY, maxY = computePathExact(from, dest + back * k)
					if wps then
						print(string.format("[WALK] can't reach %s, going to the closest reachable point %d studs short", tostring(dest), k))
						pcall(function()
							-- (user 2026-11-01) a Mini Bunny we can't reach: count it (2 -> ignored, see UNREACHABLE MINI BUNNY)
							local t = Npc
							local tr = t and t:FindFirstChild("HumanoidRootPart")
							if tr and tostring(t:GetAttribute("RealName") or t.Name) == "Mini Bunny" and (tr.Position - dest).Magnitude < 25 then
								ZQ5.bunnyFails = ZQ5.bunnyFails or setmetatable({}, { __mode = "k" })
								ZQ5.bunnyFails[t] = (ZQ5.bunnyFails[t] or 0) + 1
							end
						end)
						return wps, minY, maxY, true
					end
				end
			end
		end
		-- HALFWAY POINTS (user 2026-10-27, Floor 4: "no path" to Part4 470 studs off, forever): path to a
		-- point part of the way along the straight line (1/2, then 1/3, 1/4), on the ground there. We walk
		-- that leg, and the next walk plans the rest from the new spot.
		local flatDist = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z).Magnitude
		-- FLOORS 4 AND 5 ONLY (user 2026-10-27): the stepping stones and halfway points below never run on
		-- any other floor, so walking there stays exactly as it was. (Floor 5 added: from its spawn
		-- Part1 is ~1450 studs off and not streamed in -- no path; 20% of the way is reachable.)
		local isles = workspace:FindFirstChild("Islands")
		local onFloor4 = isles ~= nil
			and (isles:FindFirstChild("Impel Base - Floor 4") ~= nil or isles:FindFirstChild("Impel Base - Floor 5") ~= nil)
			and isles:FindFirstChild("Impel Base - Finished") == nil
		-- STEPPING STONES (2026-10-27, Floor 4, tested on Watduhellbruvv: "here -> Part4" no path, but
		-- here -> FifthBarrier gap 284 wps and that gap -> Part4 60 wps -- the pathfinder gives up on the
		-- whole long route). The floor's OPENED barriers (CanCollide off) are the doorways: walk to the
		-- reachable one with the shortest detour, then the next walk plans from there.
		if onFloor4 and flatDist > 60 then
			local gaps = {}
			local rpG = RaycastParams.new()
			rpG.FilterType = Enum.RaycastFilterType.Exclude
			local excl = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
			pcall(function()
				rpG.RespectCanCollide = true
			end)
			for _, isl in ipairs(workspace.Islands:GetChildren()) do
				local bars = isl:FindFirstChild("Barriers")
				for _, b in ipairs(bars and bars:GetChildren() or {}) do
					if b:IsA("BasePart") and not b.CanCollide then
						excl[#excl + 1] = b
						gaps[#gaps + 1] = b
					end
				end
			end
			rpG.FilterDescendantsInstances = excl
			local cands = {}
			-- FIXED FLOOR 5 STONES (2026-10-27, mapped on Watduhellbruvv): from the spawn platform the route
			-- to Part1 goes NORTH down the stairs and across the bridge (x 9414, z -27790 -> -27460), not
			-- along the straight line east over lava. Stuck spot -> bridge end 145 wps; bridge end -> halfway
			-- to Part1 57 wps (the rest streams in on the way).
			-- ONLY on the first leg: from the spawn side (west of x 9500) toward Part1 (10605, -27458). Used later
			-- (heading to Part4 from Part2) it walked all the way back here, 576 waypoints (user 2026-10-27)
			local toPart1 = Vector3.new(dest.X - 10605.05, 0, dest.Z + 27458.15).Magnitude < 60
			if isles and isles:FindFirstChild("Impel Base - Floor 5") and toPart1 and from.X < 9500 then
				for key, fp in pairs({ F5BridgeEnd = Vector3.new(9414.3, 573.4, -27420) }) do
					local dFrom = Vector3.new(fp.X - from.X, 0, fp.Z - from.Z).Magnitude
					if dFrom > 30 and not (ZQ5.usedGap == key and tick() - (ZQ5.usedGapAt or 0) < 60) then
						cands[#cands + 1] = { b = key, name = key, p = fp, score = dFrom + Vector3.new(dest.X - fp.X, 0, dest.Z - fp.Z).Magnitude }
					end
				end
			end
			for _, b in ipairs(gaps) do
				local hit = workspace:Raycast(Vector3.new(b.Position.X, math.max(b.Position.Y, from.Y + 60), b.Position.Z), Vector3.new(0, -300, 0), rpG)
				if hit then
					local p = hit.Position + Vector3.new(0, standHeight(), 0)
					local dFrom = Vector3.new(p.X - from.X, 0, p.Z - from.Z).Magnitude
					if dFrom > 30 and (not ZQ5.usedGap or ZQ5.usedGap ~= b or tick() - (ZQ5.usedGapAt or 0) > 60) then
						cands[#cands + 1] = { b = b, name = b.Name, p = p, score = dFrom + Vector3.new(dest.X - p.X, 0, dest.Z - p.Z).Magnitude }
					end
				end
			end
			table.sort(cands, function(a, b2)
				return a.score < b2.score
			end)
			for i, cnd in ipairs(cands) do
				if i > 3 then
					break
				end
				wps, minY, maxY = computePathExact(from, cnd.p, 4)
				if not wps then
					wps, minY, maxY = computePathExact(from, cnd.p)
				end
				if wps then
					ZQ5.usedGap, ZQ5.usedGapAt = cnd.b, tick()
					print(string.format("[WALK] no path to %s, going through %s first", tostring(dest), tostring(cnd.name)))
					return wps, minY, maxY, true
				end
			end
		end
		if onFloor4 and flatDist > 40 then
			local topY = math.max(from.Y, dest.Y) + 150 -- (was +30: a ridge in between was higher than that)
			for _, f in ipairs({ 1 / 2, 1 / 3, 1 / 4, 1 / 5 }) do
				local mid = from:Lerp(dest, f)
				local gy = groundYAt(Vector3.new(mid.X, topY, mid.Z), 300)
				if gy then
					local p = Vector3.new(mid.X, gy + standHeight(), mid.Z)
					wps, minY, maxY = computePathExact(from, p, 4)
					if not wps then
						wps, minY, maxY = computePathExact(from, p)
					end
					if wps then
						print(string.format("[WALK] no path to %s, going %d%% of the way first (%.0f studs)", tostring(dest), math.floor(f * 100 + 0.5), flatDist * f))
						return wps, minY, maxY, true
					end
				end
			end
			-- CRAWL (2026-10-27, Floor 5, simulated on Watduhellbruvv: bridge end -> 4 hops -> Barrier1):
			-- the walkway bends off the straight line, so try ground points on a grid around us (up to
			-- 250 studs, about our own height), at least 30 studs closer to the target, best first
			local cands = {}
			for dx = -250, 250, 50 do
				for dz = -250, 250, 50 do
					local gy = groundYAt(Vector3.new(from.X + dx, from.Y + 100, from.Z + dz), 170)
					if gy and math.abs(gy - from.Y) < 60 then
						local p = Vector3.new(from.X + dx, gy + standHeight(), from.Z + dz)
						local s = Vector3.new(dest.X - p.X, 0, dest.Z - p.Z).Magnitude
						if s < flatDist - 30 then
							cands[#cands + 1] = { p = p, s = s }
						end
					end
				end
			end
			table.sort(cands, function(a, b2)
				return a.s < b2.s
			end)
			for i, cnd in ipairs(cands) do
				if i > 12 then
					break
				end
				wps, minY, maxY = computePathExact(from, cnd.p)
				if wps then
					print(string.format("[WALK] no path to %s, crawling to %s first (%.0f studs left)", tostring(dest), tostring(cnd.p), cnd.s))
					return wps, minY, maxY, true
				end
			end
		end
		return nil
	end

	------------------------------------------------------------------
	-- GORO TRAVEL (user, 2026-10-30): on Nightmare+ the long legs fly on Lightning
	-- Form -- the Goro-Goro fruit is equipped for the cast and our own tool goes
	-- back on after. Normal mode never touches this: the walker stays exactly as
	-- it was. Decided per hop, so a mob that dies faster than the form's cooldown
	-- never costs waiting -- the walker takes the short next hop while the
	-- cooldown runs in the background:
	--   under 120 studs            -> walk (cast overhead not worth it)
	--   form ready + long          -> hop
	--   form on cooldown + long    -> hop only if remaining wait + flight still
	--                                 arrives sooner than walking there
	--   no fruit / refused cast    -> walk (never stuck waiting on the form)
	-- Every trip casts a fresh form and ends it on arrival: reusing one across
	-- trips went stale and earned a "TP Check: 164 your Threshold: 112" in the
	-- Wyvern rotation (2026-10-23). Stamina has no fighting reserve (user
	-- 2026-10-30): the game refuses the cast without the stamina for it and a
	-- refusal just means we walk; if the form dies mid-leg we walk from there.
	------------------------------------------------------------------
	-- (all of this lives in a do-block: this file's top scope was 2 registers under Luau's
	-- 200-local limit -- 16 more here killed the compile at HOVER_PAD_SPEED, 2026-10-30)
	do
	local GoroRS = game:GetService("ReplicatedStorage")
	local GoroHeart = game:GetService("RunService").Heartbeat
	local GoroLP = game:GetService("Players").LocalPlayer
	local GORO_SPEED = (getgenv().ZephyronCombat or {}).GoroTravelSpeed or 350
	local GORO_MIN_DIST = (getgenv().ZephyronCombat or {}).GoroTravelMinDist or 120
	local goroEnder = nil -- the "ender" remote the server hands back when it accepts the cast
	local goroReadyAt = 0 -- tick(): when Lightning Form can be cast again
	local goroCd = nil

	local function goroStamina()
		local ok, v = pcall(function()
			local stats = GoroRS:FindFirstChild("Stats" .. GoroLP.Name)
			local s = stats and stats:FindFirstChild("Stamina")
			return s and s.Value or 0
		end)
		if ok and type(v) == "number" then return v end
		return 0
	end

	local function goroCooldown()
		if goroCd then return goroCd end
		local ok, cd = pcall(function()
			return require(GoroRS.Modules.Skills).GetM("Lightning Form").cd
		end)
		goroCd = ((ok and tonumber(cd)) or 14) + 0.5
		return goroCd
	end

	-- is the form really on? no ender back (or stamina dry) = over -- the form can't outlast empty stamina
	local function goroActive()
		return goroEnder ~= nil and goroEnder.Parent ~= nil and goroStamina() > 1
	end

	local function goroRelease()
		local ender = goroEnder
		goroEnder = nil
		goroReadyAt = tick() + goroCooldown()
		if ender then
			pcall(function() ender:FireServer() end)
		end
	end

	local function goroRestoreTool(savedTool)
		pcall(function()
			if savedTool and savedTool.Parent == GoroLP:FindFirstChildOfClass("Backpack") then
				Character.Humanoid:EquipTool(savedTool)
			elseif Character:FindFirstChild("Goro-Goro") then
				Character.Humanoid:UnequipTools()
			end
		end)
	end

	-- cast Lightning Form: waits out the cooldown instead of casting into a refusal
	-- (retrying into refusals burned 13 refused trips in 13s in the Wyvern rotation).
	-- true = the form is on and the ender is held.
	local function goroCast()
		if goroActive() then return true end
		goroEnder = nil
		local readyIn = goroReadyAt - tick()
		if readyIn > 0 then
			task.wait(math.min(readyIn, 20))
		end
		-- the fruit must be HELD for the cast to be accepted
		if not Character:FindFirstChild("Goro-Goro") then
			local backpack = GoroLP:FindFirstChildOfClass("Backpack")
			local fruit = backpack and backpack:FindFirstChild("Goro-Goro")
			if not fruit then
				print("[GORO] no Goro-Goro in the backpack - walking instead")
				return false
			end
			pcall(function() Character.Humanoid:EquipTool(fruit) end)
			local t0 = tick()
			while tick() - t0 < 1 and not Character:FindFirstChild("Goro-Goro") do
				task.wait(0.05)
			end
			if not Character:FindFirstChild("Goro-Goro") then
				print("[GORO] the fruit would not equip - walking instead")
				return false
			end
		end
		-- the hop owns the hand from here (ZQ5.goroHopUntil): equipattacktool stands down so the
		-- blade can't re-equip over the fruit mid-cast
		ZQ5.goroHopUntil = tick() + 8
		-- a block refuses every cast: F key-up goes straight through the vim, and we WAIT for the
		-- Blocking value to actually drop (the maze-start "skill hold block" refusal, 2026-10-30)
		if Character:FindFirstChild("Blocking") then
			pcall(function()
				ImpelVim():SendKeyEvent(false, Enum.KeyCode.F, false, game)
			end)
			ZQ5.blockHoldUntil = 0
			local t0 = tick()
			while tick() - t0 < 1 and Character:FindFirstChild("Blocking") do
				-- (the Floor 1 walking block is a REMOTE block, not the F key: drop that too, user 2026-10-31)
				pcall(SetBlocking, false)
				task.wait(0.05)
			end
			if Character:FindFirstChild("Blocking") then
				print("[GORO] still Blocking after the key release - walking instead")
				ZQ5.goroHopUntil = 0
				return false
			end
		end
		local ok, ender = pcall(function()
			return GoroRS.Events.Skill:InvokeServer("Lightning Form")
		end)
		if not ok or typeof(ender) ~= "Instance" then
			-- refused: a latched faceMouse freezes stamina regen and makes every retry
			-- refuse too (Wyvern live 2026-10-25/26) -- clear it, back off 5s
			-- (faceMouse is a TOGGLE -- measured 2026-10-31: one send flips the server's facingMouse whatever the argument.
			-- Only send when it's ON, so this can only ever turn it off.)
			pcall(function()
				if Character and Character:GetAttribute("facingMouse") == true then
					GoroRS.Events.faceMouse:FireServer(false)
				end
			end)
			local curTool = Character:FindFirstChildOfClass("Tool")
			print(string.format("[GORO] cast refused - held: %s%s, stamina %d",
				tostring(curTool and curTool.Name or "nothing"),
				Character:FindFirstChild("Blocking") and ", still Blocking" or "",
				goroStamina()))
			goroReadyAt = tick() + 5
			ZQ5.goroHopUntil = 0
			return false
		end
		goroEnder = ender
		-- (the 2s lift-off wait after the cast is removed, user 2026-11-01: the leg flies at once)
		return true
	end

	-- the flight leg: a BodyVelocity steers the character through normal physics while the
	-- form is on (Wyvern's verified technique) -- the noclip loop already runs while
	-- ZQ5.moving, so the body never catches on a wall. No CFrame writes, no new collision code.
	local function goroLeg(target)
		local char = Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = PlayerHumpart
		local torso = char and (char:FindFirstChild("LowerTorso") or root)
		if not (hum and root and root.Parent and torso) then return false end

		local prevMoving = ZQ5.moving
		ZQ5.moving = true
		ZQ5.goroHopFlying = true -- the noclip loop's maze override exempts a Lightning Form flight
		local bv = Instance.new("BodyVelocity")
		bv.Name = "GoroHopVel"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.P = 1e5
		bv.Velocity = Vector3.zero
		bv.Parent = torso

		local arrived = false
		pcall(function()
			local prevPos = root.Position
			local t0 = tick()
			-- cruise dist/350, x3 for the ease-off + the windup, +10s slack: never a stuck flight
			local budget = 10 + ((target - prevPos).Magnitude / GORO_SPEED) * 3
			while true do
				if not root.Parent or hum.Health <= 0 then break end
				if not goroActive() then break end -- form dropped (stamina out): stop here, walk on
				if ZQ5.inCutscene and ZQ5.inCutscene() then
					bv.Velocity = Vector3.zero -- (cutscene: stand still, the game holds us)
				else
					local pos = root.Position
					local delta = target - pos
					local d = delta.Magnitude
					if d <= 3 then
						arrived = true
						break
					end
					-- a game teleport (floor change, cutscene) moves us far in one frame: end the hop
					if (pos - prevPos).Magnitude > 40 then break end
					prevPos = pos
					if tick() - t0 > budget then break end
					local dir = delta / d
					-- ease off over the last stretch so arrival doesn't fling us into the next move
					local spd = math.min(GORO_SPEED, math.max(40, d * 3))
					bv.Velocity = dir * spd
				end
				GoroHeart:Wait()
			end
		end)
		pcall(function()
			bv.Velocity = Vector3.zero
			bv:Destroy()
			-- destroying the BodyVelocity leaves the root's momentum behind (up to 350 studs/s):
			-- that flung the character on arrival once nothing else zeroed it the next frame
			if root.Parent then root.AssemblyLinearVelocity = Vector3.zero end
		end)
		ZQ5.moving = prevMoving
		ZQ5.goroHopFlying = nil
		return arrived
	end

	-- the per-hop decision + the hop itself, called from walkTo before pathfinding. Landing
	-- pulls 40 studs back along the approach (horizontal only, so we stay at the target
	-- floor's height): the walker finishes the precise part (chests, buttons, mobs).
	local function goroTravel(dest)
		local cfg = getgenv().ZephyronCombat or {}
		if cfg.GoroTravel == false then return false end
		if not ImpelNightmarePlus() then return false end -- Normal mode: walker, untouched
		-- NO GORO-GORO IN INVENTORY (user 2026-11-11): Nightmare+ with no Goro-Goro in the backpack
		-- or hand walks the WHOLE run exactly like Normal mode -- no cast attempts, no per-leg
		-- raycasts, no hop log. The backpack is the real test because goroCast equips from it.
		-- Checked per call, not cached, so picking the fruit up mid-run re-enables the hops.
		if not (Character and Character:FindFirstChild("Goro-Goro")) then
			local gbp = GoroLP:FindFirstChildOfClass("Backpack")
			if not (gbp and gbp:FindFirstChild("Goro-Goro")) then
				if tick() - (ZQ5.goroNoFruitSaid or 0) > 30 then
					ZQ5.goroNoFruitSaid = tick()
					print("[GORO] no Goro-Goro in inventory - walking this run like Normal mode")
				end
				return false
			end
		end
		-- (leverMode legs hop now too, user 2026-10-30: the Floor 2 lever leg and the leg after
		-- it fly -- ZQ5.goroHopFlying keeps the flight noclipped wherever it runs)
		-- (Floor 1 the maze HOPS now, user 2026-10-30: goroLeg sets ZQ5.goroHopFlying and the
		-- noclip loop's maze override exempts it -- the flight passes walls like the lever's
		-- straight-line fallback. The old force-collide stall is gone.)
		-- (the post-Head-Jailer walk-only window is GONE: the elevator shaft target has no
		-- walkable path -- only the hop reaches it. Walk-only stalled the run after the boss,
		-- user 2026-10-30: "make it use goro again for that leg". The hop down the shaft IS the
		-- way to the Floor 4 elevator.)
		local hum = Character and Character:FindFirstChildOfClass("Humanoid")
		local hrp = PlayerHumpart
		if not (hum and hrp and hrp.Parent) then return false end
		-- cast from a real ground start only: a mid-air cast is unverified (a form KEPT from the last hop needs no cast)
		local formKept = goroActive()
		if hum.FloorMaterial == Enum.Material.Air and not formKept then return false end
		local from = hrp.Position
		local dist = (dest - from).Magnitude
		if dist < GORO_MIN_DIST then return false end
		-- NO HOP OVER GoroMaxHop (2500) (user 2026-10-31: the elevator Goro back to the old floor). Floors are 4800+ studs
		-- apart; the longest real hop on one floor is ~1500 (the maze flight, the first Floor 5 leg). Longer = another
		-- floor's leftover target: walk (the walker can't path off this island, so it just waits for the new floor).
		if dist > (tonumber(cfg.GoroMaxHop) or 2500) then
			if tick() - (ZQ5.goroFarSaid or 0) > 5 then
				ZQ5.goroFarSaid = tick()
				print(string.format("[GORO] target is %.0f studs away - another floor's target, no hop", dist))
			end
			return false
		end
		-- NEVER HOP BACK A FLOOR (user 2026-10-31): Floor 2 and Floor 3 are only ~1600 apart, under the cap above. The
		-- island under the destination is a LOWER floor than the one under us -> the old floor's target: walk.
		do
			local function floorAt(p)
				local okR, num = pcall(function()
					local rp = RaycastParams.new()
					rp.FilterType = Enum.RaycastFilterType.Exclude
					rp.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
					local hit = workspace:Raycast(p + Vector3.new(0, 5, 0), Vector3.new(0, -300, 0), rp)
					local isl = workspace:FindFirstChild("Islands")
					local inst = hit and hit.Instance
					while inst and isl and inst.Parent ~= isl do
						inst = inst.Parent
					end
					return inst and tonumber(string.match(inst.Name, "Floor (%d+)"))
				end)
				return okR and num or nil
			end
			local here, there = floorAt(from), floorAt(dest)
			if here and there and there < here then
				if tick() - (ZQ5.goroBackSaid or 0) > 5 then
					ZQ5.goroBackSaid = tick()
					print(string.format("[GORO] target is on Floor %d, we're on Floor %d - no hop back (old floor's target)", there, here))
				end
				return false
			end
		end
		-- the cooldown race: hop only while the remaining wait still beats walking there
		-- (except ZQ5.goroAlwaysLeg -- the Floor 2 lever leg and the leg after it, user 2026-10-31: those ALWAYS fly,
		-- waiting the cooldown out if they must)
		local readyIn = formKept and 0 or math.max(0, goroReadyAt - tick())
		if readyIn > 0 and not ZQ5.goroAlwaysLeg then
			local hopTime = readyIn + 2 + dist / GORO_SPEED
			local walkTime = dist / math.max(walkSpeed(), 1)
			if hopTime >= walkTime then return false end
		end
		-- (user 2026-11-01) a new cast needs GoroMinStamina (70)+: a flight started low ran dry mid-way. A kept form needs none
		if not formKept and goroStamina() < (tonumber(cfg.GoroMinStamina) or 70) then
			if tick() - (ZQ5.goroLowSaid or 0) > 5 then
				ZQ5.goroLowSaid = tick()
				print(string.format("[GORO] stamina %d (under %d) - walking instead", goroStamina(), tonumber(cfg.GoroMinStamina) or 70))
			end
			return false
		end

		local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
		local flatDist = flat.Magnitude
		local land = dest
		-- stop ~5 studs out (user, 2026-10-30: precision -- the walker finishes the last bit)
		local landShort = tonumber(cfg.GoroTravelLandShort) or 5
		if flatDist > landShort * 4 then
			land = dest - (flat / flatDist) * landShort
		end

		local savedTool = Character:FindFirstChildOfClass("Tool")
		-- blocking refuses every cast (user, 2026-10-30): drop any hold a dodge rule left over
		-- before the cast -- travel doesn't block on nightmare+ anyway, this catches a fight
		-- rule overlapping the hop
		ZQ5.blockHoldUntil = 0
		if ZQ5.dodgeBlock and ZQ5.dodgeBlockHeld and not ZQ5.vdodge then
			ZQ5.dodgeBlock(false)
		end
		-- HOP LOG (user 2026-10-31: "on Floor 3 it Goro'd to the Floor 2 elevator -- find exactly why"). Read-only: every
		-- hop decided -> one line in workspace\goro_hops_<name>.txt: from, to, distance, the islands loaded, the leg
		-- (LastPlaceTween) and the target / floor-target globals. A hop to another floor's spot names its leg here.
		pcall(function()
			local isl = {}
			for _, c in ipairs(workspace.Islands:GetChildren()) do
				isl[#isl + 1] = c.Name
			end
			local line = string.format("%s hop %.0f studs | from %s -> %s | leg %s | targetPosition %s targetFloorPosition %s | islands [%s]",
				os.date("%Y-%m-%d %H:%M:%S"), dist, tostring(from), tostring(dest), tostring(LastPlaceTween),
				tostring(targetPosition), tostring(targetFloorPosition), table.concat(isl, ", "))
			local fname = "goro_hops_" .. LocalPlayer.Name .. ".txt"
			local old = ""
			pcall(function()
				if isfile(fname) then
					old = readfile(fname)
				end
			end)
			if #old > 60000 then
				old = string.sub(old, -30000)
			end
			writefile(fname, old .. line .. string.char(10))
		end)
		ZQ5.goroKeptAt = nil -- (a kept form is used now: its 8s watchdog stands down)
		local castOk = goroCast()
		if not castOk then
			-- one retry (wyverncinder's rule): the first cast can race the fruit's equip or a
			-- lingering block -- a short backoff, not the full 5s
			print("[GORO] first cast refused - retrying once")
			goroReadyAt = tick() + 1.5
			castOk = goroCast()
		end
		if not castOk then
			goroRestoreTool(savedTool)
			return false
		end
		print(string.format("[GORO] Lightning Form hop: %.0f studs%s", dist, readyIn > 0 and string.format(" (waited %.1fs of cooldown)", readyIn) or ""))
		local arrived = false
		pcall(function()
			arrived = goroLeg(land)
		end)
		-- KEEP THE FORM (user 2026-11-01: the Floor 2 lever -- was hop, end the form, pull, wait the cooldown, cast
		-- again for the next leg). With ZQ5.goroKeepForm set (the lever leg) the form stays on after landing while
		-- stamina is GoroKeepMinStamina (40)+: the fruit stays in hand, the lever is pulled, and the next hop flies at
		-- once with no cast and no cooldown. Not used within 8s -> ended then.
		local keepMin = tonumber(cfg.GoroKeepMinStamina) or 40
		if ZQ5.goroKeepForm and arrived and goroActive() and goroStamina() >= keepMin then
			ZQ5.goroHopUntil = tick() + 8 -- (the fruit stays in hand: equipattacktool stands down)
			local keptAt = tick()
			ZQ5.goroKeptAt = keptAt
			print(string.format("[GORO] landed - keeping Lightning Form on for the next leg (stamina %d)", goroStamina()))
			task.delay(8, function()
				pcall(function()
					if ZQ5.goroKeptAt == keptAt and goroEnder and not ZQ5.goroHopFlying then
						ZQ5.goroKeptAt = nil
						goroRelease()
						goroRestoreTool(savedTool)
						ZQ5.goroHopUntil = 0
						print("[GORO] kept Lightning Form not used in 8s - ended it")
					end
				end)
			end)
			return true
		end
		if ZQ5.goroKeepForm and arrived then
			print(string.format("[GORO] stamina %d (under %d) - ending Lightning Form instead of keeping it", goroStamina(), keepMin))
		end
		goroRelease()
		goroRestoreTool(savedTool)
		ZQ5.goroHopUntil = 0
		if arrived then
			print("[GORO] landed - walking the last stretch")
		else
			print("[GORO] hop ended early - walking from here")
		end
		return true
	end
	ZQ5.goroTravel = goroTravel
	end

	-- Walk dest along a path. Every segment keeps the wall check: hitting a wall ("stuck") or
	-- the game's noclip flag ("noclip") means we left the path (knockback, a recovery lift...),
	-- so back up to the last waypoint we reached cleanly and compute a fresh path from there.
	-- No more rising out of trouble: rising inside a tall maze wall climbed 150 studs and kicked.
	local lastWalkLog = 0
	function ZQ5.walkTo(dest, poll)
		if not PlayerHumpart or not PlayerHumpart.Parent then
			return false, "nohrp"
		end
		ZQ5.walkDest = dest -- (Floor 5 bridge leg check)
		-- the tween poll sets st.speed to the tween speed (80+). Per-waypoint moves stopped and
		-- restarted so often that it never really got there; the one continuous route did, and
		-- ran way too fast. Walking keeps walkSpeed().
		if poll then
			local tweenPoll = poll
			poll = function(st)
				local r = tweenPoll(st)
				st.speed = walkSpeed()
				return r
			end
		end

		-- walking ends ON the ground: a ground-level target (chest, key) would put the root in
		-- the floor, and an air target (a point over a mob) would leave us floating -> flight
		-- strikes. Getting above a mob is the hover's job.
		-- (objective markers float ~70 above the floor -- Floor 3 after a lever: "no path to
		-- 4773.8, 2378.3, ..." forever with the ground 72 below -- so look further down when
		-- there's nothing within 60)
		local gy = groundYAt(dest, 60) or groundYAt(dest, 200)
		if gy then
			dest = Vector3.new(dest.X, gy + standHeight(), dest.Z)
		end

		-- a mob in reach BEFORE pathfinding: fight it now (see ZQ5.fightMobInReach -- the Floor 5
		-- arrival stood and died while computePath struggled, 2026-10-30)
		if ZQ5.fightMobInReach then
			pcall(function()
				ZQ5.fightMobInReach()
			end)
		end

		-- maze: no real progress for MAZE_STUCK_SECONDS -> straight line from here
		-- (only counts back-to-back walk attempts: a pause to fight or wait resets it)
		local here = PlayerHumpart.Position
		if not stuckPos or (here - stuckPos).Magnitude > 5 or tick() - (ZQ5.lastWalkCall or 0) > 3 then
			stuckPos, stuckSince = here, tick()
		end
		ZQ5.lastWalkCall = tick()
		if inMaze() and tick() - stuckSince > MAZE_STUCK_SECONDS then
			return straightThrough(dest, poll, "no progress")
		end

		-- still up in the air (a hover just ended and its pad is gone): come straight down to
		-- standing height first, pathfinding from mid-air fails and the body just dropped
		do
			-- only when we're really in the air: the humanoid stands on nothing and the drop is a
			-- hover's worth. On the Floor 2 spawn the ray went through the (non-collide) spawn
			-- platform, found ground ~80 studs lower and walked us straight down through the floor.
			local p0 = PlayerHumpart.Position
			local hum0 = Character and Character:FindFirstChildOfClass("Humanoid")
			local standing = hum0 and hum0.FloorMaterial ~= Enum.Material.Air
			local g0 = (not standing) and groundYAt(p0, 30) or nil
			if g0 and p0.Y - (g0 + standHeight()) > 3 then
				ZQ5.move(Vector3.new(p0.X, g0 + standHeight(), p0.Z), walkSpeed(), { poll = poll })
			end
		end

		-- GORO TRAVEL (nightmare+): the long legs fly (ZQ5.goroTravel, the do-block above).
		-- AFTER the descent: a fight ends hovering/falling, and a hop from mid-air is unverified
		-- -- at the old spot (before this descent) every post-fight walk silently skipped the
		-- hop because FloorMaterial was still Air (2026-10-30, "never casts" on Floors 2+)
		pcall(function()
			ZQ5.goroTravel(dest)
		end)

		ZQ5.lastWalkResult = nil
		local attempt, knocks = 0, 0
		local nudgeDone = false
		while attempt < 4 and knocks < 15 do
			attempt = attempt + 1
			local from = PlayerHumpart.Position
			ZQ5.pathAbort, ZQ5.pathAbortOk = nil, true
			local okP, wps, minY, maxY, nearOnly = pcall(computePath, from, dest)
			ZQ5.pathAbortOk = false
			if not okP then
				wps = nil
			end
			if ZQ5.pathAbort then
				-- a mob came into reach while pathfinding (PATH ABORT): fight it, then the caller walks on
				local m = ZQ5.pathAbort
				ZQ5.pathAbort = nil
				print("[WALK] " .. tostring(m.GetAttribute and m:GetAttribute("RealName") or m.Name) .. " in reach while pathfinding - fighting it first")
				pcall(function()
					ZQ5.fightMobInReach()
				end)
				ZQ5.mobInterrupted = true -- (tweenWithTeleport walks on after the fight)
				return false, "mob"
			end
			if not wps then
				if inMaze() then
					return straightThrough(dest, poll, "no path")
				end
				-- NO-PATH NUDGE (user, 2026-10-30: Floor 5 stalled after clearing the first group
				-- until they moved the character "a bit" -- pathfinding can fail from the exact
				-- spot the body sits in after a fight and then fail forever from the same spot):
				-- once per walk, step 4 studs sideways and retry from there before skipping.
				if not nudgeDone and PlayerHumpart and PlayerHumpart.Parent then
					nudgeDone = true
					local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
					local side = flat.Magnitude > 1 and Vector3.new(-flat.Z, 0, flat.X).Unit or Vector3.new(0, 0, 1)
					print("[WALK] no path -- nudging 4 studs sideways and re-pathing once")
					ZQ5.move(from + side * 4, walkSpeed(), {})
					attempt = attempt - 1 -- the retry from the new spot doesn't count as an attempt
					continue
				end
				-- outside the maze: no straight-line fallback (it set off tp/noclip checks)
				print("[WALK] no path to " .. tostring(dest) .. ", skipping this move")
				ZQ5.lastWalkResult = "nopath"
				task.wait(1)
				return false, "nopath"
			end
			if tick() - lastWalkLog > 3 then
				lastWalkLog = tick()
				print(string.format("[WALK] %d waypoints to %s, ground Y %.0f..%.0f", #wps, tostring(dest), minY, maxY))
			end

			-- build the whole route first (a point over steps/ledges so the line never cuts a
			-- floor edge), then walk it in one continuous move: no stop-and-stand per waypoint
			-- WALL CLEARANCE: every route point is pushed away from walls closer than WALL_CLEAR
			-- (3 studs) at body and head height, checked in 8 directions. The pathfinder's narrow
			-- fallback agent (2.5) and the straight lines between its waypoints hugged the Floor 1
			-- maze's south wall (848 x 130 x 24, X 2704-3552) where the route squeezes round its end
			-- and steps over the 6-stud border rail: head in the wall -> [AC] noclip -> kicked.
			local WALL_CLEAR = (getgenv().ZephyronCombat or {}).WallClearance or 3
			local clearParams = RaycastParams.new()
			clearParams.FilterType = Enum.RaycastFilterType.Exclude
			clearParams.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
			pcall(function()
				clearParams.RespectCanCollide = true
			end)
			local DIRS = {}
			for k = 0, 7 do
				local a = k * math.pi / 4
				DIRS[#DIRS + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
			end
			local function clearOfWalls(p)
				for _ = 1, 2 do
					local push = Vector3.zero
					for _, hOff in ipairs({ 0, 1.5 }) do -- body, head
						local o = p + Vector3.new(0, hOff, 0)
						for _, d in ipairs(DIRS) do
							local hit = workspace:Raycast(o, d * WALL_CLEAR, clearParams)
							if hit and math.abs(hit.Normal.Y) < 0.5 then -- a wall, not floor / a step top
								push -= d * (WALL_CLEAR - hit.Distance)
							end
						end
					end
					if push.Magnitude < 0.05 then
						break
					end
					if push.Magnitude > WALL_CLEAR then
						push = push.Unit * WALL_CLEAR
					end
					p += push
				end
				return p
			end

			-- LOW OBSTACLES (fences, rails) the jump path crosses: the straight line between two
			-- waypoints runs into them at knee height. Climb to just over the top before it and come
			-- down past its far side instead of ramming it. Only up to 7 studs tall (a wall is not
			-- hopped; that's a re-path).
			local function hopPoints(a, b)
				local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
				if flat.Magnitude < 0.5 then
					return nil
				end
				local dir = flat.Unit
				local sh = standHeight()
				local knee = Vector3.new(a.X, a.Y - sh + 1.2, a.Z)
				local hit = workspace:Raycast(knee, dir * flat.Magnitude, clearParams)
				if not (hit and math.abs(hit.Normal.Y) < 0.5) then
					return nil
				end
				local groundY = a.Y - sh
				local topY = nil
				local farX = nil
				for s = 0.5, 8, 0.5 do
					local p = hit.Position + dir * s
					local down = workspace:Raycast(Vector3.new(p.X, groundY + 12, p.Z), Vector3.new(0, -14, 0), clearParams)
					local y = down and down.Position.Y or groundY
					if y > groundY + 1 then
						topY = math.max(topY or y, y)
					elseif topY then
						farX = p
						break
					end
				end
				if not (topY and farX) or topY - groundY > 7 then
					return nil
				end
				local overY = topY + sh + 0.5
				local before = hit.Position - dir * 1.5
				local after = farX + dir * 1.5
				return { Vector3.new(before.X, overY, before.Z), Vector3.new(after.X, overY, after.Z) }
			end

			local route = {}
			local prev = from
			for i = 2, #wps do
				local wp = (i == #wps and not nearOnly) and dest or standPointAt(wps[i].Position)
				if i < #wps then
					wp = clearOfWalls(wp)
				end
				local okH, hop = pcall(hopPoints, prev, wp)
				if okH and hop then
					table.insert(route, hop[1])
					table.insert(route, hop[2])
					prev = hop[2]
				end
				-- GROUND UNDER THE LINE (2026-11-03): only the midpoint was checked, so the line from the last
				-- stair step up onto a platform still ran a few studs under the platform's edge -- the quick dip
				-- at the top of the Floor 4 exit stairs, a noclip flag on every run (user saw it dip and come
				-- back up). Now every 2 studs: where the ground stands above the line, that spot joins the
				-- route. Never above the segment's higher end (no new climb, no ceiling tops).
				do
					local sh = standHeight()
					local topY = math.max(prev.Y, wp.Y)
					local depth = topY - math.min(prev.Y, wp.Y) + sh + 3
					local flatLen = Vector3.new(wp.X - prev.X, 0, wp.Z - prev.Z).Magnitude
					local n = math.clamp(math.floor(flatLen / 2), 2, 60)
					local from2, lastP = prev, nil
					for k = 1, n - 1 do
						local t = k / n
						local p2 = prev:Lerp(wp, t)
						-- the line from the last added point to wp, at this spot
						local base = from2
						local seg = Vector3.new(wp.X - base.X, 0, wp.Z - base.Z).Magnitude
						local along = Vector3.new(p2.X - base.X, 0, p2.Z - base.Z).Magnitude
						local lineY = seg > 0.01 and (base.Y + (wp.Y - base.Y) * (along / seg)) or wp.Y
						local gy = groundYAt(Vector3.new(p2.X, topY, p2.Z), depth)
						if gy then
							local standY = gy + sh
							if standY > lineY + 0.3 and standY <= topY + 0.5 then
								-- up BEFORE the edge: the previous sample spot (still over the lower step) lifted to
								-- this height first, then across -- the line never nicks the corner
								if lastP and standY - lineY > 1 then
									table.insert(route, Vector3.new(lastP.X, standY, lastP.Z))
								end
								local pt = Vector3.new(p2.X, standY, p2.Z)
								table.insert(route, pt)
								from2 = pt
							end
						end
						lastP = p2
					end
				end
				table.insert(route, wp)
				prev = wp
			end

			local lastGood = from
			local failed = nil
			ZQ5.walking = true
			if #route > 0 then
				local _, reason = ZQ5.move(route[#route], walkSpeed(), {
					poll = poll,
					route = route,
					onReach = function(_, p)
						lastGood = p
						ZQ5.lastWalkCall = tick()
					end,
				})
				ZQ5.lastWalkCall = tick()
				if reason == "stuck" or reason == "noclip" or reason == "knocked" then
					failed = reason
				elseif reason then
					ZQ5.walking = false
					return false, reason
				end
			end
			ZQ5.walking = false
			if not failed then
				return true, nil
			end
			if failed == "knocked" then
				-- hit off the path: just path again from here, no back-up (that walked us back
				-- into the mob that hit us)
				attempt = attempt - 1 -- a hit is not a failed path: doesn't use up a try
				knocks = knocks + 1
				print(string.format("[WALK] knocked off the path at %s, re-pathing (try %d)", tostring(PlayerHumpart.Position), attempt))
			else
				print(string.format("[WALK] %s at %s, backing up to %s and re-pathing (try %d)", failed, tostring(PlayerHumpart.Position), tostring(lastGood), attempt))
				ZQ5.move(lastGood, walkSpeed(), {})
				task.wait(0.3)
			end
		end
		if inMaze() then
			return straightThrough(dest, poll, "re-paths kept failing")
		end
		return false, "walkfail"
	end

	-- is our head really inside world geometry (walls, floors)? Characters, NPCs and effects
	-- don't count: a mob's body overlapping us is not something a re-path can fix
	function headInWorld()
		local head = Character and Character:FindFirstChild("Head")
		if not head then
			return false
		end
		local op = OverlapParams.new()
		op.FilterType = Enum.RaycastFilterType.Exclude
		op.FilterDescendantsInstances = {
			Character,
			workspace:FindFirstChild("NPCs"),
			workspace:FindFirstChild("Effects"),
			workspace:FindFirstChild("PlayerCharacters"),
			ZQ5 and ZQ5.hoverPad or nil,
		}
		pcall(function()
			op.RespectCanCollide = true
		end)
		local ok, parts = pcall(function()
			return workspace:GetPartBoundsInBox(head.CFrame, head.Size * 0.9, op)
		end)
		return ok and parts and #parts > 0
	end

	function tweenWithTeleport(pos, speed, offsetY, tweenconfigs)
		if not tweenconfigs then
			tweenconfigs = {}
		end

		if not PlayerHumpart or not Character or not CanFarm or RaiuiAnims then
			return
		end

		if not canTweenNow() then
			return
		end

		local targetPosition = typeof(pos) == "CFrame" and pos.Position or pos

		-- GORO TRAVEL on tween legs (user, 2026-10-30: the Floor 2 lever leg and the leg after
		-- it fly too): long tween trips hop first, then the tween closes the last studs -- the
		-- lever pull needs us within 4, so the tween still runs after a hop. Short legs and
		-- every goroTravel refusal just tween as before.
		pcall(function()
			if ZQ5.goroTravel and not tweenconfigs.inspawn then
				ZQ5.goroTravel(targetPosition)
			end
		end)

		local isOnFifthFloor = workspace.Islands:FindFirstChild("Impel Base - Floor 5")
		if isOnFifthFloor then
			for partName, partData in pairs(FourthFloor) do
				if (targetPosition - partData.Position).Magnitude < 50 then
					return
				end
			end
		end

		local isOnFourthFloor = workspace.Islands:FindFirstChild("Impel Base - Floor 4")
		if isOnFourthFloor then
			for partName, partData in pairs(ThirdFloor) do
				if (targetPosition - partData.Position).Magnitude < 50 then
					return
				end
			end
		end

		local isOnThirdFloor = workspace.Islands:FindFirstChild("Impel Base - Floor 3")
		if isOnThirdFloor then
			for partName, partData in pairs(SecondFloorPositions) do
				if (targetPosition - partData.Position).Magnitude < 50 then
					return
				end
			end
		end

		local function executeTween(tweenState)
			local isCurrentlyBlocking = Character:FindFirstChild("Blocking")

			if tweenState and not tweenState.active then
				return
			end

			pcall(function()
				if tweenState and not tweenState.active then
					return
				end

				if typeof(pos) == "Vector3" then
					pos = CFrame.new(pos)
				elseif typeof(pos) ~= "CFrame" then
					return
				end

				Others.LastDashTime = 0
				Others.StopShadowBan = false
				ValuesTable.shadowbanbypass = false
				local targetCFrame = pos
				local startPos = PlayerHumpart.Position

				if (startPos - targetCFrame.Position).Magnitude < 5 then
					ValuesTable.shadowbanbypass = false
					return
				end

				local destPos = typeof(pos) == "CFrame" and pos.Position or pos
				-- trips walk straight through the FallingTrap now (it's on the way to the Floor 3 gate,
				-- up the stairs past it). Diverting / refusing them is what parked us right under it.
				local destInTrap = false -- was isUnderTrap(destPos, 35)

				if destInTrap then
					local safeDest = findSafePositionFromTrap(destPos, 40)
					if safeDest then
						destPos = safeDest
						finalCFrame = CFrame.new(safeDest)
						downPos = downPos and CFrame.new(safeDest) or nil
					else
						ValuesTable.shadowbanbypass = false
						return
					end
				end

				local pathHasTrap = false -- was pathCrossesTrap(startPos, destPos, 35)

				if pathHasTrap then
					local safeDest = findSafePositionFromTrap(destPos, 40)
					if not safeDest or isUnderTrap(safeDest, 20) then
						ValuesTable.shadowbanbypass = false
						return
					end
					destPos = safeDest
					finalCFrame = CFrame.new(safeDest)
					if downPos then
						downPos = CFrame.new(safeDest)
					end
				end

				local safeTarget = destPos

				local finalCFrame = CFrame.new(safeTarget)
				local originalTargetCFrame = CFrame.new(targetCFrame.Position)

				local y = offsetY or targetCFrame.Position.Y
				local isBlocking = Character:FindFirstChild("Blocking")

				-- set to false to bring back the old "fly up to offsetY, cross, come down" phases
				local DISABLE_UP_PHASE = true
				local actuallyNeedsOffset = offsetY ~= nil and not DISABLE_UP_PHASE

				if
					actuallyNeedsOffset
					and math.abs(startPos.Y - safeTarget.Y) < 40
					and math.abs(startPos.Y - y) < 40
				then
					actuallyNeedsOffset = false
				end

				local skipOffset = false
				if actuallyNeedsOffset then
					local yDiff = math.abs(startPos.Y - safeTarget.Y)
					local directDistance = (startPos - safeTarget).Magnitude
					-- Only skip offset if Y difference is small AND direct path is clear
					if directDistance < 100 and yDiff < 40 then
						local pathClear, _ = isPathClear(startPos, safeTarget)
						local insidePart = isPositionInsidePart(safeTarget)
						if pathClear and not insidePart then
							skipOffset = true
						end
					end
				end

				local upPos = (actuallyNeedsOffset and not skipOffset) and CFrame.new(startPos.X, y, startPos.Z)
				local midPos = (actuallyNeedsOffset and not skipOffset) and CFrame.new(safeTarget.X, y, safeTarget.Z)
					or finalCFrame
				local downPos = (not skipOffset) and originalTargetCFrame

				local function effSpeed()
					local spb = Character:GetAttribute("SpeedBypass") or 0
					local baseSpeed = speed or 80
					local finalSpeed = math.max(spb, baseSpeed) - 10
					if spb > 150 then
						return (spb * 0.8) + 50
					else
						return speed or 80
					end
				end

				local RunService = Services.RunService
				Others.TweenCd = true

				local function runPhase(toPos)
					if tweenState and not tweenState.active then
						return false
					end

					local targetCF = toPos
					local dist = (PlayerHumpart.Position - targetCF.Position).Magnitude
					if dist <= 1.5 then
						return true
					end

					-- floor guards (unchanged from the old tween)
					if workspace.Islands:FindFirstChild("Impel Base - Floor 5") then
						for _, partData in pairs(FourthFloor) do
							if (targetCF.Position - partData.Position).Magnitude < 50 then
								return false
							end
						end
					end
					if workspace.Islands:FindFirstChild("Impel Base - Floor 4") then
						for _, partData in pairs(ThirdFloor) do
							if (targetCF.Position - partData.Position).Magnitude < 50 then
								return false
							end
						end
					end
					if workspace.Islands:FindFirstChild("Impel Base - Floor 3") then
						for _, partData in pairs(SecondFloorPositions) do
							if (targetCF.Position - partData.Position).Magnitude < 50 then
								return false
							end
						end
					end

					if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
						return
					end

					local hops = 0
					local pollFn = function(st)
							if tweenState and not tweenState.active then
								return "inactive"
							end
							if not PlayerHumpart or not Character then
								return "nochar"
							end

							local isF3 = workspace.Islands:FindFirstChild("Impel Base - Floor 3")
							local isF4 = workspace.Islands:FindFirstChild("Impel Base - Floor 4")
							local isF2 = workspace.Islands:FindFirstChild("Impel Base - Floor 2")
							if
								(isF3 and not isF4 and targetCF.Position.Y < 2200)
								or (isF2 and not isF3 and targetCF.Position.Y < 2200)
							then
								return "floor"
							end

							if
								not workspace:GetAttribute("HandCuffed")
								and (pos.Position - Vector3.new(5866, 30, -10227)).Magnitude > 200
							then
								return "cuffzone"
							end

							-- anticheat notifications: pause, recover, carry on from where we are
							local acType = checkAnticheatNotifications()
							-- while walking a path, a noclip flag means we left it: let walkTo back up
							-- and re-path (the notice lingers ~2s, so ignore repeats for 3s)
							if acType == "noclip" and ZQ5.straight then
								acType = nil -- going through walls on purpose: keep going
							elseif acType == "noclip" and ZQ5.inMazeFloor and ZQ5.inMazeFloor() then
								-- FLOOR 1 MAZE: the server has maze walls our client doesn't (the flag
								-- fired standing on open floor, nothing on our side at the head). So the
								-- flag is believed: invisible solid blockers go where we were, the move
								-- ends, and walkTo backs up and paths again -- around the blockers.
								if tick() >= (ZQ5.acIgnoreUntil or 0) then
									ZQ5.acIgnoreUntil = tick() + 3
									pcall(ZQ5.addMazeBlocker)
									return "noclip"
								end
								acType = nil
							elseif acType == "noclip" then
								if tick() < (ZQ5.acIgnoreUntil or 0) then
									acType = nil
								elseif not headInWorld() then
									-- the head is clear of walls / floors: the flag came from a mob
									-- overlapping us (chasers in the maze) or is a lingering notice.
									-- Stopping to back up and re-path just let the chaser catch up
									-- again, over and over. Keep walking.
									ZQ5.acIgnoreUntil = tick() + 3
									acType = nil
								else
									ZQ5.acIgnoreUntil = tick() + 3
									return "noclip"
								end
							end
							if acType then
								st.paused = true
								local cur = PlayerHumpart.Position
								local safeY = y or selected_Offset or cur.Y
								local safePos = Vector3.new(cur.X, safeY, cur.Z)
								task.wait(0.5)
								-- NO RISING on any anticheat flag: every lift (instant TP, then pad rise)
								-- climbed us up walls and earned Greater Flight Strikes (>15 over the floor).
								-- noclip is handled above (end the move, walkTo backs up and re-paths);
								-- tp/fly checks just pause.
								if acType == "tpcheck" or acType == "flycheck" then
									ValuesTable.shadowbanbypass = false
									task.wait(3)
									ValuesTable.shadowbanbypass = false
								elseif acType == "velocity" or acType == "grounded" then
									Facemouse()
								elseif acType == "threshold" then
									ValuesTable.shadowbanbypass = false
									MovementSystem:Unlock()
									st.paused = false
									return "threshold"
								end
								task.wait(0.5)
								stopblocking = false
								st.paused = false
							end

							Others.StopShadowBan = false
							ValuesTable.shadowbanbypass = false

							if not CanFarm then
								return "nofarm"
							end
							if not canTweenNow() then
								return "island"
							end
							if Character.Parent ~= workspace.PlayerCharacters then
								return "parent"
							end
							if RaiuiAnims then
								return "raiui"
							end
							-- a mob came into reach on the way: stop, the fight-first wrapper below
							-- fights it and then starts this trip again
							if not ZQ5.fightingFirst and ZQ5.mobToFight and ZQ5.mobToFight() then
								ZQ5.mobInterrupted = true
								return "mob"
							end

							-- Floor 3 follows the game's objective marker. When it moves mid-walk, END this walk
							-- and let the floor loop path to the new spot on the ground. This used to swap the
							-- walk's goal for (marker X, y, marker Z) -- y is the trip's old fly-over height,
							-- selected_Offset 3000 on Floor 3 -- and drop the route: the mover went straight up
							-- toward Y 3000, stalled under the roof (~2424), "stuck", backed down, re-pathed,
							-- over and over (2026-10-14).
							if tweenconfigs.ThirdFloorNotificationPosition then
								local newPos = getNotificationPosition()
								if newPos and typeof(newPos) == "Vector3" then
									local flatNew = Vector3.new(newPos.X, 0, newPos.Z)
									local flatOld = Vector3.new(targetCF.Position.X, 0, targetCF.Position.Z)
									if (flatNew - flatOld).Magnitude > 5 then
										return "retarget"
									end
								end
							end

							-- SpeedBypass can change mid-move: just pick the new speed up
							st.speed = effSpeed()

							-- stuck against a wall: give up this phase. No hop: hopping up (first an
							-- instant CFrame to 2600, then a 40-stud pad rise) is what kept climbing.
							if st.stuckT >= 1 then
								st.stuckT = 0
								return "stuck"
							end
							return nil
						end

					-- walk the ground like a player: pathfinding waypoints at standing height
					local reached, reason = ZQ5.walkTo(targetCF.Position, pollFn)

					if reason == "threshold" or reason == "inactive" then
						return false
					end

					local finalDist = (PlayerHumpart.Position - targetCF.Position).Magnitude
					if finalDist > 25 then
						return false
					end
					return true
				end


				local upYDiff = upPos and math.abs(PlayerHumpart.Position.Y - upPos.Position.Y) or 0
				if upPos and upYDiff > 10 then
					if tweenState and not tweenState.active then
						return
					end

					local acCheck = checkAnticheatNotifications()
					if acCheck == "threshold" then
						Others.TweenCd = false
						ValuesTable.shadowbanbypass = false
						MovementSystem:Unlock()
						return
					end

					if acCheck then
						repeat
							task.wait(0.1)
							acCheck = checkAnticheatNotifications()
						until not acCheck or acCheck == "threshold"
						if acCheck == "threshold" then
							Others.TweenCd = false
							ValuesTable.shadowbanbypass = false
							MovementSystem:Unlock()
							return
						end
					end
					Facemouse()
					task.wait(0.4)
					runPhase(upPos)
					task.wait(0.5)

					local yDiff = math.abs(PlayerHumpart.Position.Y - upPos.Position.Y)
					if yDiff > 50 then
						Facemouse()
						runPhase(upPos)
						task.wait(0.5)
						yDiff = math.abs(PlayerHumpart.Position.Y - upPos.Position.Y)
						if yDiff > 50 then
							Others.TweenCd = false
							ValuesTable.shadowbanbypass = false
							return
						end
					end
				end

				if midPos then
					if tweenState and not tweenState.active then
						return
					end

					local phaseSuccess = runPhase(midPos)

					if not phaseSuccess then
						Others.TweenCd = false
						ValuesTable.shadowbanbypass = false
						return
					end
				end
				local downYDiff = downPos and math.abs(PlayerHumpart.Position.Y - downPos.Position.Y) or 0
				if downPos and downYDiff > 10 then
					if tweenState and not tweenState.active then
						return
					end

					local acCheck = checkAnticheatNotifications()
					if acCheck == "threshold" then
						Others.TweenCd = false
						ValuesTable.shadowbanbypass = false
						MovementSystem:Unlock()
						return
					end

					if acCheck then
						repeat
							task.wait(0.1)
							acCheck = checkAnticheatNotifications()
						until not acCheck or acCheck == "threshold"
						if acCheck == "threshold" then
							Others.TweenCd = false
							ValuesTable.shadowbanbypass = false
							MovementSystem:Unlock()
							return
						end
					end

					-- CHECK: Did mid-phase actually reach the target X/Z?
					local currentPos = PlayerHumpart.Position
					local targetX = downPos.Position.X
					local targetZ = downPos.Position.Z
					local xzDistance = math.sqrt((currentPos.X - targetX) ^ 2 + (currentPos.Z - targetZ) ^ 2)

					if xzDistance > 15 then
						local currentY = currentPos.Y
						local correctXZatOffset = CFrame.new(targetX, currentY, targetZ)

						local xzPhaseSuccess = runPhase(correctXZatOffset)

						if not xzPhaseSuccess then
							Facemouse()
							task.wait(0.3)
							runPhase(correctXZatOffset)
							task.wait(0.5)
						end
					end

					Facemouse()
					task.wait(0.4)
					runPhase(downPos)
					task.wait(0.5)

					local yDiff = math.abs(PlayerHumpart.Position.Y - downPos.Position.Y)
					if yDiff > 50 then
						Facemouse()
						runPhase(downPos)
						task.wait(0.5)
						yDiff = math.abs(PlayerHumpart.Position.Y - downPos.Position.Y)
						if yDiff > 50 then
							Others.TweenCd = false
							ValuesTable.shadowbanbypass = false
							return
						end
					end
					task.wait(0.3)
				end
				Others.TweenCd = false
				ValuesTable.shadowbanbypass = false
			end)
			-- the flag stayed true after a completed tween: the nightmare+ travel gate then read
			-- "traveling" forever and suppressed EVERY block hold (Head Jailer / Blugori spin /
			-- Vera blocks all dead, 2026-10-30). Clear it on every completion.
			tweenState.active = false
		end

		if tweenconfigs.inspawn then
			local targetPos = typeof(pos) == "CFrame" and pos.Position or pos

			if MovementSystem.inSpawnTween and MovementSystem.inSpawnTween.active and MovementSystem.inSpawnTarget then
				local distanceToCurrentTarget = (targetPos - MovementSystem.inSpawnTarget).Magnitude
				if distanceToCurrentTarget < 10 then
					return
				end
			end

			MovementSystem:CancelInSpawn()

			local tweenState = { active = true }
			MovementSystem.inSpawnTween = tweenState
			MovementSystem.inSpawnTarget = targetPos
			MovementSystem.tweenState = tweenState

			task.spawn(function()
				executeTween(tweenState)
				if MovementSystem.inSpawnTarget == targetPos then
					MovementSystem.inSpawnTarget = nil
				end
			end)

			return
		end

		MovementSystem:CancelInSpawn()

		local tweenState = { active = true }
		MovementSystem.tweenState = tweenState
		executeTween(tweenState)
	end

	--==========================================================================
	-- FIGHT FIRST: any hostile mob we can reach (mobInReach: within 45 studs flat / 25 up or
	-- down, nothing in the way) is fought before a trip goes on. Checked before every trip and
	-- while walking (the walk stops with "mob", the fight runs, then the trip starts again).
	-- Not in the maze (Floor 1) or the lobby: only once a Floor 2-5 island exists.
	;(function() -- own function: keeps these locals out of the chunk's 200-local limit
		local rawTween = tweenWithTeleport
		local FIGHT_TIMEOUT = 45 -- one mob can't hold us longer than this
		-- a boss gets longer, and only a short skip after (2026-10-26: Elo was given up on after 45s of
		-- Smash dodges and skipped 30s -- the Mini Bunnies were fought in the meantime)
		local BOSS_FIGHT_TIMEOUT, BOSS_GIVEUP_SKIP = 180, 5
		local function nameOf(npc)
			return tostring(npc:GetAttribute("RealName") or npc.Name)
		end
		-- a live Elo The Bunny anywhere (his Mini Bunnies are never fought first while he's up)
		local function liveElo()
			local folder = workspace:FindFirstChild("NPCs")
			for _, n in ipairs(folder and folder:GetChildren() or {}) do
				if nameOf(n) == "Elo The Bunny" then
					local h = n:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 and n:FindFirstChild("HumanoidRootPart") then
						return n
					end
				end
			end
			return nil
		end
		local LOST_AFTER = 4 -- out of reach this long (ran behind a wall): move on
		local skipMob = setmetatable({}, { __mode = "k" })
		local lastScan, lastHit = 0, nil

		local function fightFirstFloor()
			local islands = workspace:FindFirstChild("Islands")
			if not islands then
				return false
			end
			for n = 2, 5 do
				if islands:FindFirstChild("Impel Base - Floor " .. n) then
					return true
				end
			end
			return false
		end

		-- bosses from further away (BOSS_REACH, set by controlTower's section), mobs at the normal 45
		local function reachable(npc)
			if isBasiliskNpc and isBasiliskNpc(npc) then
				return mobInReach(npc, BOSS_REACH or 45, BASILISK_DY or 25)
			end
			if isBossNpc and isBossNpc(npc) then
				return mobInReach(npc, BOSS_REACH or 45, BOSS_REACH_DY or 25)
			end
			return mobInReach(npc)
		end

		local function mobToFight()
			-- FIGHT FIRST switch (user 2026-10-31): ZephyronCombat.FightFirst = false -> no mob ever interrupts a walk / tween
			-- or pathfinding (the walker poll, fightMobInReach and the path abort all ask here). Read live: set it any time.
			if (getgenv().ZephyronCombat or {}).FightFirst == false then
				return nil
			end
			if ZQ5.fightingFirst or not CanFarm or RaiuiAnims or not PlayerHumpart or not fightFirstFloor() then
				return nil
			end
			local folder = workspace:FindFirstChild("NPCs")
			if not folder then
				return nil
			end
			local best, bestD = nil, math.huge
			local eloUp = liveElo() ~= nil
			for _, npc in ipairs(folder:GetChildren()) do
				local hum = npc:FindFirstChildOfClass("Humanoid")
				local hrp = npc:FindFirstChild("HumanoidRootPart")
				if
					hum
					and hrp
					and hum.Health > 0
					and npc.Name ~= "Scorpion"
					and not (eloUp and nameOf(npc) == "Mini Bunny")
					and not (skipMob[npc] and tick() < skipMob[npc])
					and not npc:GetAttribute("ImpelIgnore") -- (an unreachable Mini Bunny, user 2026-11-01)
					and not (ZQ5.spikeMob and ZQ5.spikeMob(npc)) -- (SPIKE-TRAP MOBS, user 2026-10-31)
				then
					local info = npc:FindFirstChild("Info")
					local hostile = info and info:FindFirstChild("Hostile")
					if not (hostile and hostile.Value == false) and reachable(npc) then
						local d = (hrp.Position - PlayerHumpart.Position).Magnitude
						if isBasiliskNpc and isBasiliskNpc(npc) then
							d = d - 10000 -- the Basilisk goes first
						elseif (npc:GetAttribute("RealName") or npc.Name) == "Elo The Bunny" then
							d = d - 5000 -- then Elo, before its Mini Bunnies
						else
							-- DEVIL FRUIT USERS first (user 2026-10-27): the game marks them with Info.DevilFruit (seen:
							-- "Pika", "Hie" -- 206-HP Impel Guards whose CombatType still says Melee / Sword)
							local df = info and info:FindFirstChild("DevilFruit")
							local ctv = df and tostring(df.Value) or ""
							-- (OFF by default, user 2026-10-29 -- see FruitPriority in GetImpelNpc)
							if (getgenv().ZephyronCombat or {}).FruitPriority ~= false and ctv ~= "" and not (isRealBoss and isRealBoss(npc)) then
								d = d - 3000
								if not ZQ5.fruitSeen then
									ZQ5.fruitSeen = {}
								end
								if not ZQ5.fruitSeen[ctv] then
									ZQ5.fruitSeen[ctv] = true
									print("[TARGET] fruit user " .. tostring(npc:GetAttribute("RealName") or npc.Name) .. " (" .. ctv .. " fruit): going for it first")
								end
							end
							-- (gun / bazooka users: no head start any more, user 2026-11-07 -- was d - 1500)
						end
						if d < bestD then
							best, bestD = npc, d
						end
					end
				end
			end
			return best
		end

		-- throttled for the walk poll (runs every frame)
		ZQ5.mobToFight = function()
			if ZQ5.veraDone and ZQ5.veraDone() then
				return nil -- (VERA KILLED)
			end
			if tick() - lastScan >= 0.25 then
				lastScan = tick()
				lastHit = mobToFight()
			end
			return lastHit
		end

		local function fightFirst(mob)
			ZQ5.fightingFirst = true
			ZQ5.hoverOnly = true
			local prevNpc = Npc
			local t0, lostSince = tick(), nil
			local HOVER_TIMEOUT = 3 -- the hover hasn't engaged it this long: leave it for now
			local isBoss = isBossNpc and isBossNpc(mob) or nameOf(mob) == "Elo The Bunny"
			local timeout = isBoss and BOSS_FIGHT_TIMEOUT or FIGHT_TIMEOUT
			print("[FIGHT FIRST] " .. tostring(mob:GetAttribute("RealName") or mob.Name) .. " in reach, fighting it before moving on")
			pcall(function()
				while CanFarm and PlayerHumpart do -- (no time limit, user 2026-10-28)
					local hum = mob.Parent and mob:FindFirstChildOfClass("Humanoid")
					local hrp = mob:FindFirstChild("HumanoidRootPart")
					if not (hum and hrp and hum.Health > 0) then
						break
					end
					-- on a Mini Bunny while Elo is in reach: drop it, Elo comes first
					if nameOf(mob) == "Mini Bunny" then
						local elo = liveElo()
						if elo and reachable(elo) then
							print("[FIGHT FIRST] Elo The Bunny in reach - leaving the Mini Bunny for him")
							break
						end
					end
					if reachable(mob) or (ZQ5.hoverActive and ZQ5.enemy == mob) then
						lostSince = nil
					else
						-- knocked while out of reach: the mob is still ON us -- handing it to the trip
						-- here let the pack juggle us to death with no hover, no block, no swings (the
						-- Floor 5 first-fight deaths, 2026-10-30): stay on it while it keeps hitting
						local beingHit = PlayerHumpart and PlayerHumpart:FindFirstChild("knockback") ~= nil
						if beingHit then
							lostSince = nil
						else
							lostSince = lostSince or tick()
							if tick() - lostSince > LOST_AFTER then
								break -- (no skip, user 2026-10-28: the main loop goes on with it)
							end
						end
					end
					Npc = mob
					controlTower(CFrame.new(hrp.Position), Speed)
					if tick() - t0 > HOVER_TIMEOUT and tick() - (ZQ5.lease or 0) > HOVER_TIMEOUT then
						print("[FIGHT FIRST] hover never engaged " .. mob.Name .. " - handing it to the main loop (no skip)")
						break
					end
					task.wait()
				end
			end)
			-- (no give-up skip any more, user 2026-10-28: the fight goes on until the mob is dead)
			Npc = prevNpc
			ZQ5.hoverOnly = false
			ZQ5.fightingFirst = false
			lastScan = 0
		end

		-- for ZQ5.walkTo (user, 2026-10-30): fight a mob that's in reach BEFORE pathfinding runs.
		-- The Floor 5 arrival stood ~17s at the spawn (computePath on the unstreamed floor) while
		-- the spawn guards beat us -- walkTo had no fight-first check of its own.
		ZQ5.fightMobInReach = function()
			if not CanFarm or ZQ5.fightingFirst or ZQ5.hoverActive
				or (ZQ5.enemy ~= nil and tick() - (ZQ5.lease or 0) < 2) then
				return false
			end
			local mob = mobToFight()
			if mob then
				fightFirst(mob)
				return true
			end
			return false
		end

		function tweenWithTeleport(pos, speed, offsetY, tweenconfigs)
			-- a fight-first fight never travels (controlTower is hover-only then); anything that
			-- still asks is refused rather than walked
			if ZQ5.fightingFirst then
				return
			end
			for _ = 1, 8 do
				local mob = mobToFight()
				if mob then
					fightFirst(mob)
				end
				ZQ5.mobInterrupted = false
				rawTween(pos, speed, offsetY, tweenconfigs)
				if not ZQ5.mobInterrupted then
					return
				end
			end
		end
	end)()

	--==========================================================================
	-- QUEST5 COMBAT (replaces the old m1Attack / m1AttackSimple bodies)
	--
	-- Kept from Zephyron: equipattacktool (weapon equip), Buso (haki), the trap
	-- safety (isUnderTrap / findSafePositionFromTrap), the ragdoll timer and the
	-- per-boss hover offsets that controlTower passes in.
	--
	-- Taken from quest5:
	--   * the m1 loop on its own clock: every HIT_WAIT it takes EVERY live NPC in
	--     range, nearest first, sends "swingsfx", then ONE "damage" call naming all
	--     of them, combo Punch1-4 (Combo5 mode optional)
	--   * fake m1 on block (swing alone, no damage, retry after FEINT_RETRY)
	--   * m1 back and forth: alternate the damage CFrame side so knockback cancels
	--   * the hover engine: BodyVelocity hover over the target, proportional speed
	--   * GATHER / FIGHT aggro: tour the mobs, count one as pulled when its health
	--     drops (or after TOUR_WAIT hovering). NO fixed MaxAggro: every live NPC
	--     within AggroRadius of the target is pulled.
	--
	-- m1Attack() is now a "lease": controlTower calls it every loop while the
	-- target is close, each call renews the lease; when the calls stop (target
	-- dead / out of range / floor change) the hover and the swings stop by
	-- themselves after LEASE seconds.
	--
	-- Tunables (all optional): getgenv().ZephyronCombat = { HitWait = 0.4,
	-- Mode = "Tensen" | "Combo5", AggroRadius = 150, Tour = true, TourWait = 1.5,
	-- AggroTimeout = 12, FeintOnBlock = true, FeintRetry = 5, Shuffle = true,
	-- HoverSpeed = 45 }
	--==========================================================================
	do
		local RS = game:GetService("ReplicatedStorage")
		local RunSvc = game:GetService("RunService")

		getgenv().ZephyronCombat = getgenv().ZephyronCombat or {}
		local CFG = getgenv().ZephyronCombat
		local HIT_WAIT = CFG.HitWait or 0.4 -- the 1-2-3-4 combo (bosses): 0.4 (user 2026-10-28; 0.37 on trial since 2026-10-26)
		-- fake M1 removed (2026-10-15, by request): always swing for real, block or not.
		-- ZephyronCombat.FeintOnBlock = true brings it back.
		local FEINT_ON_BLOCK = CFG.FeintOnBlock == true
		-- 1s between fake M1s on a blocking mob (was 5, Tensen's default): Impel Guards block for
		-- seconds at a time, and at 5s the swings looked stalled (measured 2026-10-15: 7 hits in
		-- ~5s of being in range, 0.85-2.35s apart). 1 is Tensen's slider minimum.
		local FEINT_RETRY = CFG.FeintRetry or 1
		-- Tensen's hit position (2026-10-15): always 5 studs in front of the target, facing it.
		-- ZephyronCombat.Shuffle = true: the old back-and-forth (alternating sides every hit).
		local SHUFFLE_ON = CFG.Shuffle == true
		local COMBO5 = CFG.Mode == "Combo5"
		-- 1-2-3, never hit 4 (GroundPunch4): it knocks the mob down, and a downed mob can't be hit
		-- until it's up again -- the next swings all missed and it got to fight back (measured
		-- 2026-10-15: hit 4 landed, then 7 misses in a row on Jailer Han). Hits 1-3 keep it in
		-- hitstun. ZephyronCombat.ComboMax = 4 for the old combo.
		local COMBO_MAX = COMBO5 and 5 or (CFG.ComboMax or 4) -- quest5: 1-2-3-4
		local COMBO5_HIT_WAIT = CFG.Combo5HitWait or 0.07
		local COMBO5_FINISHER_WAIT = CFG.Combo5FinisherWait or 1.5
		local AGGRO_RADIUS = CFG.AggroRadius or 150
		-- touring (hover over each nearby mob until it takes a hit, to pull the pack) is OFF by
		-- default: it kept leaving the mob we were killing for the next one, which slowed every
		-- pack down, and the M1 hits every mob in range anyway. ZephyronCombat.Tour = true for it.
		local TOUR_ENABLED = CFG.Tour == true
		local TOUR_WAIT = CFG.TourWait or 1.5
		local AGGRO_TIMEOUT = CFG.AggroTimeout or 12
		local BASE_SPEED = CFG.HoverSpeed or 45
		local ARRIVE_THRESHOLD = 2.5
		local LEASE = 1.5

		ZQ5 = ZQ5 or {}
		ZQ5.enemy = nil
		ZQ5.offset = Vector3.new(0, 8, 0)
		ZQ5.radius = 15
		ZQ5.attack = false
		ZQ5.hover = false
		ZQ5.lease = 0
		ZQ5.m1type = "Melee"
		ZQ5.hoverMob = nil
		ZQ5.fight = false
		ZQ5.lastEquip = 0

		local aggro = {} -- every mob pulled so far, pull order
		local skipUntil = setmetatable({}, { __mode = "k" })
		local knock = { axis = nil, axisFor = nil, sign = 1 }
		local facingDir = nil

		local MELEE_COMBO = {
			{ anim = "Punch1", index = 1 },
			{ anim = "Punch2", index = 2 },
			{ anim = "Punch3", index = 3 },
			{ anim = "GroundPunch4", index = 4 },
			{ anim = "Punch5", index = 5 },
		}

		local function leaseActive()
			-- an up-dodge in progress keeps the fight on for up to 8s even if attacking has paused
			-- (Kelvin's / the Head Jailer's old handling stops the attack calls mid-move: the dodge
			-- was cut off after 1.5s and landed us early)
			return ZQ5.enemy ~= nil
				and (tick() - ZQ5.lease < LEASE or (ZQ5.vdodge ~= nil and tick() - ZQ5.lease < 8)
					-- a block hold too (user 2026-10-27): M1s stand down while blocking, the lease ran out
					-- 1.5s in, the hover let go (fell -> block dropped) and the F key was released
					or (tick() < (ZQ5.blockHoldUntil or 0) and tick() - ZQ5.lease < 8)
					-- Vera's gas: the block is held for the whole cloud (~11s)
					or (tick() < (ZQ5.veraGasUntil or 0) and tick() - ZQ5.lease < 15)
					-- a fruit-user skill dodge (user 2026-10-29): no swings while we're 45-65 out
					or (ZQ5.fruitDodge ~= nil and tick() < (ZQ5.fruitDodge.untilT or 0) and tick() - ZQ5.lease < 12))
				and CanFarm
				and Character ~= nil
				and PlayerHumpart ~= nil
				and PlayerHumpart.Parent ~= nil
		end

		local function isValidMob(npc)
			if not npc or not npc.Parent or not npc:IsA("Model") then
				return false
			end
			local hum = npc:FindFirstChildOfClass("Humanoid")
			return hum ~= nil and hum.Health > 0 and npc:FindFirstChild("HumanoidRootPart") ~= nil
		end

		local function inAggro(npc)
			for _, m in ipairs(aggro) do
				if m == npc then
					return true
				end
			end
			return false
		end

		local function combatRange()
			return math.max(ZQ5.radius or 0, ZQ5.offset.Magnitude + 6, 15)
		end

		-- the point the hover engine sits at for one mob: the per-boss offset in the
		-- mob's own space (controlTower's offsets), with Zephyron's trap safety
		local function hoverPointFor(model)
			local r = model.HumanoidRootPart
			local o = ZQ5.offset
			-- yaw-only: a tilted / ragdolled / animated HRP must not turn the +Y offset sideways
			local look = r.CFrame.LookVector
			local yaw = math.atan2(-look.X, -look.Z)
			local p = (CFrame.new(r.Position) * CFrame.Angles(0, yaw, 0) * CFrame.new(o.X, o.Y, o.Z)).Position
			-- ELO THE BUNNY (user, 2026-10-26): 3 studs out put us inside his big footprint -- he jumped
			-- past the capped climb, came down ON us and rode the up-dodge up; and nearly straight
			-- above, he tipped onto his back to face us. So: o.Y up and EloSideGap (8) out, along
			-- OUR direction from him (not his facing: he turns to face us, and a spot fixed in his
			-- facing would swing behind him every turn -- a chase in circles).
			if (model:GetAttribute("RealName") or model.Name) == "Elo The Bunny" and PlayerHumpart then
				local flat = Vector3.new(PlayerHumpart.Position.X - r.Position.X, 0, PlayerHumpart.Position.Z - r.Position.Z)
				if flat.Magnitude < 0.5 then
					flat = Vector3.new(-look.X, 0, -look.Z) -- right above him: go out behind
				end
				if flat.Magnitude > 1e-3 then
					p = r.Position + flat.Unit * (CFG.EloSideGap or 5) + Vector3.new(0, o.Y, 0)
				end
			end
			if isUnderTrap(p, 10) then
				p = findSafePositionFromTrap(p) or p
			end
			if p.Y > 2435 and currentTargetPosition == Vector3.new(5654.6669921875, 2481.71728515625, -20514.548828125) then
				p = r.Position + Vector3.new(0, 8, 0)
			end
			if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then
				p = r.Position + Vector3.new(0, 8, 0)
			end
			-- (the airborne-Cupid "sit 8 under her" rule is gone, user 2026-10-26: she's hovered 11 above
			-- like everyone, wherever she goes -- the live lock follows her up and down)
			return p
		end

		-- HumanoidRootParts of every live NPC within `distance`, nearest first
		local function targetsInRange(distance)
			local parts = {}
			local folder = workspace:FindFirstChild("NPCs")
			local root = PlayerHumpart
			if not (folder and root) then
				return parts
			end
			for _, npc in ipairs(folder:GetChildren()) do
				if isValidMob(npc) then
					local r = npc.HumanoidRootPart
					if (r.Position - root.Position).Magnitude <= distance then
						table.insert(parts, r)
					end
				end
			end
			if #parts > 1 then
				local origin = root.Position
				table.sort(parts, function(a, b)
					return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
				end)
			end
			return parts
		end

		-- the next mob to pull: nearest to us, inside AggroRadius of the target, not pulled yet
		local function nextCandidate(primary)
			local folder = workspace:FindFirstChild("NPCs")
			if not (folder and PlayerHumpart) then
				return nil
			end
			local origin = isValidMob(primary) and primary.HumanoidRootPart.Position or PlayerHumpart.Position
			local best, bestDist = nil, math.huge
			for _, npc in ipairs(folder:GetChildren()) do
				-- only mobs near and in plain sight: the pad flies a straight line, and touring
				-- to a mob 150 studs away went straight through walls and floors
				if isValidMob(npc) and not inAggro(npc) and not (skipUntil[npc] and tick() < skipUntil[npc]) and mobInReach(npc) then
					local r = npc.HumanoidRootPart
					if (r.Position - origin).Magnitude <= AGGRO_RADIUS then
						local d = (r.Position - PlayerHumpart.Position).Magnitude
						if d < bestDist then
							best, bestDist = npc, d
						end
					end
				end
			end
			return best
		end

		-- blocking detection (quest5 / Tensen)
		local function isNPCBlocking(model)
			if not model or not model.Parent then
				return false
			end
			if model:FindFirstChild("Blocking") or model:FindFirstChild("Block") then
				return true
			end
			local ok, result = pcall(function()
				return model:GetAttribute("Blocking")
			end)
			return ok and result == true
		end

		local BLOCK_ANIM_IDS = {
			["15374683054"] = "Big Mama Block",
			["95593858663705"] = "Mochi Trident Block (Katakuri)",
			["13243427337"] = "Mochi fruit Block",
		}
		local function targetBlocking(model)
			if not (model and model.Parent) then
				return false
			end
			if isNPCBlocking(model) then
				return true, "a Blocking flag"
			end
			local ok, attr = pcall(function()
				return model:GetAttribute("IsBlocking")
			end)
			if ok and attr == true then
				return true, "IsBlocking"
			end
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local blockAnim = nil
				pcall(function()
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						local animation = track.Animation
						local id = animation and string.match(tostring(animation.AnimationId), "%d+")
						if id and BLOCK_ANIM_IDS[id] then
							blockAnim = BLOCK_ANIM_IDS[id]
							return
						end
						if animation and string.find(string.lower(animation.Name or ""), "block", 1, true) then
							blockAnim = animation.Name
							return
						end
					end
				end)
				if blockAnim then
					return true, "the " .. tostring(blockAnim) .. " animation"
				end
			end
			return false
		end

		-- fake m1 on block: swing alone, no damage, retry after FEINT_RETRY
		local feintState = setmetatable({}, { __mode = "k" })
		local function farmFeint(part, index, animation, m1type)
			if not FEINT_ON_BLOCK then
				return false
			end
			local model = part and part.Parent
			if not model then
				return false
			end
			-- bosses too now (Tensen's "Fake M1 On Block"): while the target blocks, swing with
			-- no damage ("swingsfx" only) so it drops the block, then the next pass swings for real.
			-- Bosses block almost constantly, so they're re-feinted every 1.5s (FeintRetryBoss),
			-- normal mobs every FEINT_RETRY (5s). ZephyronCombat.FeintBosses = false: old behaviour
			-- (always swing for real into a boss's block).
			local isBossModel = string.find(model.Name, "Vera", 1, true) or model:GetAttribute("HPScaled")
				or (isBossNpc and isBossNpc(model))
			-- never on the Cupid Queen: always swing for real into her block
			if (isBossModel and CFG.FeintBosses == false)
				or string.find(string.lower(tostring(model:GetAttribute("RealName") or model.Name)), "cupid", 1, true) then
				feintState[model] = nil
				return false
			end
			local blocking, why = targetBlocking(model)
			if not blocking then
				if feintState[model] then
					print(string.format("[FEINT] %s dropped the block after %.1fs, swinging for real",
						tostring(model:GetAttribute("RealName") or model.Name), tick() - feintState[model].since))
				end
				feintState[model] = nil
				return false
			end
			local last = feintState[model]
			local retry = isBossModel and (CFG.FeintRetryBoss or 1) or FEINT_RETRY
			if last and tick() - last.at < retry then
				return true
			end
			pcall(function()
				RS.Events.CombatRegister:InvokeServer({ "swingsfx", m1type, index, "Ground", false, animation, 2, 1.5 })
			end)
			if not last then
				print(string.format("[FEINT] %s is blocking (%s): fake M1, no damage, until it drops the block",
					tostring(model:GetAttribute("RealName") or model.Name), tostring(why)))
			end
			feintState[model] = { at = tick(), since = last and last.since or tick() }
			return true
		end

		local function pickAttackTarget(list)
			-- the nearest mob that ISN'T blocking: swings into a block do nothing (measured
			-- 2026-10-15 on an Impel Guard pack: one blocking guard took 16 swings, no damage, while
			-- the unblocked guards beside it took every hit).
			-- When EVERY mob in range blocks: no swing at all (nil). Swinging into the block kept it
			-- up ~7s; left alone, blocks dropped in ~1s -- and the M1 loop swings the very frame one
			-- drops. ZephyronCombat.HoldOnBlock = false: swing into the block anyway.
			-- STAY ON THE TARGET (user 2026-11-08: "just swing to the blocked without changing"): the mob we're fighting
			-- (ZQ5.enemy, the one the hover sits on) is swung at whether it blocks or not, or else the nearest mob in the
			-- list. It used to switch to the nearest UNBLOCKED mob -- often 15-30 studs off, past the ~11-stud reach, so the
			-- swing missed ("far": 11,210 in the logs) and the blocker next to us was never hit.
			-- ZephyronCombat.SwitchOffBlock = true: the old switching.
			if CFG.SwitchOffBlock ~= true then
				local main = ZQ5.enemy and ZQ5.enemy.Parent and ZQ5.enemy:FindFirstChild("HumanoidRootPart")
				local nearest = nil
				for _, part in ipairs(list) do
					if part and part.Parent then
						if part == main then
							return part
						end
						nearest = nearest or part
					end
				end
				return nearest
			end
			local first = nil
			for _, part in ipairs(list) do
				if part and part.Parent then
					first = first or part
					local okB, blk = pcall(targetBlocking, part.Parent)
					if not (okB and blk) then
						return part
					end
				end
			end
			-- (user 2026-10-28: swing into the block anyway, the default now; HoldOnBlock = true: hold)
			if CFG.HoldOnBlock ~= true then
				return first
			end
			return nil
		end

		-- damage CFrame: 5 studs back from the target along the line from us, looking
		-- at it; while fighting, alternate sides of one fixed flat line (back and forth)
		local function damageCFrame(target, root)
			if not (SHUFFLE_ON and ZQ5.fight) then
				facingDir = nil
				local offset = target.Position - root.Position
				if offset.Magnitude == 0 then
					offset = root.CFrame.LookVector
				end
				return CFrame.new(target.Position - offset.Unit * 5 + Vector3.new(0, 1, 0), target.Position)
			end
			if knock.axisFor ~= target or not knock.axis then
				local flat = Vector3.new(root.Position.X - target.Position.X, 0, root.Position.Z - target.Position.Z)
				if flat.Magnitude < 0.5 then
					local lv = root.CFrame.LookVector
					flat = Vector3.new(-lv.X, 0, -lv.Z)
				end
				knock.axis = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, 1)
				knock.axisFor = target
			end
			local from = target.Position + knock.axis * (knock.sign * 5) + Vector3.new(0, 1, 0)
			facingDir = -knock.axis * knock.sign
			knock.sign = -knock.sign
			return CFrame.new(from, target.Position)
		end

		-- Tensen's jitter: a random 10-35 ms on top of HitWait, re-rolled every second, so the swing
		-- rhythm is never machine-regular (ZephyronCombat.HitJitter = false: off)
		ZQ5.hitJitter = 0
		task.spawn(function()
			while task.wait(1) do
				ZQ5.hitJitter = CFG.HitJitter == true and math.random(10, 35) / 1000 or 0 -- (off by default, user 2026-10-28)
			end
		end)
		-- FRUIT USERS (user 2026-10-28): a burst -- 1-2-3-4-5, 0.15s apart, then 1.5s after hit 5 -- to kill them
		-- before they can cast. Every other mob (normal and boss) gets 1-2-3-4 every HitWait (0.4).
		-- ZephyronCombat.FruitCombo5 = false: off; FruitHitWait / FruitFinisherWait tune it.
		local function isFruitTarget(rootPart)
			-- (user 2026-10-28: fruit users get the same 1-2-3-4 every 0.4 as everyone now -- the burst is OFF by
			-- default; ZephyronCombat.FruitCombo5 = true brings it back)
			if CFG.FruitCombo5 ~= true then
				return false
			end
			-- (user 2026-10-28: the burst is for FRUIT USERS only again -- kill them before they cast; every
			-- other mob gets 1-2-3-4 every HitWait 0.4 like the bosses)
			local npc = rootPart and rootPart.Parent
			return isNormalMob(npc) and hasDevilFruitUser(npc)
		end
		local function waitAfter(stepIndex, fruit)
			if fruit and not COMBO5 then
				return stepIndex >= 5 and (CFG.FruitFinisherWait or 1.5) or (CFG.FruitHitWait or 0.15) -- fruit users: burst 0.15, 1.5 after hit 5 (user 2026-10-28)
			end
			if not COMBO5 then
				return (CFG.HitWait or HIT_WAIT) + (ZQ5.hitJitter or 0) -- read live: tunable without a restart
			end
			return stepIndex >= 5 and COMBO5_FINISHER_WAIT or COMBO5_HIT_WAIT
		end

		-- M1 LOOP (own clock)
		task.spawn(function()
			local combo, lastSwing, lastErr, wait_ = 1, 0, 0, HIT_WAIT
			-- M1 SYNC (ZephyronCombat.M1Sync = false: the old pacing). Three things made the swings
			-- uneven compared to quest5:
			--  1. the gap was measured from when BOTH blocking calls RETURNED: HIT_WAIT + 2 round
			--     trips, so it drifted with ping. Now the clock starts when the swing starts, and the
			--     two calls go out together (the swing sound doesn't need to be waited for).
			--  2. a fake M1 against a block also reset that 0.4s clock, so after the block dropped
			--     the first real hit still waited it out. A fake M1 no longer touches the swing clock:
			--     the first frame the block is gone, the hit goes out.
			--  3. the anticheat notification scan (GetDescendants + string work) ran EVERY frame; it
			--     is read 5x a second now.
			-- quest5 pacing by default (M1Sync off): swing, wait for the server, damage, wait, THEN
			-- HitWait. ZephyronCombat.M1Sync = true: the clock from the swing start instead.
			local M1_SYNC = CFG.M1Sync == true
			local acAt, acRes = 0, nil
			-- HIT TRACKING: every damage call is checked 0.6s later -- did any target lose health?
			-- ZQ5.m1Stats keeps the counts (a miss is filed as "blocked", "far" (> 11 studs) or
			-- "other"), and a summary prints every 30s: [M1] 30s: swings, hit %, misses by kind.
			-- Settings read live on every swing (change them mid-run through getgenv().ZephyronCombat):
			-- HitWait, ComboMax, M1Parallel (true = swing-sound and damage calls sent together;
			-- default false = damage sent after the server answered the swing).
			ZQ5.m1Stats = { swings = 0, hits = 0, blocked = 0, far = 0, other = 0, since = tick(), held = {} }
			local function trackHit(targets, targetPart)
				local st = ZQ5.m1Stats
				st.swings += 1
				local eng, sentAt = ZQ5.m1Engage, tick()
				if eng and not eng.swingAt then
					eng.swingAt = sentAt
				end
				local hums, before = {}, {}
				for _, part in ipairs(targets) do
					local h = part and part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
					if h then
						hums[#hums + 1] = h
						before[h] = h.Health
					end
				end
				local model = targetPart and targetPart.Parent
				local blocked = false
				if model then
					local okB, blk = pcall(targetBlocking, model)
					blocked = okB and blk or false
				end
				local dist = (model and model:FindFirstChild("HumanoidRootPart") and PlayerHumpart)
					and (model.HumanoidRootPart.Position - PlayerHumpart.Position).Magnitude or 0
				task.delay(0.6, function()
					local landed = false
					for _, h in ipairs(hums) do
						if h.Parent and (h.Health < before[h] - 0.5 or h.Health <= 0) then
							landed = true
							break
						end
					end
					if landed then
						st.hits += 1
						if eng and ZQ5.m1Engage == eng and not eng.hitAt then
							eng.hitAt = sentAt -- (the swing that landed, not when we saw it land)
						end
					elseif blocked then
						st.blocked += 1
					elseif dist > 11 then
						st.far += 1
					else
						st.other += 1
					end
				end)
			end
			task.spawn(function()
				while task.wait(30) do
					pcall(function() -- (never an uncaught error: code 691)
					local st = ZQ5.m1Stats
					if st.swings > 0 then
						local held = {}
						for _, r in ipairs({ "no lease/moving", "skill cast", "stun", "block hold", "no tool", "not locked on", "ac notice", "out of range" }) do
							local v = (st.held or {})[r] or 0
							if v >= 0.1 then
								held[#held + 1] = string.format("%s %.1fs", r, v)
							end
						end
						print(string.format("[M1] 30s: %d swings, %d hit (%.0f%%), missed: %d blocked, %d far, %d other | HitWait %.2f ComboMax %d %s | held back: %s",
							st.swings, st.hits, 100 * st.hits / st.swings, st.blocked, st.far, st.other,
							CFG.HitWait or HIT_WAIT, CFG.ComboMax or COMBO_MAX, CFG.M1Parallel and "parallel" or "sequential",
							#held > 0 and table.concat(held, ", ") or "nothing"))
					end
					end)
					ZQ5.m1Stats = { swings = 0, hits = 0, blocked = 0, far = 0, other = 0, since = tick(), held = {} }
				end
			end)
			-- DIAGNOSTICS (user, 2026-10-26: "why does the Elite High Guard hit me first"): how long the
			-- loop is held back per reason (in the 30s line), and per boss target one [M1] line: how
			-- long from targeting it to our first swing, our first hit that landed, and the first
			-- damage we took
			local lastLoop = tick()
			local function heldBy(reason, dt)
				local st = ZQ5.m1Stats
				st.held = st.held or {}
				st.held[reason] = (st.held[reason] or 0) + dt
			end
			local function engageWatch()
				local enemy = ZQ5.enemy
				local eng = ZQ5.m1Engage
				if eng and (eng.mob ~= enemy or tick() - eng.at > 20) then
					if not eng.reported and (eng.swingAt or eng.hurtAt) then
						local function t(x)
							return x and string.format("%.1fs", x - eng.at) or "none"
						end
						print(string.format("[M1] %s: first swing %s, first hit landed %s, first damage taken %s (after targeting it)",
							eng.name, t(eng.swingAt), t(eng.hitAt), t(eng.hurtAt)))
					end
					eng.reported = true
					ZQ5.m1Engage = nil
					eng = nil
				end
				if not eng and isValidMob(enemy) and isBossNpc and isBossNpc(enemy) and enemy ~= (ZQ5.m1EngageLast or nil) then
					local hum = Character and Character:FindFirstChildOfClass("Humanoid")
					ZQ5.m1EngageLast = enemy
					ZQ5.m1Engage = { mob = enemy, at = tick(), hp = hum and hum.Health or 0,
						name = tostring(enemy:GetAttribute("RealName") or enemy.Name) }
				elseif eng and not eng.hurtAt then
					local hum = Character and Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health < eng.hp - 1 then
						eng.hurtAt = tick()
					elseif hum then
						eng.hp = math.max(eng.hp, hum.Health) -- regen doesn't count
					end
				end
			end
			while true do
				task.wait()
				local dt = tick() - lastLoop
				lastLoop = tick()
				pcall(engageWatch)
				local ok, err = pcall(function()
					if not leaseActive() or not ZQ5.attack or ZQ5.moving then
						-- (the combo no longer resets here or out of range, user 2026-10-28: it carries on)
						heldBy("no lease/moving", dt)
						return
					end
					if ZQ5.casting then
						heldBy("skill cast", dt)
						return -- a weapon skill is going off (skill loop below)
					end
					if Character:FindFirstChild("Stun") or RaiuiAnims then
						heldBy("stun", dt)
						return
					end
					if tick() < (ZQ5.blockHoldUntil or 0) then
						heldBy("block hold", dt)
						return -- holding block (Love Pistol): no M1s
					end
					if not Character:FindFirstChildOfClass("Tool") then
						heldBy("no tool", dt)
						return
					end
					-- NORMAL MOBS: swing only once LOCKED ON (user 2026-10-28) -- the hover is over a live mob and
					-- we're within 16 studs of it (the hover spot is ~10.4 out), not while flying to it. Bosses,
					-- ground fights (Kramprus) and up-dodges as before.
					if ZQ5.hover and not ZQ5.vdodge then
						local hm = ZQ5.hoverMob
						local bossHover = isValidMob(hm) and not isNormalMob(hm)
						if not bossHover and not (ZQ5.hoverActive and isValidMob(hm)
							and (hm.HumanoidRootPart.Position - PlayerHumpart.Position).Magnitude <= 16) then
							heldBy("not locked on", dt)
							return
						end
					end
					if tick() - lastSwing < wait_ then
						-- the mob the finisher (hit 5) was swung at is dead: no 1.5s pause on the next one
						-- (user 2026-10-28: a short delay after the hover snapped over the next mob)
						local lastMob = ZQ5.m1LastMob
						if not (wait_ > 0.5 and lastMob ~= nil and not isValidMob(lastMob)) then
							return
						end
						wait_ = 0
					end
					-- the anticheat-notice check, read at most every 0.5s (user 2026-10-28: it was a full GUI scan
					-- before EVERY swing -- a small delay each hit); a notice showing still holds the swings
					if tick() - acAt > 0.5 then
						acAt = tick()
						acRes = checkAnticheatNotifications()
					end
					if acRes then
						heldBy("ac notice", dt)
						return
					end

					local root = PlayerHumpart
					local targets = targetsInRange(combatRange())
					if #targets == 0 then
						heldBy("out of range", dt)
						return
					end
					local target = pickAttackTarget(targets)
					if not target then
						return
					end
					-- the picked (unblocked) target goes first in the damage call's list too
					if targets[1] ~= target then
						for i, p in ipairs(targets) do
							if p == target then
								table.remove(targets, i)
								break
							end
						end
						table.insert(targets, 1, target)
					end

					local fruit = isFruitTarget(target)
					if not fruit and not COMBO5 and combo > (CFG.ComboMax or COMBO_MAX) then
						combo = 1 -- (just moved off a fruit user mid-burst: back to 1-2-3-4)
					end
					if fruit and not ZQ5.fruitComboSaid then
						ZQ5.fruitComboSaid = true
						print("[Zephyron] fruit user: 1-2-3-4-5 burst, 0.15s apart, 1.5s pause after 5")
					end
					local m1type = ZQ5.m1type or "Melee"
					local step = MELEE_COMBO[combo]
					local animFolder = RS:FindFirstChild("CombatAnimations")
					local meleeFolder = animFolder and animFolder:FindFirstChild("Melee")
					local animName = (m1type == "Melee") and step.anim or "Punch1"
					local animation = meleeFolder and meleeFolder:FindFirstChild(animName)
					if m1type == "Sword" then
						-- a weapon swings ITS OWN slash (Tensen: Modules.SwordHandle.Swords.<weapon>.Slashes),
						-- not the melee Punch1 this used to send with every weapon M1
						local SLASHES = { "Slash1", "Slash2", "Slash3", "GroundSlash4", "GroundSlash5" }
						pcall(function()
							local swords = RS.Modules.SwordHandle.Swords
							for _, w in ipairs(swords:GetChildren()) do
								if Character:FindFirstChild(w.Name) then
									local slash = w:FindFirstChild("Slashes") and w.Slashes:FindFirstChild(SLASHES[step.index] or "Slash1")
									if slash then
										animation = slash
									end
									break
								end
							end
						end)
					end

					if farmFeint(target, step.index, animation, m1type) then
						if not M1_SYNC then
							lastSwing = tick()
							wait_ = HIT_WAIT
						end
						return
					end

					local events = RS:FindFirstChild("Events")
					local remote = events and events:FindFirstChild("CombatRegister")
					if not remote then
						return
					end
					local swingAt = tick()
					local dmgCF = damageCFrame(target, root)
					if M1_SYNC then
						lastSwing = swingAt -- the gap is HitWait from the swing START, whatever the ping
					end
					if M1_SYNC and CFG.M1Parallel == true then
						task.spawn(pcall, function()
							remote:InvokeServer({ "swingsfx", m1type, step.index, "Ground", false, animation, 2, 1.5 })
						end)
					else
						-- the server registers the swing first, then the damage (sending both at once
						-- may let the damage arrive before the swing it belongs to)
						remote:InvokeServer({ "swingsfx", m1type, step.index, "Ground", false, animation, 2, 1.5 })
					end
					trackHit(targets, target)
					ZQ5.m1LastMob = target.Parent
					ZQ5.m1LastRet = remote:InvokeServer({
						"damage",
						targets,
						m1type,
						{ step.index, "Ground", m1type },
						true,
						dmgCF,
						aircombo = "Ground",
					})
					if not M1_SYNC then
						lastSwing = tick()
					end
					wait_ = waitAfter(step.index, fruit)
					combo = combo + 1
					if combo > ((COMBO5 or fruit) and 5 or (CFG.ComboMax or COMBO_MAX)) then
						combo = 1
					end
				end)
				if not ok and os.clock() - lastErr > 10 then
					lastErr = os.clock()
					print("[Zephyron] m1 step failed: " .. tostring(err))
				end
			end
		end)

		-- WEAPON SKILLS (boss fights only). Each skill of the equipped weapon is cast the moment
		-- it is off cooldown; the M1 loop pauses only while a cast is going off.
		-- Protocols are read from ReplicatedStorage.SkillCallbacks.SwordStyles.<weapon>
		-- (weapon_scan, 2026-10-14). Every skill starts with Events.Skill:InvokeServer(name, ...):
		--   "fire"    -> returns a remote; after the windup, remote:FireServer(cf)
		--   "fireNil" -> same, but remote:FireServer() (the server uses our own root)
		--   "rush"    -> remote:FireServer(cf), then FireServer("newCF", cf) every frame for 1s
		--   "single"  -> one InvokeServer(name, {cf = cf}) at the end of the windup, no remote back
		-- None of them uses faceMouse. cf is a CFrame right next to the boss, looking at it
		-- (as the M1 damage call sends). Turn off with ZephyronCombat.WeaponSkills = false.
		;(function() -- own function: keeps these locals out of the chunk's 200-local limit
		local WEAPON_SKILLS = {
			["Vrael's Pipe"] = {
				-- Pipe Rush dropped (2026-10-15): it hurt more than it helped
				{ name = "Pipe Beatdown", kind = "fire", windup = 0.45, cd = 17, stam = 45 },
			},
			["Kraken Blade"] = {
				{ name = "Slayer Cross Slash", kind = "fireNil", windup = 0.5, cd = 25, stam = 55, pitch = true },
				{ name = "Eternal Flow", kind = "fireNil", windup = 0.3, cd = 15, stam = 35 },
			},
			["Golden Hook"] = {
				-- buff: cast the moment it's off cooldown in ANY fight, even mid-dodge / out of range
				-- buffChild: the buff puts "poisonBuff" on the character for 10s; we recast the moment
				-- it's gone (the server allows it well before our 15.5s cooldown count -- measured
				-- 2026-10-14: buff 10s, and a manual press worked in the gap)
				{ name = "Activate Poison", kind = "single", windup = 0, cd = 15, stam = 25, buff = true, buffChild = "poisonBuff" },
				-- Hook Impale/Dehydrate dropped (2026-10-15, by request): Activate Poison only
			},
		}
		local SKILL_SLACK = 0.5 -- added to every cooldown, so the server never refuses on the edge
		local SKILL_RETRY = 2 -- refused (server said no): try again after this
		local STAM_RESERVE = 10 -- keep enough for a block
		local skillReadyAt = {}
		local skillCdCache = {}

		local function skillCd(s)
			if skillCdCache[s.name] then
				return skillCdCache[s.name]
			end
			local ok, cd = pcall(function()
				return require(RS.Modules.Skills).GetM(s.name).cd
			end)
			skillCdCache[s.name] = ((ok and tonumber(cd)) or s.cd) + SKILL_SLACK
			return skillCdCache[s.name]
		end

		-- (user 2026-10-28: no skills on normal mobs) HPScaled alone isn't a boss -- the target loop sets it
		-- on every target, so normal mobs were getting skills
		local function isBossMob(npc)
			return not isNormalMob(npc)
				and (npc:GetAttribute("HPScaled") ~= nil
					or npc:FindFirstChild("Boss") ~= nil
					or string.find(npc.Name, "Vera", 1, true) ~= nil)
		end

		local function equippedSkillSet()
			local tool = Character and Character:FindFirstChildOfClass("Tool")
			local weapon = tool and wantedWeaponName(tool.Name)
			return weapon and WEAPON_SKILLS[weapon], weapon
		end

		local function stamina()
			local stats = RS:FindFirstChild("Stats" .. LocalPlayer.Name)
			local s = stats and stats:FindFirstChild("Stamina")
			return s and s.Value or 0
		end

		-- the boss this skill loop may hit right now, or nil
		local function skillTarget()
			if CFG.WeaponSkills == false or getgenv().ZQ_PAUSE then
				return nil
			end
			if not leaseActive() or not ZQ5.attack or ZQ5.moving or RaiuiAnims or EloAnims then
				return nil
			end
			if tick() < (ZQ5.blockHoldUntil or 0) then
				return nil -- holding block (Love Pistol)
			end
			if MovementSystem:IsLocked() or Character:FindFirstChild("Stun") then
				return nil
			end
			local mob = ZQ5.hoverMob or ZQ5.enemy
			if not (isValidMob(mob) and isBossMob(mob)) then
				return nil
			end
			if tick() < (ZQ5.dodgeUntil or 0) then
				return nil -- out on a dodge
			end
			if (mob.HumanoidRootPart.Position - PlayerHumpart.Position).Magnitude > combatRange() + 5 then
				return nil
			end
			return mob
		end

		local function aimCF(mob)
			local bp = mob.HumanoidRootPart.Position
			local flat = Vector3.new(PlayerHumpart.Position.X - bp.X, 0, PlayerHumpart.Position.Z - bp.Z)
			if flat.Magnitude < 0.5 then
				local lv = PlayerHumpart.CFrame.LookVector
				flat = Vector3.new(-lv.X, 0, -lv.Z)
			end
			local from = bp + flat.Unit * 4 + Vector3.new(0, 1, 0)
			return CFrame.lookAt(from, bp)
		end

		-- returns true when the server took the cast
		local function castSkill(s, mob)
			local skill = RS.Events.Skill
			local cf = function()
				return (mob and isValidMob(mob)) and aimCF(mob) or PlayerHumpart.CFrame
			end
			if s.kind == "single" then
				if s.windup > 0 then
					task.wait(s.windup)
				end
				skill:InvokeServer(s.name, { cf = cf() })
				return true -- nothing comes back to tell a refusal apart
			end
			local remote = skill:InvokeServer(s.name)
			if typeof(remote) ~= "Instance" then
				return false
			end
			task.wait(s.windup)
			if s.kind == "fireNil" then
				remote:FireServer()
			else
				remote:FireServer(cf())
			end
			if s.kind == "rush" then
				local t0 = tick()
				repeat
					task.wait()
					remote:FireServer("newCF", cf())
				until tick() - t0 >= 1
			end
			return true
		end

		-- MELEE BLOCK BREAKER (user 2026-10-31, as wyverncinder4's second block breaker). BOTH modes: a boss that's
		-- blocking gets the fighting style's skill -- Basic Combat -> Gut Punch (15s, 10 stamina), Cyborg -> Laser
		-- Pulsar (14s, 30 stamina); other styles: none (Wyvern: a wrong-style cast is refused every time). Weapon
