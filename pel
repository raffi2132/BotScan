	local function skippedNpc(npc)
		-- DEAD = skipped (user 2026-10-28: after a kill it hung mid-air, then dropped). A killed mob stays in
		-- NPCs (still named "Test") until its body despawns, and the picker kept handing that corpse back --
		-- m1Attack refuses a dead mob, so no next target until the body was gone
		local h = npc:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then
			return true
		end
		-- ImpelIgnore (leftover Mini Bunnies): never targeted, but left in the game
		if npc:GetAttribute("ImpelIgnore") then
			return true
		end
		-- never skip Elo (it leaps high; the hover reaches it anywhere): a skipped Elo let its Mini
		-- Bunnies be picked first
		if (npc:GetAttribute("RealName") or npc.Name) == "Elo The Bunny" then
			return false
		end
		-- by a falling spike trap (SPIKE-TRAP MOBS, user 2026-10-31): the others first, then a lure
		if ZQ5 and ZQ5.spikeMob and ZQ5.spikeMob(npc) then
			return true
		end
		-- (ImpelSkipUntil and the "another level, no walking route -> skip 60s" check removed: (user 2026-10-28: never skip a mob -- every mob spawns in its area and must die to move on))
		do
			return false
		end
		local r = npc:FindFirstChild("HumanoidRootPart")
		local me = PlayerHumpart
		if not (r and me) or (ZQ5 and (ZQ5.vdodge or ZQ5.hoverActive)) then
			return false -- up on a dodge / hover: our own height says nothing about the mob's
		end
		if math.abs(r.Position.Y - me.Position.Y) <= 30 then
			return false
		end
		if tick() - (npc:GetAttribute("ImpelPathCheckAt") or 0) < 60 then
			return false -- checked recently and it was reachable
		end
		npc:SetAttribute("ImpelPathCheckAt", tick())
		local ok, status = pcall(function()
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			rp.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
			pcall(function()
				rp.RespectCanCollide = true
			end)
			local g = workspace:Raycast(r.Position + Vector3.new(0, 1, 0), Vector3.new(0, -40, 0), rp)
			local dest = g and (g.Position + Vector3.new(0, 3, 0)) or r.Position
			local path = game:GetService("PathfindingService"):CreatePath({ AgentRadius = 2.5, AgentHeight = 6, AgentCanJump = true })
			path:ComputeAsync(me.Position, dest)
			return path.Status
		end)
		if ok and status ~= Enum.PathStatus.Success then
			npc:SetAttribute("ImpelSkipUntil", tick() + 60)
			print(string.format("[TARGET] %s is %.0f studs above/below with no walking route, skipping it for 60s",
				tostring(npc:GetAttribute("RealName") or npc.Name), r.Position.Y - me.Position.Y))
			return true
		end
		return false
	end

