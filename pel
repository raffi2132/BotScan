	-- near mob with a clear straight line to it (no wall / floor between: the hover flies
	-- straight, so through a wall it would earn noclip flags) and on about our level
	-- (flatMax / dyMax: optional, default 45 / 25; bosses use the longer BOSS_REACH below)
	-- the height gap to a mob (user 2026-10-27: after a kill it sometimes stopped hovering on to the next
	-- one). While hovering -- or held in the air by the hover grace -- we're ~10 above the last mob's level,
	-- so a next mob 16+ below it read as "another level" (>25 / >30): the walker took over and we dropped.
	-- Then the gap is also measured from 10 below us, the smaller one counts.
	function hoverDY(mobY)
		local y = PlayerHumpart.Position.Y
		local dy = math.abs(mobY - y)
		if ZQ5 and (ZQ5.hoverActive or tick() - (ZQ5.lastHoverAt or 0) < 2) then
			dy = math.min(dy, math.abs(mobY - (y - 10)))
		end
		return dy
	end

	function mobInReach(npc, flatMax, dyMax)
		local mhrp = npc and npc:FindFirstChild("HumanoidRootPart")
		local root = PlayerHumpart
		if not mhrp or not root then
			return false
		end
		if false and ZQ5 and ZQ5.noHoverMob == npc and tick() < (ZQ5.noHoverUntil or 0) then -- (never skipped, user 2026-10-28)
			return false -- the hover got stuck on a wall going to it a moment ago
		end
		local d = mhrp.Position - root.Position
		-- (flat reach 300 by default, user 2026-10-28: every spawned mob is in reach of its area -- was 45)
		if hoverDY(mhrp.Position.Y) > (dyMax or 25) or Vector3.new(d.X, 0, d.Z).Magnitude > (flatMax or 300) then
			return false
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {
			Character,
			npc,
			workspace:FindFirstChild("NPCs"),
			workspace:FindFirstChild("Effects"),
			workspace:FindFirstChild("PlayerCharacters"),
		}
		pcall(function()
			params.RespectCanCollide = true
		end)
		-- from head height to a point above the mob (where we will hover)
		local from = root.Position + Vector3.new(0, 1.5, 0)
		local to = mhrp.Position + Vector3.new(0, 5, 0)
		local hit = workspace:Raycast(from, to - from, params)
		return hit == nil
	end

	-- a boss this close with a clear straight line to it: fly the hover straight to it instead
	-- of walking to whatever floor waypoint the caller passed (the pad flies straight and stops
	-- at walls, so the line-of-sight check is what keeps it out of them)
	BOSS_REACH, BOSS_REACH_DY = 100, 30
	-- the Basilisk that comes with the Impel Down Elite High Guard: killed FIRST, before anything
	-- else, and hovered onto even well above / below us (BASILISK_DY). Its BirdGust is dodged
	-- (see the dodge trigger); BirdPeck is ignored.
	BASILISK_DY = 80
	-- Krampus: the game calls it "Krampus, The Ravager"; impel used to check one exact spelling.
	-- Match any name with "kramp" in it (RealName first: targets get renamed "Test").
	function isKrampusNpc(npc)
		if not npc then
			return false
		end
		local n = string.lower(tostring(npc:GetAttribute("RealName") or npc.Name))
		return string.find(n, "kramp", 1, true) ~= nil
	end
	function isBasiliskNpc(npc)
		return npc ~= nil and (npc.Name == "Basilisk" or npc:GetAttribute("RealName") == "Basilisk")
	end
	-- a real boss, for the fruit-user checks: NOT HPScaled -- the target loop sets HPScaled itself on every
	-- target (all mobs carry an Info.DevilFruit value, "" when they have no fruit), so a fruit user being
	-- fought read as a boss. Fruit users have ~206 HP; bosses thousands.
	function isRealBoss(npc)
		local hum = npc and npc:FindFirstChildOfClass("Humanoid")
		return npc ~= nil
			and (npc:FindFirstChild("Boss") ~= nil or string.find(npc.Name, "Vera", 1, true) ~= nil
				or isKrampusNpc(npc) or isBasiliskNpc(npc) or (hum ~= nil and hum.MaxHealth >= 5000))
	end

	-- a NORMAL MOB (user 2026-10-27): not a real boss, under 1000 max HP, not Elo, not a BOSS_RULES boss.
	-- Gets the 5-hit combo, the 8-up hover and no weapon skills.
	function hasDevilFruitUser(npc)
		local info = npc and npc:FindFirstChild("Info")
		local df = info and info:FindFirstChild("DevilFruit")
		return df ~= nil and tostring(df.Value) ~= ""
	end

	function isNormalMob(npc)
		local hum = npc and npc:FindFirstChildOfClass("Humanoid")
		if not hum or isRealBoss(npc) or hum.MaxHealth >= 1000 then
			return false
		end
		if (npc:GetAttribute("RealName") or npc.Name) == "Elo The Bunny" or (ZQ5 and ZQ5.bossRule and ZQ5.bossRule(npc)) then
			return false
		end
		return true
	end

	-- a GUN / BAZOOKA user (user 2026-10-28: second in line after fruit users; hovered 2 IN FRONT of them):
	-- Info.CombatType "Gun" (seen: Impel Guard, Weapon=Bazooka), or a gun-type Info.Weapon
	function isGunNpc(npc)
		local info = npc and npc:FindFirstChild("Info")
		if not info then
			return false
		end
		local ct = info:FindFirstChild("CombatType")
		if ct and tostring(ct.Value) == "Gun" then
			return true
		end
		local w = info:FindFirstChild("Weapon")
		local wn = w and string.lower(tostring(w.Value)) or ""
		for _, k in ipairs({ "bazooka", "gun", "pistol", "rifle", "flintlock", "musket", "cannon" }) do
			if string.find(wn, k, 1, true) then
				return true
			end
		end
		return false
	end

	function isBossNpc(npc)
		return npc ~= nil
			and (npc:GetAttribute("HPScaled") ~= nil or npc:FindFirstChild("Boss") ~= nil or string.find(npc.Name, "Vera", 1, true) ~= nil
				or isKrampusNpc(npc) -- hovered like any boss now (was a ground fight)
				or isBasiliskNpc(npc))
	end

	function controlTower(pos, speed)
		if not PlayerHumpart or not Character or not CanFarm then
			return
		end
		-- a target that's by a falling spike trap now (SPIKE-TRAP MOBS, user 2026-10-31): never hover onto it, never
		-- walk under the trap to it -- the pickers hand out another, or the lure runs
		if Npc and ZQ5 and ZQ5.spikeMob and ZQ5.spikeMob(Npc) then
			if Npc.Name == "Test" then
				Npc.Name = Npc:GetAttribute("RealName") or "FarNpc"
			end
			Npc = nil
			return
		end

		local weaponStyle = Npc and Npc:FindFirstChild("Info") and Npc.Info:FindFirstChild("Weapon")
		local finalPos = pos

		do -- (the low-health hide 80 studs above the mob is removed: flight strikes)
			if
				Npc
				and GetMagnitudeIgnoringY(Npc.HumanoidRootPart.Position) < (isBossNpc(Npc) and BOSS_REACH + 10 or 310) -- (was 50; 300 reach, user 2026-10-28)
				and getdistance(Npc.HumanoidRootPart.Position) < 320
				and Npc:GetAttribute("RealName") ~= "Blugori"
				and not NutcrackerAnims
			then
				local m1Distance = 10
				-- keep the long hover range only while the mob stays in sight: once it runs behind a
				-- wall the lease runs out, the pad lands and the walker paths around instead
				local alreadyOnIt = ZQ5 and ZQ5.hoverActive and ZQ5.enemy == Npc and mobInReach(Npc)
				local isVera = string.find(Npc.Name, "Vera", 1, true) ~= nil
				if isVera then
					-- quest5 style: let the hover engine fly to and follow Vera instead of
					-- tween-teleporting next to her and only hovering inside 10 studs
					m1Distance = 45
				elseif Npc:GetAttribute("RealName") == "Elo The Bunny" then
					m1Distance = 20
				elseif Npc:FindFirstChild("RaiuiSword") or Npc:GetAttribute("RealName") == "Kelvin, The Nutcracker" then
					m1Distance = 15
				end
				if alreadyOnIt then
					m1Distance = math.max(m1Distance, 300)
				elseif m1Distance < 300 and mobInReach(Npc) then
					-- a mob in plain sight within 300 (user 2026-10-28, was 45): fly to it with the hover and stay
					-- above it, instead of walking up to it with the ground walker
					m1Distance = 300
				end
				if isBossNpc(Npc) and mobInReach(Npc, BOSS_REACH, isBasiliskNpc(Npc) and BASILISK_DY or BOSS_REACH_DY) then
					m1Distance = math.max(m1Distance, BOSS_REACH) -- boss in sight: hover straight to it
				end

				-- never hover-engage a mob far above / below us (another level): m1Distance is
				-- horizontal only, so a mob on a ledge 90 studs overhead made the pad fly straight up
				-- into the ceiling. Walk there instead (the path takes the stairs / ramps).
				local dY = hoverDY(Npc.HumanoidRootPart.Position.Y)
				-- out on a dodge, or just back from one (4s): stay engaged so the hover flies us straight
				-- back over the boss. The dodge ends 55 studs out, past the normal reach, and the walker
				-- used to take over there and path off somewhere first.
				-- ANY dodge counts (the attacker may be another mob -- the Basilisk while we fight the
				-- Elite High Guard: that dropped the fight mid-dodge and left us hanging 78 studs up)
				-- (a fruit-user skill dodge too, user 2026-10-29: it ends 45-65+ studs out)
				local dodging = ZQ5 and (tick() < (ZQ5.dodgeUntil or 0) + 4 or ZQ5.vdodge ~= nil
					or (ZQ5.fruitDodge ~= nil and tick() < (ZQ5.fruitDodge.untilT or 0) + 2))
				if dY > 30 and not dodging and not isVera and not (isBasiliskNpc(Npc) and dY <= BASILISK_DY) then
					m1Distance = 0
				end
				if dodging then
					m1Distance = math.max(m1Distance, 90)
				end

				if GetMagnitudeIgnoringY(Npc.HumanoidRootPart.Position) < m1Distance then
					-- (Kramprus used to be swung at from the ground with m1AttackSimple, no hover; it's
					-- hovered over like every other boss now, 2026-10-14)
					do
						local offset = Vector3.new(0, 6, 3)
						local safeYoffset = 20
						local weaponStyle = Npc:FindFirstChild("Info") and Npc.Info:FindFirstChild("Weapon")
						if isVera then
							offset = Vector3.new(0, 8, 0)
							safeYoffset = 20
						elseif Npc:GetAttribute("RealName") == "Elo The Bunny" then
							offset = Vector3.new(0, 11, 3) -- hover 11 studs above Elo (was 9; user, 2026-10-26)
							safeYoffset = 20
						elseif
							weaponStyle
							and (weaponStyle.Value == "Flower Bouquet" or weaponStyle.Value == "Candy Cane")
						then
							offset = Vector3.new(0, 7, 3)
							safeYoffset = 30
						elseif Npc:GetAttribute("RealName") == "Kelvin, The Nutcracker" then
							offset = Vector3.new(0, 10, 3)
							safeYoffset = 40
						elseif Npc:GetAttribute("RealName") == "Demon Jester" then
							offset = Vector3.new(0, 8, 3)
							safeYoffset = 40
						elseif Npc:FindFirstChild("RaiuiSword") then
							offset = Vector3.new(0, 7, 3)
						elseif Npc:GetAttribute("RealName") == "Cupid Queen" then
							offset = Vector3.new(0, 8, 0)
						elseif Npc:GetAttribute("RealName") == "Mini Bunny" then
							offset = Vector3.new(0, 7, 0)
						elseif Npc:GetAttribute("HPScaled") then
							offset = Vector3.new(0, 7, 3)
						end
						m1Attack(Npc, safeYoffset, m1Distance, offset, "Air")
						return
					end
				end
			elseif
				Npc
				and GetMagnitudeIgnoringY(Npc.HumanoidRootPart.Position) < 50
				and Npc:GetAttribute("RealName") == "Blugori"
			then
				if GetMagnitudeIgnoringY(Npc.HumanoidRootPart.Position) < 40 then
					local offset = Vector3.new(0, 5, 15) -- 5 studs up (2026-10-16, by request; was 0)
					m1Attack(Npc, 40, 40, offset, "Air")
					return
				end
			end
		end

		if ZQ5 and ZQ5.hoverOnly then
			return -- a fight-first fight: hover onto the mob or nothing, never a walk / teleport
		end

		if typeof(finalPos) == "CFrame" then
			finalPos = finalPos.Position
		end
		local targetPos = finalPos

		if (PlayerHumpart.Position - targetPos).Magnitude > 5 then
			if isUnderTrap(targetPos) then
				targetPos = findSafePositionFromTrap(targetPos)
			end

			local yDifference = math.abs(PlayerHumpart.Position.Y - targetPos.Y)
			if yDifference > 50 then
				Facemouse()
				task.wait(0.3)
			end

			local isSpecialOffsetNpc = Npc
				and (Npc:GetAttribute("RealName") == "Elo The Bunny" or isKrampusNpc(Npc))

			ZQ5.lastWalkResult = nil
			if isSpecialOffsetNpc then
				instatp(targetPos)
			else
				tweenWithTeleport(CFrame.new(targetPos), speed, selected_Offset)
			end
			-- no path to this mob 3 times running: it's somewhere we can't walk to (and too far
			-- above / below to hover onto) -- leave it for 90s, GetImpelNpc picks another
			if Npc and Npc.Parent then
				if ZQ5.lastWalkResult == "nopath" then
					local n = (Npc:GetAttribute("ImpelNoPath") or 0) + 1
					Npc:SetAttribute("ImpelNoPath", n)
					if false and n >= 3 then -- (user 2026-10-28: never skip a mob -- every mob spawns in its area and must die to move on)
						Npc:SetAttribute("ImpelNoPath", 0)
						Npc:SetAttribute("ImpelSkipUntil", tick() + 90)
						print("[TARGET] no path to " .. tostring(Npc:GetAttribute("RealName") or Npc.Name) .. " at " .. tostring(Npc:FindFirstChild("HumanoidRootPart") and Npc.HumanoidRootPart.Position) .. ", skipping it for 90s")
						if Npc.Name == "Test" then
							Npc.Name = Npc:GetAttribute("RealName") or "FarNpc"
						end
						Npc = nil
					end
				elseif ZQ5.lastWalkResult == nil then
					Npc:SetAttribute("ImpelNoPath", 0)
				end
			end
		end
	end

	function fireProximityPromptSafely(proximityPrompt)
		task.wait()
		if not proximityPrompt or not proximityPrompt:IsA("ProximityPrompt") then
			return
		end

		local parent = proximityPrompt.Parent
		if not parent then
			return
		end

		local targetPos = parent:IsA("Model") and parent:GetPivot().Position or parent.Position

		if (PlayerHumpart.Position - targetPos).Magnitude > 50 then
			return
		end

		for i, v in pairs(workspace.Effects:GetDescendants()) do
			if v:IsA("ProximityPrompt") and v ~= proximityPrompt then
				v.MaxActivationDistance = 0
			end
		end

		workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetPos)

		proximityPrompt.MaxActivationDistance = 10

		wait(0.1)

		proximityPrompt:InputHoldBegin()
		wait(proximityPrompt.HoldDuration + 0.5 or 0.3)
		proximityPrompt:InputHoldEnd()
		task.wait(1)
	end

	local function getNearestHumPart(RareChests)
		local nearestHumPart = nil
		local minDistance = math.huge

		for _, HumPart in pairs(RareChests) do
			if HumPart then
				local distance = (HumPart.Position - PlayerHumpart.Position).magnitude
				if distance < minDistance then
					minDistance = distance
					nearestHumPart = HumPart
				end
			end
		end

		return nearestHumPart
	end

	local gotSpResetEssence = false
	local gotSpResetFromCommon = false

	-- NIGHTMARE+ (user 2026-10-27): what the difficulty picker chooses -- at least one clear
	-- (DungeonPoints.HighestImpelDownClear), or ZephyronCombat.Difficulty forced. On it: own Kraken Blade
	-- (always equipped), no weapon hunting, no SP Reset; chests only for Spirit Essence.
	-- NIGHTMARE+ INDICATOR (user 2026-10-28): the BackpackCleared player attribute. A Normal run clears the
	-- backpack ~86-100s into the server (watched on Watduhellbruvv: at 86s BackpackCleared -> true and the
	-- Kraken Blade, Goro-Goro and SP Reset Essence were gone, Melee left); Nightmare+ never clears it (our own
	-- Kraken Blade stays -- Watduhellbruv, 392s in, no flag). So: no BackpackCleared by 110s = Nightmare+.
	-- ZephyronCombat.Difficulty = "nightmare+" / "normal" still forces it either way.
	-- ImpelModeKnown(): false until the flag shows or 110s pass (nothing irreversible -- eating the SP Reset
	-- Essence -- happens before that).
	local NM_DECIDE_AGE = 110
	function ImpelModeKnown()
		local forced = string.lower(tostring((getgenv().ZephyronCombat or {}).Difficulty or ""))
		if forced == "nightmare+" or forced == "normal" then
			return true
		end
		return LocalPlayer:GetAttribute("BackpackCleared") == true or (workspace:GetAttribute("serverAge") or 0) >= NM_DECIDE_AGE
	end
	function ImpelNightmarePlus()
		local forced = string.lower(tostring((getgenv().ZephyronCombat or {}).Difficulty or ""))
		if forced == "nightmare+" then
			return true
		elseif forced == "normal" then
			return false
		end
		if game.PlaceId ~= 11424731604 or LocalPlayer:GetAttribute("BackpackCleared") == true then
			return false
		end
		local nm = (workspace:GetAttribute("serverAge") or 0) >= NM_DECIDE_AGE
		if nm and Others and not Others.NmDetectLogged then
			Others.NmDetectLogged = true
			print(string.format("[MODE] Nightmare+ detected: no BackpackCleared after %ds -- own weapon, no SP Reset, Spirit Essence only", NM_DECIDE_AGE))
		end
		return nm
	end
