					-- the server never sees it) can't clear it. So no pad until the humanoid stands on
					-- something -- we just fall meanwhile; after 6s of never landing, start it anyway.
					local hum = Character and Character:FindFirstChildOfClass("Humanoid")
					if not (hum and hum.FloorMaterial ~= Enum.Material.Air) then
						-- (the 6s restarts if this wait was interrupted -- a stale start made the next
						-- hover begin in the air at once)
						if not ZQ5.padAirSince or tick() - (ZQ5.padAirSeen or 0) > 1 then
							ZQ5.padAirSince = tick()
						end
						ZQ5.padAirSeen = tick()
						if tick() - ZQ5.padAirSince < 6 then
							ZQ5.hoverActive = false
							ZQ5.lastPin = nil
							return
						end
						print("[HOVER] never touched the ground in 6s - starting the pad in the air")
					end
					ZQ5.padAirSince = nil
					pad = newHoverPad(hrp)
				end

				local standAt = pad.Position + Vector3.new(0, HOVER_PAD_STAND, 0)

				-- HIT (Elo's slam, any knock): never snap the body back up to the pad. The snap is
				-- an instant rise and earned "Y+ too fast" strikes. While knocked (ragdolled, or the
				-- body pushed off the pin), move the pad under the body where it is and climb back
				-- slowly afterwards.
				local myHum = Character and Character:FindFirstChildOfClass("Humanoid")
				local knocked = false -- (no ragdoll handling: the old build only deleted Ragdoll_Client)
				-- only a SIDEWAYS shove is a hit. A drop straight down is gravity in a long frame
				-- (low FPS, background window): re-seating the pad there let us sink frame by
				-- frame into the floor. Just pin back.
				local off = hrp.Position - standAt
				local sideways = Vector3.new(off.X, 0, off.Z).Magnitude
				-- (locked on the Cupid Queen: a shove is just pinned back, the lock holds)
				if not (ZQ5.hoverLocked and ZQ5.isCupid(mob)) and (knocked or (sideways > 2 and off.Magnitude > 3)) then
					pad.Position = hrp.Position - Vector3.new(0, HOVER_PAD_STAND, 0)
					ZQ5.lastPin = hrp.Position
					ZQ5.hitAt = tick()
					ZQ5.hoverLocked = false -- shoved off the spot: ease back in before locking again
					if knocked then
						return -- leave the body to the hit; re-seat again next frame
					end
					standAt = hrp.Position
				end

				-- aim where a running mob WILL be (0.3s ahead, flat), so the pad keeps up with
				-- fleeing / kiting mobs instead of trailing behind them
				local mv = mhrp.AssemblyLinearVelocity
				local mobSpeed = Vector3.new(mv.X, 0, mv.Z).Magnitude
				-- fast / kiting mobs (gun guards backing off): aim further ahead and move faster.
				-- A flat 30 studs/s with a 0.3s / 12-stud lead left us trailing behind them.
				local leadTime = mobSpeed > 12 and 0.5 or 0.3
				local leadCap = mobSpeed > 12 and 20 or 12
				local lead = Vector3.new(mv.X, 0, mv.Z) * leadTime
				if lead.Magnitude > leadCap then
					lead = lead.Unit * leadCap
				end
				local targetPos = hoverPointFor(mob) + lead
				-- pad speed: 30, or the mob's speed x1.5 + 10 when that's more (up to 60, about
				-- the 55 the dodge slide already uses). Climbing keeps its own slow cap below.
				local padSpeed = math.clamp(math.max(HOVER_PAD_SPEED, mobSpeed * 1.5 + 10), HOVER_PAD_SPEED, CFG.HoverChaseMax or 50) -- (was 60: TP Check "18 | 17")

				-- BOSS DODGE (Elo's slam + the boss-skill dodge below): slide far out to the side at
				-- hover height (no going up), circle the boss out there until the attack is over,
				-- then come back. Dodges the boss that attacked, even while hovering another mob.
				local dmob = ZQ5.dodgeMob
				local dodging = dmob ~= nil and tick() < (ZQ5.dodgeUntil or 0) and isValidMob(dmob)
					and not ZQ5.isCupid(mob) -- on the Cupid Queen: no dodge of any boss
				if dodging then
					local dhrp = dmob.HumanoidRootPart
					local dp = RaycastParams.new()
					dp.FilterType = Enum.RaycastFilterType.Exclude
					dp.FilterDescendantsInstances = { Character, pad, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects") }
					pcall(function()
						dp.RespectCanCollide = true
					end)
					-- out at the hover height we already have: no drop and slow climb back
					local dodgeUp = math.max(ELO_DODGE_UP, ZQ5.offset and ZQ5.offset.Y or 0)
					local from = dhrp.Position + Vector3.new(0, dodgeUp, 0)
					if not ZQ5.dodgeDir then
						local base = Vector3.new(standAt.X - dhrp.Position.X, 0, standAt.Z - dhrp.Position.Z)
						if base.Magnitude < 1 then
							local lv = dhrp.CFrame.LookVector
							base = Vector3.new(-lv.X, 0, -lv.Z)
						end
						base = base.Unit
						-- the first direction with a clear run (no wall) out to the dodge distance
						for _, a in ipairs({ 0, 45, -45, 90, -90, 135, -135, 180 }) do
							local d = CFrame.Angles(0, math.rad(a), 0) * base
							if not workspace:Raycast(from, d * (ELO_DODGE_DIST + 3), dp) then
								ZQ5.dodgeDir = d
								break
							end
						end
						ZQ5.dodgeDir = ZQ5.dodgeDir or base
						ZQ5.dodgeSpin = ZQ5.dodgeSpin or 1
					end
					-- out there: keep circling the boss so aimed / homing attacks miss; turn back at walls
					local outDist = Vector3.new(standAt.X - dhrp.Position.X, 0, standAt.Z - dhrp.Position.Z).Magnitude
					if outDist > ELO_DODGE_DIST * 0.8 then
						local nextDir = CFrame.Angles(0, math.rad((CFG.DodgeOrbit or 40) * (dt or 1 / 60) * ZQ5.dodgeSpin), 0) * ZQ5.dodgeDir
						if workspace:Raycast(from, nextDir * (ELO_DODGE_DIST + 3), dp) then
							ZQ5.dodgeSpin = -ZQ5.dodgeSpin
						else
							ZQ5.dodgeDir = nextDir
						end
					end
					targetPos = dhrp.Position + ZQ5.dodgeDir * ELO_DODGE_DIST + Vector3.new(0, dodgeUp, 0)
					padSpeed = ELO_DODGE_SPEED
				else
					ZQ5.dodgeDir = nil
				end

				-- LIVE LOCK (Wyvern's hover, user 2026-10-24): once the pad has reached the hover spot
				-- it sits EXACTLY on the mob's live hover point every frame -- no lead, no speed cap,
				-- jumps included. Off while dodging, after a hit shoves us, on a new mob, or when it
				-- ends up > 15 studs off; the capped chase below then eases back in (climb <= 14/s)
				-- and re-locks within 2 studs.
				local lockedGoal = hoverPointFor(mob) - Vector3.new(0, HOVER_PAD_STAND, 0)
				-- the Basilisk within 20 studs (user, 2026-10-25): chased at full speed (50/s, climb 35/s)
				-- and locked from 3 studs, so it's on it almost at once -- never a snap, an instant
				-- jump earns "Y+ too fast" / TP strikes
				local basiliskNear = not dodging and isBasiliskNpc(mob) and (lockedGoal - pad.Position).Magnitude <= 20
				-- the Cupid Queen's lock is never released for distance (only a new target / her death)
				if dodging or ZQ5.hoverLockedMob ~= mob
					or (ZQ5.hoverLocked and not ZQ5.isCupid(mob) and (lockedGoal - pad.Position).Magnitude > 15) then
					ZQ5.hoverLocked = false
				elseif not ZQ5.hoverLocked and (lockedGoal - pad.Position).Magnitude <= (basiliskNear and 3 or 2) then
					ZQ5.hoverLocked = true
					ZQ5.lockedOnceMob = mob
				end
				ZQ5.hoverLockedMob = mob

				-- unlocked and not dodging: chase the LOCK spot itself, no lead -- chasing a point
				-- ahead of a moving mob kept the pad > 2 studs off the spot, so it never re-locked
				local goal = dodging and (targetPos - Vector3.new(0, HOVER_PAD_STAND, 0)) or lockedGoal
				local toGoal = goal - pad.Position
				if ZQ5.hoverLocked then
					pad.Position = lockedGoal
					ZQ5.padBlockedSince = nil
				elseif toGoal.Magnitude > 0.05 then
					if basiliskNear then
						padSpeed = math.max(padSpeed, 50) -- (50, not 60: TP Check)
					end
					local step = toGoal.Unit * math.min(padSpeed * (dt or 1 / 60), toGoal.Magnitude)
					-- climb slowly (fast rises earn "Y+ too fast"), slower still right after a hit. But
					-- catching back up to a mob we were already locked on that went UP (a boss's geppo,
					-- often right after an up-dodge) climbs at the up-dodge's own 35/s -- 14/s left us
					-- crawling up under it
					local climb = HOVER_CLIMB_SPEED
					if not dodging and (basiliskNear or (ZQ5.lockedOnceMob == mob and toGoal.Y > 5)) then
						climb = CFG.HoverCatchUpClimb or 35
					end
					local maxUp = (tick() - (ZQ5.hitAt or 0) < 2 and 6 or climb)
						* (dt or 1 / 60)
					if step.Y > maxUp then
						step = Vector3.new(step.X, maxUp, step.Z)
					end
					-- never carry the body through a wall / floor (noclip + tp flags): if the body or
					-- head line of this step hits geometry, hold here this frame
					local rp = RaycastParams.new()
					rp.FilterType = Enum.RaycastFilterType.Exclude
					rp.FilterDescendantsInstances = {
						pad,
						Character,
						workspace:FindFirstChild("NPCs"),
						workspace:FindFirstChild("Effects"),
						workspace:FindFirstChild("PlayerCharacters"),
					}
					pcall(function()
						rp.RespectCanCollide = true
					end)
					local from = pad.Position + Vector3.new(0, HOVER_PAD_STAND, 0)
					local probe = step.Magnitude > 1e-3 and (step + step.Unit * 1.5) or Vector3.new(0, 0, 0)
					local blocked = probe.Magnitude > 0
						and (workspace:Raycast(from, probe, rp) or workspace:Raycast(from + Vector3.new(0, 1.5, 0), probe, rp))
					if not blocked then
						pad.Position = pad.Position + step
						ZQ5.padBlockedSince = nil
					else
						-- held against geometry too long: let the walker path to this mob instead
						ZQ5.padBlockedSince = ZQ5.padBlockedSince or tick()
						if tick() - ZQ5.padBlockedSince > 1.5 then
							ZQ5.padBlockedSince = nil
							ZQ5.noHoverMob, ZQ5.noHoverUntil = mob, tick() + 6
							print("[HOVER] path to " .. mob.Name .. " blocked, walking to it instead")
						end
					end
				end
				standAt = pad.Position + Vector3.new(0, HOVER_PAD_STAND, 0)

				ZQ5.lastPin = standAt
				-- (not while blocking: a velocity reset every frame drops block -- blocktest2, 1.8s)
				if tick() >= (ZQ5.blockHoldUntil or 0) then
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
				local toMob = mhrp.Position - standAt
				if (CFG.FaceMob ~= false or ZQ5.aimPitchAt == mob) and toMob.Magnitude > 0.1 then
					-- quest5 style: the body points AT the mob (tilted down over it), not upright.
					-- Straight overhead the look line is vertical (lookAt can't build that), so
					-- aim a stud ahead of the mob along our current facing instead.
					local flat = Vector3.new(toMob.X, 0, toMob.Z)
					if flat.Magnitude < 0.5 then
						local lv = hrp.CFrame.LookVector
						flat = Vector3.new(lv.X, 0, lv.Z)
						flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
						hrp.CFrame = CFrame.lookAt(standAt, mhrp.Position + flat)
					else
						hrp.CFrame = CFrame.lookAt(standAt, mhrp.Position)
					end
				elseif ZQ5.fight and facingDir and (targetPos - standAt).Magnitude <= ARRIVE_THRESHOLD then
					hrp.CFrame = CFrame.lookAt(standAt, standAt + facingDir)
				else
					local look = Vector3.new(mhrp.Position.X, standAt.Y, mhrp.Position.Z)
					if (look - standAt).Magnitude > 0.1 then
						hrp.CFrame = CFrame.lookAt(standAt, look)
					else
						hrp.CFrame = CFrame.new(standAt) * (hrp.CFrame - hrp.CFrame.Position)
					end
				end
			end)
		end)

		-- weapon + haki upkeep, throttled (controlTower calls m1Attack every frame)
		local function upkeep()
			if tick() - ZQ5.lastEquip < 0.25 then
				return
			end
			-- not while blocking: re-equipping drops block at once and locks it out for seconds
			-- (blocktest_lli phase B); Buso re-equips too
			if tick() < (ZQ5.blockHoldUntil or 0) or (Character and Character:FindFirstChild("Blocking")) then
				return
			end
			ZQ5.lastEquip = tick()
			ZQ5.m1type = equipattacktool()
			Buso(true)
		end

		-- m1Attack keeps its signature: (enemy, safeHeightOffset, attackRadius, offset3D, Type)
		-- offset3D is the hover offset in the enemy's space; attackRadius <= 0 means
		-- "hover only, do not swing" (the low-health hide-above call).
		function m1Attack(enemy, safeHeightOffset, attackRadius, offset3D, Type)
			attackRadius = attackRadius or 30
			offset3D = offset3D or Vector3.new(0, 5, 0)
			-- hover this high over every mob (ZephyronCombat.HoverHeight, 11 by default -- was 8; user,
			-- 2026-10-26); offsets with no height
			-- (Blugori's side offset) stay as they are. combatRange grows with it (height + 6).
			-- NORMAL MOBS 9 (user 2026-11-04, on trial; ZephyronCombat.NormalHoverHeight): 11 up + 3 behind is 11.4
			-- from the mob's root, past the 11-stud M1 reach -- 19% of all swings were "far" misses. 9 up + 3
			-- behind = 9.5. Bosses keep HoverHeight (11): HPScaled / a Boss child / the named ones with their
			-- own hover rule above.
			local isBlugori = enemy and (enemy:GetAttribute("RealName") == "Blugori" or enemy:GetAttribute("Blugori"))
			if offset3D.Y > 0 and not isBlugori then -- (Blugori keeps its own 5 up, 15 out)
				local rn = enemy and (enemy:GetAttribute("RealName") or enemy.Name) or ""
				local isBossMob = enemy ~= nil and (enemy:GetAttribute("HPScaled") ~= nil or enemy:FindFirstChild("Boss") ~= nil
					or string.find(enemy.Name, "Vera", 1, true) ~= nil or rn == "Elo The Bunny" or rn == "Cupid Queen"
					or rn == "Kelvin, The Nutcracker" or rn == "Demon Jester")
				local height = isBossMob and (CFG.HoverHeight or 11) or (CFG.NormalHoverHeight or 9)
				offset3D = Vector3.new(offset3D.X, math.max(offset3D.Y, height), offset3D.Z)
			end

			if not enemy or not enemy:FindFirstChild("HumanoidRootPart") then
				return false
			end
			local function why(reason)
				-- (was Vera-only: the Floor 5 first-fight stood there taking hits -- no swings,
				-- no hover -- and every refusal on a normal mob was silent. Log them all,
				-- throttled, so the next one names its reason, user 2026-10-30)
				if tick() - (ZQ5.lastWhy or 0) > 3 then
					ZQ5.lastWhy = tick()
					print("[m1Attack] refused on " .. enemy.Name .. ": " .. reason)
				end
				return false
			end
			if ZQ5.inCutscene() then
				return why("cutscene")
			end
			if MovementSystem:IsLocked() or EloAnims then
				return why("movement locked / elo anim")
			end
			local enemyHumanoid = enemy:FindFirstChild("Humanoid")
			if not enemyHumanoid or enemyHumanoid.Health <= 0 then
				return why("no humanoid / dead")
			end
			if not Character or not PlayerHumpart or not CanFarm then
				return why("no character / CanFarm off")
			end

			upkeep()

			-- ragdolled for more than 4s: sit right on it
			local enemyId = enemy.Name .. tostring(enemy:GetDebugId())
			if isRagdolled(enemy) then
				if not ragdollTimers[enemyId] then
					ragdollTimers[enemyId] = tick()
				end
				if tick() - ragdollTimers[enemyId] > 4 then
					offset3D = Vector3.new(0, 0, 0)
				end
			else
				ragdollTimers[enemyId] = nil
			end

			if isUnderTrap(PlayerHumpart.Position, 15) then
				local safePos = findSafePositionFromTrap(PlayerHumpart.Position)
				tweenWithTeleport(safePos, Speed)
				task.wait(0.5)
				return why("under a FallingTrap hitbox, moved to safe position")
			end

			MovementSystem:CancelInSpawn()

			-- an anticheat notice used to block here until it cleared. Floating after a walk
			-- earns a flight-strike notice that never clears while floating -> no hover, ever.
			-- The pad hover is grounded, so just engage.

			ZQ5.enemy = enemy
			ZQ5.offset = offset3D
			ZQ5.radius = attackRadius
			ZQ5.attack = attackRadius > 0
			ZQ5.hover = true
			ZQ5.lease = tick()
			return true
		end

		-- m1AttackSimple: swing only, no hover (Kramprus); only inside attackRadius
		function m1AttackSimple(enemy, attackRadius)
			attackRadius = attackRadius or 30
			if not enemy or not enemy:FindFirstChild("HumanoidRootPart") then
				return false
			end
			local enemyHumanoid = enemy:FindFirstChild("Humanoid")
			if not enemyHumanoid or enemyHumanoid.Health <= 0 then
				return false
			end
			if not Character or not PlayerHumpart or not CanFarm then
				return false
			end
			if (PlayerHumpart.Position - enemy.HumanoidRootPart.Position).Magnitude > attackRadius then
				return false
			end

			upkeep()

			if isUnderTrap(PlayerHumpart.Position, 15) then
				local safePos = findSafePositionFromTrap(PlayerHumpart.Position)
				tweenWithTeleport(safePos, Speed)
				task.wait(0.5)
				return false
			end

			ZQ5.enemy = enemy
			ZQ5.offset = Vector3.zero
			ZQ5.radius = attackRadius
			ZQ5.attack = true
			ZQ5.hover = false
			ZQ5.lease = tick()
			return true
		end
	end


