	-- FLOOR TIMER ANTI-STUCK (user 2026-11-01): the game's own per-floor timers (PlayerGui.ImpelDownUI.Info.Timers,
	-- one "Floor N: <name>" frame each, Inner.Time "MM:SS"). The highest floor's timer is the one running; if it
	-- reaches ZephyronCombat.FloorStuckMinutes (15) while still ticking, we're stuck on that floor: rejoin the main
	-- menu (the same teleport the auto-reconnect uses), retried every 5s. Logged to workspaceloor_stuck_<name>.txt.
	if game.PlaceId == 11424731604 and not getgenv().ImpelFloorTimerWatch then
		getgenv().ImpelFloorTimerWatch = true
		task.spawn(function()
			local function secs(t)
				local h, m, sec = string.match(t, "^%s*(%d+):(%d+):(%d+)%s*$")
				if h then
					return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec)
				end
				m, sec = string.match(t, "^%s*(%d+):(%d+)%s*$")
				return m and (tonumber(m) * 60 + tonumber(sec)) or nil
			end
			local lastFloor, lastSecs, lastChange = nil, nil, tick()
			local going = false
			while task.wait(5) do
				pcall(function()
					if going then
						return
					end
					local ui = LocalPlayer.PlayerGui:FindFirstChild("ImpelDownUI")
					local timers = ui and ui:FindFirstChild("Info") and ui.Info:FindFirstChild("Timers")
					if not timers then
						return
					end
					local floorN, label, name
					for _, f in ipairs(timers:GetChildren()) do
						local n = tonumber(string.match(f.Name, "^Floor (%d+)"))
						local tl = n and f:FindFirstChild("Inner") and f.Inner:FindFirstChild("Time")
						if tl and (not floorN or n > floorN) then
							floorN, label, name = n, tl, f.Name
						end
					end
					local v = label and secs(tostring(label.Text))
					if not v then
						return
					end
					-- only a timer that's running counts (a frozen one = a floor that's over)
					if floorN ~= lastFloor or v ~= lastSecs then
						lastChange = tick()
					end
					lastFloor, lastSecs = floorN, v
					local limit = (tonumber((getgenv().ZephyronCombat or {}).FloorStuckMinutes) or 15) * 60
					if v >= limit and tick() - lastChange < 30 then
						going = true
						local msg = string.format("[STUCK] %s timer at %s (limit %d min) - stuck on this floor, rejoining the main menu", name, tostring(label.Text), limit / 60)
						print(msg)
						pcall(function()
							appendfile("floor_stuck_" .. LocalPlayer.Name .. ".txt", os.date("%Y-%m-%d %H:%M:%S") .. " " .. msg .. string.char(10))
						end)
						task.spawn(function()
							task.wait(2)
							while true do
								pcall(function()
									game:GetService("TeleportService"):Teleport(1730877806, LocalPlayer)
								end)
								task.wait(5)
							end
						end)
					end
				end)
			end
		end)
	end

