		end
		return true, nil
	end

	local function isPositionInsidePart(position)
		local params = getRayParams()
		local testDirs = {
			Vector3.new(1, 0, 0),
			Vector3.new(-1, 0, 0),
			Vector3.new(0, 1, 0),
			Vector3.new(0, -1, 0),
			Vector3.new(0, 0, 1),
			Vector3.new(0, 0, -1),
		}
		local closeHits = 0
		for _, dir in ipairs(testDirs) do
			local result = workspace:Raycast(position, dir * 3, params)
			if result and result.Distance < 3 then
				closeHits = closeHits + 1
			end
		end
		if closeHits >= 3 then
			return true
		end
		for i = 1, 5, 2 do
			local r1 = workspace:Raycast(position, testDirs[i] * 5, params)
			local r2 = workspace:Raycast(position, testDirs[i + 1] * 5, params)
			if r1 and r2 and r1.Distance < 5 and r2.Distance < 5 then
				return true
			end
		end
		return false
	end

	local function getValidMovementPosition(fromPos, toPos, margin)
		margin = margin or 2.5
		local clear, hitResult = isPathClear(fromPos, toPos)
		if clear then
			if isPositionInsidePart(toPos) then
				local dir = (toPos - fromPos).Unit
				local pullback = toPos - dir * margin
				if isPositionInsidePart(pullback) then
					return fromPos, true
				end
				return pullback, true
			end
			return toPos, false
		end
		local hitPos = hitResult.Position
		local hitNormal = hitResult.Normal
		local safePos = hitPos + hitNormal * margin
		if isPositionInsidePart(safePos) then
			local dir = (toPos - fromPos).Unit
			safePos = hitPos - dir * margin
			if isPositionInsidePart(safePos) then
				return fromPos, true
			end
		end
		return safePos, true
	end

	local function findSafeAttackPosition(enemyPos, enemyCFrame, preferredOffset, attackRadius)
		attackRadius = attackRadius or 30
		local playerPos = PlayerHumpart.Position
		local preferredPos = (enemyCFrame * CFrame.new(preferredOffset.X, preferredOffset.Y, preferredOffset.Z)).Position
		if not isPositionInsidePart(preferredPos) then
			local clear, _ = isPathClear(playerPos, preferredPos)
			if clear then
				return preferredPos
			end
		end
		local testDistances = { 8, 12, 6, 15, 4 }
		local testAngles = { 0, 45, 90, 135, 180, 225, 270, 315 }
		local yOffsets = { preferredOffset.Y, preferredOffset.Y + 3, preferredOffset.Y - 3, 8, 5, 3, 10 }
		for _, yOff in ipairs(yOffsets) do
			for _, dist in ipairs(testDistances) do
				for _, angle in ipairs(testAngles) do
					local rad = math.rad(angle)
					local testPos = enemyPos + Vector3.new(math.cos(rad) * dist, yOff, math.sin(rad) * dist)
					if not isPositionInsidePart(testPos) then
						local clear, _ = isPathClear(playerPos, testPos)
						if clear and (testPos - enemyPos).Magnitude < attackRadius then
							return testPos
						end
					end
				end
			end
		end
		local retreatDir = (playerPos - enemyPos)
		retreatDir = retreatDir.Magnitude > 0.1 and retreatDir.Unit or Vector3.new(1, 0, 0)
		for _, dist in ipairs({ 10, 15, 20, 8, 5 }) do
			for _, yOff in ipairs(yOffsets) do
				local testPos = enemyPos + retreatDir * dist + Vector3.new(0, yOff, 0)
				if not isPositionInsidePart(testPos) then
					local clear, _ = isPathClear(playerPos, testPos)
					if clear and (testPos - enemyPos).Magnitude < attackRadius then
						return testPos
					end
				end
			end
		end
		return nil
	end

	local function findFallbackPosition(enemyPos)
		local abovePos = Vector3.new(enemyPos.X, selected_Offset or (enemyPos.Y + 50), enemyPos.Z)
		if not isPositionInsidePart(abovePos) then
			return abovePos, "offset"
		end
		if currentTargetPosition and typeof(currentTargetPosition) == "Vector3" then
			local floorPos = currentTargetPosition + Vector3.new(0, 10, 0)
			if not isPositionInsidePart(floorPos) then
				return floorPos, "floor"
			end
		end
		local highPos = Vector3.new(enemyPos.X, enemyPos.Y + 80, enemyPos.Z)
		if not isPositionInsidePart(highPos) then
			return highPos, "high"
		end
		return abovePos, "offset"
	end


	--==========================================================================
	-- QUEST5 MOVEMENT CORE
	-- quest5's straightLineTween, ported: the character is moved every render
	-- frame (before the camera script) at a constant speed, drift from water or
	-- physics is snapped back after physics, and the camera is never allowed to
	-- get further from the character than when the move began. Zephyron keeps
	-- its own wall guard (getValidMovementPosition) as an optional per-frame clamp.
	-- ZQ5.moving pauses the hover engine while a move is running.
	--==========================================================================
	ZQ5 = ZQ5 or {}
	ZQ5.moving = false
	ZQ5.hoverActive = false

	-- HEAD JAILER SLASH LOGGER (user 2026-10-28, for a sidestep dodge): during a Head Jailer fight, logs to
	-- workspace\jailer_slash_<name>.txt: (1) each animation he plays -- id, length, his facing vs the
	-- direction to us, our distance; (2) each effect (RaiuMove2 = his FLYING SLASH, RaiuMove1 = his other
	-- move (user 2026-10-28), "_") -- spawn time, size,
	-- then its position every frame for up to 2s: speed, travel direction vs the line to us, lifetime, and
	-- how close it came to us. Read-only; only runs while a Head Jailer is alive within 250 studs.
	-- (OFF since 2026-11-07, performance: every-frame tracking during his fight, for a study that's done.
	-- ZephyronCombat.JailerLog = true brings it back.)
	task.spawn(function()
		if (getgenv().ZephyronCombat or {}).JailerLog ~= true then
			return
		end
		local fname = "jailer_slash_" .. LocalPlayer.Name .. ".txt"
		local function log(line)
			HauLog(fname, string.format("%.2f ", tick() % 10000) .. line) -- (append, see HauLog)
		end
		local hooked = setmetatable({}, { __mode = "k" })
		local seen = setmetatable({}, { __mode = "k" })
		local function jailer()
			local folder = workspace:FindFirstChild("NPCs")
			for _, n in ipairs(folder and folder:GetChildren() or {}) do
				local h = n:FindFirstChildOfClass("Humanoid")
				local r = n:FindFirstChild("HumanoidRootPart")
				if n:FindFirstChild("RaiuiSword") and h and h.Health > 0 and r and PlayerHumpart
					and (r.Position - PlayerHumpart.Position).Magnitude <= 250 then
					return n, r
				end
			end
			return nil
		end
		local function facingInfo(r)
			if not PlayerHumpart then
				return "?"
			end
			local to = PlayerHumpart.Position - r.Position
			local flat = Vector3.new(to.X, 0, to.Z)
			local lv = r.CFrame.LookVector
			local ang = flat.Magnitude > 0.1 and math.deg(math.acos(math.clamp(Vector3.new(lv.X, 0, lv.Z).Unit:Dot(flat.Unit), -1, 1))) or 0
			return string.format("faces %.0f deg off us, dist %.1f, dy %.1f", ang, to.Magnitude, to.Y)
		end
		local function track(part)
			if seen[part] then
				return
			end
			seen[part] = true
			local npc, r = jailer()
			if not npc then
				return
			end
			local t0 = tick()
			local p0 = part:IsA("BasePart") and part.Position or (part:IsA("Model") and part:GetPivot().Position) or nil
			if not p0 then
				return
			end
			local size = part:IsA("BasePart") and tostring(part.Size) or (part:IsA("Model") and tostring(part:GetExtentsSize()) or "?")
			local me0 = PlayerHumpart and PlayerHumpart.Position
			local label = part.Name:match("^RaiuMove2") and " [FLYING SLASH]" or (part.Name:match("^RaiuMove1") and " [other move]" or "")
			log(string.format("FX %s%s (%s) spawned, size %s, %.1f from him, %.1f from us | him: %s", part.Name, label, part.ClassName,
				size, (p0 - r.Position).Magnitude, me0 and (p0 - me0).Magnitude or -1, facingInfo(r)))
			local last, closest, closestAt = p0, math.huge, 0
			while part.Parent and tick() - t0 < 2 do
				task.wait()
				local p = part:IsA("BasePart") and part.Position or part:GetPivot().Position
				last = p
				if PlayerHumpart then
					local d = (p - PlayerHumpart.Position).Magnitude
					if d < closest then
						closest, closestAt = d, tick() - t0
					end
				end
			end
			local dt = tick() - t0
			local move = last - p0
			local dirInfo = "?"
			if me0 and move.Magnitude > 0.5 then
				local toMe = Vector3.new(me0.X - p0.X, 0, me0.Z - p0.Z)
				local mv = Vector3.new(move.X, 0, move.Z)
				if toMe.Magnitude > 0.1 and mv.Magnitude > 0.1 then
					dirInfo = string.format("%.0f deg off the line to where we were", math.deg(math.acos(math.clamp(mv.Unit:Dot(toMe.Unit), -1, 1))))
				end
			end
			log(string.format("FX %s: lived %.2fs%s, moved %.1f studs (%.0f studs/s), travel %s, closest to us %.1f at +%.2fs",
				part.Name, dt, part.Parent and "+" or "", move.Magnitude, move.Magnitude / math.max(dt, 0.01), dirInfo, closest, closestAt))
		end
		while true do
			task.wait(0.5)
			pcall(function()
				local npc, r = jailer()
				if not npc then
					return
				end
				local hum = npc:FindFirstChildOfClass("Humanoid")
				local an = hum and hum:FindFirstChildOfClass("Animator")
				if an and not hooked[an] then
					hooked[an] = true
					log("---- Head Jailer fight, logging his moves and slash effects")
					an.AnimationPlayed:Connect(function(track)
						pcall(function()
							local id = string.match(tostring(track.Animation and track.Animation.AnimationId), "%d+") or "?"
							task.wait()
							local jr = npc:FindFirstChild("HumanoidRootPart")
							log(string.format("ANIM %s (%s, %.2fs%s) | him: %s", id, tostring(track.Name), track.Length,
								track.Looped and ", looped" or "", jr and facingInfo(jr) or "?"))
						end)
					end)
				end
				local fx = workspace:FindFirstChild("Effects")
				if fx and not hooked[fx] then
					hooked[fx] = true
					fx.DescendantAdded:Connect(function(d)
						if (d:IsA("BasePart") and string.match(d.Name, "^RaiuMove[12]")) or (d.Name == "_" and d.Parent == fx) then
							task.spawn(pcall, track, d)
						end
					end)
				end
			end)
		end
	end)

	-- CUTSCENE (user 2026-10-27: TP Check at the Vera fight right after her cutscene started -- the hover
	-- engaged her from 93 studs while the game held us in place, the server snapped us back 4x). The camera
	-- leaves Custom during a cutscene; we stay put until it's back, plus 1.5s.
	function ZQ5.inCutscene()
		local cam = workspace.CurrentCamera
		if cam and cam.CameraType ~= Enum.CameraType.Custom then
			ZQ5.cutsceneAt = tick()
