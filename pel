	function countLiveNpcs()
		local n = 0
		local folder = workspace:FindFirstChild("NPCs")
		for _, npc in ipairs(folder and folder:GetChildren() or {}) do
			if not npc:GetAttribute("ImpelIgnore") then
				n += 1
			end
		end
		return n
