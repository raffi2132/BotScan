		elseif idx < reached then
			out = ThirdFloor[route[reached]].Position
		elseif idx > reached + 1 then
			out = ThirdFloor[route[reached + 1]].Position
		end
		if out ~= pos then
			local key = tostring(idx) .. ">" .. tostring(reached)
			if ZQ5.f3ClampSaid ~= key then
				ZQ5.f3ClampSaid = key
				print(string.format("[FLOOR3] target %s held to %s (furthest reached: %s)", idx and route[idx] or "floor start",
