-- DeadNPCs...). Game-script errors from this are expected and fine (user 2026-11-07); an error with NO script (an
-- executor error) right after a deletion turns it off. [FX] line each minute with the counts. ZephyronCombat.DeleteFx2 =
-- false: off.
do
	task.spawn(function()
		pcall(function()
			if (getgenv().ZephyronCombat or {}).DeleteFx2 == false then
				return
			end
			local NAMES = {
				Snowball = true, BoltPart = true, RedMesh = true, WhiteMesh = true, WhiteMesh2 = true, AfterImageClone = true,
				Jab = true, gun = true, exploson = true, Gift = true, Reindeer = true, spike = true, sorun = true, Debris = true,
				Slash = true, Trail = true, dust = true, spawnParticle = true,
			}
			local function keepIt(c)
				if c:IsA("Folder") then
					return true
				end
				if c:FindFirstChild("Lock") or c:FindFirstChildWhichIsA("ProximityPrompt", true) or c:FindFirstChildWhichIsA("ClickDetector", true) then
					return true
				end
				local tick_ = c:FindFirstChild("NotificationTick", true)
				return tick_ ~= nil
			end
			local function kramprusAlive()
				local npcs = workspace:FindFirstChild("NPCs")
				for _, n in ipairs(npcs and npcs:GetChildren() or {}) do
					local rn = string.lower(tostring(n:GetAttribute("RealName") or n.Name))
					if string.find(rn, "kramp", 1, true) then
						local h = n:FindFirstChildOfClass("Humanoid")
						if h and h.Health > 0 then
							return true
						end
					end
				end
				return false
			end
			local function wanted(c)
				if NAMES[c.Name] then
					return true
				end
				if c.Name == "Part" and c:IsA("BasePart") then -- Santa's (7 emitters + a light)
					local emit, light = 0, false
					for _, d in ipairs(c:GetChildren()) do
						if d:IsA("ParticleEmitter") then
							emit = emit + 1
						elseif d:IsA("Light") then
							light = true
						end
					end
					return emit >= 5 and light
				end
				if c.Name == "Model" and c:IsA("Model") then -- Kramprus's, only while he's alive
					return kramprusAlive()
				end
				return false
			end
			local lastDelete, off, deleted, gameErrs = 0, false, {}, 0
			game:GetService("ScriptContext").Error:Connect(function(msg, _, scr)
				pcall(function()
					if os.clock() - lastDelete < 1 then
						if scr == nil and not off then
							off = true
							print("[FX] an error with no script right after a deletion - effect deleting turned OFF: " .. string.sub(tostring(msg), 1, 160))
						elseif scr ~= nil then
							gameErrs = gameErrs + 1
						end
					end
				end)
			end)
			local fx = workspace:WaitForChild("Effects", 300)
			if not fx then
				return
			end
			fx.ChildAdded:Connect(function(c)
				if off then
					return
				end
				-- (one frame later: its children -- emitters, light, prompt -- are in by then)
				task.defer(function()
					pcall(function()
						if off or not c.Parent or keepIt(c) or not wanted(c) then
							return
						end
						lastDelete = os.clock()
						local name = c.Name
						c:Destroy()
						deleted[name] = (deleted[name] or 0) + 1
					end)
				end)
			end)
			while not off do
				task.wait(60)
				pcall(function()
					local parts, total = {}, 0
					for name, n in pairs(deleted) do
						parts[#parts + 1] = name .. " " .. n
						total = total + n
					end
					if total > 0 then
						print(string.format("[FX] deleted %d effects in the last minute (%s) | game-script errors right after: %d",
							total, table.concat(parts, ", "), gameErrs))
					end
					deleted, gameErrs = {}, 0
				end)
			end
		end)
	end)
end

