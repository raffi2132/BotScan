		--              and from the 11-stud hover (verified live 2026-10-25)
		--   Laser Pulsar: Skill("Laser Pulsar", { cf = aim }) -> a remote; 1s charge; remote:FireServer(aim)
		-- (no faceMouse after it -- see below). ZephyronCombat.MeleeBreaker = false: off.
		local breakerReadyAt = 0
		local function breakerSkill()
			local style = ""
			pcall(function()
				style = tostring(RS["Stats" .. LocalPlayer.Name].Stats.FightingStyle.Value)
			end)
			if style == "Cyborg" then
				return "Laser Pulsar", 14 + 1, 30
			elseif style == "" or style == "Basic Combat" or style == "Melee" then
				return "Gut Punch", 15 + 1, 10
			end
			return nil
		end
		local function tryBreaker(mob)
			-- (BOTH modes now, user 2026-10-31 -- was Normal only)
			if CFG.MeleeBreaker == false or tick() < breakerReadyAt then
				return false
			end
			if not (isValidMob(mob) and isBossMob(mob) and targetBlocking(mob)) then
				return false
			end
			local name, cd, stam = breakerSkill()
			if not name or stamina() < stam + STAM_RESERVE or checkAnticheatNotifications() then
				return false
			end
			-- (wyverncinder4's safety, user 2026-10-31: every server call with its invokeWithTimeout -- SkillInvokeTimeout 10s
			-- -- a call that never comes back used to leave ZQ5.casting on and hold every M1 / skill; and its stale-laser
			-- cleanup -- a Laser Pulsar remote not released within 10s is closed with remote:FireServer(root).)
			local function invokeT(remote, timeout, ...)
				local args = { ... }
				local finished, success, response = false, false, nil
				task.spawn(function()
					local ok, result = pcall(function()
						return remote:InvokeServer(table.unpack(args))
					end)
					success, response, finished = ok, result, true
				end)
				local waited = 0
				while not finished and waited < timeout do
					task.wait(0.1)
					waited += 0.1
				end
				if not finished then
					return false, "timeout"
				end
				return success, response
			end
			local TIMEOUT = tonumber(CFG.SkillInvokeTimeout) or 10
			ZQ5.casting = true
			local done, took = pcall(function()
				if name == "Gut Punch" then
					invokeT(RS.Events.StamRequest, TIMEOUT, "Gut Punch")
					task.spawn(pcall, function()
						RS.Events.CombatRegister:InvokeServer({ "swingsfx", "Melee", true })
					end)
					local okS, why = invokeT(RS.Events.Skill, TIMEOUT, "Gut Punch", { Target = mob })
					if not okS then
						error("Gut Punch " .. tostring(why))
					end
					return true
				end
				local okL, remote = invokeT(RS.Events.Skill, TIMEOUT, "Laser Pulsar", { cf = aimCF(mob) })
				if not okL then
					error("Laser Pulsar " .. tostring(remote))
				end
