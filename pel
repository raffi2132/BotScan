-- EFFECT SOUNDS UNLOADED (user 2026-11-07, phone crashes on the teleport / requeue after a clear): the game loads
-- its ReplicatedStorage effect sounds into memory -- on 2 of 3 PC clients 1,300 MB of "Sounds" (1,500-1,700 of
-- them, ~2 hours of audio), 3 GB total. Clearing their SoundId freed it on Vesonugoni: Sounds 1,302 -> 235 MB,
-- total 2,952 -> 2,214 MB, farming on as before (FastMode mutes them anyway). Client-side only (a local copy).
-- workspace sounds (the Floor 3 NotificationTick markers) are not touched. ZephyronCombat.KeepSounds = true: off.
-- (2026-11-07) BEFORE the game:IsLoaded() wait: run after it, the game had already loaded the ~1.1 GB during its
-- own load -- on top of the teleport's memory peak. Now each sound is cleared as it arrives.
do
	pcall(function()
		if (getgenv().ZephyronCombat or {}).KeepSounds == true then
			return
		end
		local RSs = game:GetService("ReplicatedStorage")
		local function unload(d)
			if d:IsA("Sound") and d.SoundId ~= "" then
				pcall(function()
					d:Stop()
					d.SoundId = ""
				end)
			end
		end
		task.spawn(function()
			for i, d in ipairs(RSs:GetDescendants()) do
				if i % 2000 == 0 then
					task.wait() -- (chunked: one-frame scans have crashed the client)
				end
				unload(d)
			end
		end)
		if getgenv().__HauSoundConn then
			pcall(function()
				getgenv().__HauSoundConn:Disconnect()
			end)
		end
		getgenv().__HauSoundConn = RSs.DescendantAdded:Connect(function(d)
			unload(d)
		end)
	end)
end

