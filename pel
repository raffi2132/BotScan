			if not game:IsLoaded() then
				game.Loaded:Wait()
			end
			local frames, added = 0, 0
			game:GetService("RunService").Heartbeat:Connect(function()
				frames = frames + 1
			end)
			local fx = workspace:WaitForChild("Effects", 120)
			if fx then
				fx.DescendantAdded:Connect(function()
					added = added + 1
				end)
			end
			local t0 = os.clock()
			while true do
				task.wait(2)
				local now = os.clock()
				local dt = math.max(now - t0, 0.001)
				local fps, rate = frames / dt, added / dt
				frames, added, t0 = 0, 0, now
				pcall(function()
					local tgt = Npc
					local boss = tgt ~= nil and tgt.Parent ~= nil
						and (tgt:GetAttribute("HPScaled") ~= nil or string.find(tgt.Name, "Vera", 1, true) ~= nil)
					if fps < 15 or boss then
						print(string.format("[PERF] fps %.0f | effects spawned %.0f/s | in Effects %d | lua %.0f MB | target %s",
							fps, rate, fx and #fx:GetChildren() or -1, collectgarbage("count") / 1024,
							tostring(tgt and (tgt:GetAttribute("RealName") or tgt.Name))))
					end
				end)
			end
		end)
	end)
end

