		-- (HOVER GRACE removed, user 2026-10-28: it held us mid-air after a kill. Now when the mob dies the
		-- hover lets go at once and the next mob, if any, is flown to.)
		-- FALLING SPIKE TRAPS while fighting (user 2026-10-28, Floor 5; read on Watduhellbruvv): each FallingTrap
		-- is a "Primary" bar (~59.5 x 5.5, ~60 studs up) with a row of 2x2 spikes along it that drop straight
		-- down -- no "Hitbox" part, so isUnderTrap never saw them (and it only searched Effects.Environment,
		-- while isUnderTrap itself moves the traps into Islands). The walker's trap handling is left alone (it
		-- walks through on purpose); this only moves the FIGHT hover spot: inside a bar's column (+3 margin)
		-- -> beside it (5 past the bar's edge, on our side) and 4 lower, still in M1 reach.
		-- ZephyronCombat.SpikeAvoid = false: off.
		local spikeBars, spikeBarsAt = {}, 0
		local function spikeShift(p)
			if CFG.SpikeAvoid == false then
				return nil
			end
			if tick() - spikeBarsAt > 2 then
				spikeBarsAt = tick()
				spikeBars = {}
				for _, root in ipairs({ workspace:FindFirstChild("Islands"),
					workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("Environment") }) do
					for _, t in ipairs(root and root:GetChildren() or {}) do
						local bar = t.Name == "FallingTrap" and (t:FindFirstChild("Hitbox") or t.PrimaryPart or t:FindFirstChild("Primary", true)) -- (the "Hitbox" part, 42 x 42 x 78; "Primary" is inside "Log", never a direct child -- no trap was ever found, user 2026-11-01)
						if bar and bar:IsA("BasePart") then
							spikeBars[#spikeBars + 1] = bar
						end
					end
				end
			end
			for _, bar in ipairs(spikeBars) do
				if bar.Parent and p.Y < bar.Position.Y + bar.Size.Y / 2 + 10 and p.Y > bar.Position.Y - 150 then
					local lp = bar.CFrame:PointToObjectSpace(p)
					local halfL, halfW = bar.Size.X / 2 + 3, bar.Size.Z / 2 + 3
					if math.abs(lp.X) <= halfL and math.abs(lp.Z) <= halfW then
						-- only onto a spot with GROUND under it (user 2026-10-28: there's a bridge through the traps --
						-- never park us over the void beside it): our side first, then the other, else stay
						local first = lp.Z >= 0 and 1 or -1
						for _, side in ipairs({ first, -first }) do
							local out = bar.CFrame:PointToWorldSpace(Vector3.new(lp.X, lp.Y, side * (bar.Size.Z / 2 + 5)))
							local spot = Vector3.new(out.X, p.Y - 4, out.Z)
							local rp = RaycastParams.new()
							rp.FilterType = Enum.RaycastFilterType.Exclude
							rp.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects"), bar.Parent }
							local ground = workspace:Raycast(spot, Vector3.new(0, -40, 0), rp)
							if ground then
								if not ZQ5.spikeSaid or ZQ5.spikeSaid ~= bar then
									ZQ5.spikeSaid = bar
									print("[TRAP] hover spot under a falling spike trap - moved beside it")
								end
								return spot
							end
						end
						-- (user 2026-11-01) no ground on either side (the bar runs along the bridge): past the bar's nearer
						-- end instead, along it, 5 past the end -- still only onto ground
						local firstEnd = lp.X >= 0 and 1 or -1
						for _, e in ipairs({ firstEnd, -firstEnd }) do
							local out = bar.CFrame:PointToWorldSpace(Vector3.new(e * (bar.Size.X / 2 + 5), lp.Y, lp.Z))
							local spot = Vector3.new(out.X, p.Y - 4, out.Z)
							local rp = RaycastParams.new()
							rp.FilterType = Enum.RaycastFilterType.Exclude
							rp.FilterDescendantsInstances = { Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects"), bar.Parent }
							if workspace:Raycast(spot, Vector3.new(0, -40, 0), rp) then
								if ZQ5.spikeEndSaid ~= bar then
									ZQ5.spikeEndSaid = bar
									print("[TRAP] hover spot under a falling spike trap - no ground beside it, moved past its end")
								end
								return spot
							end
						end
						if ZQ5.spikeStaySaid ~= bar then
							ZQ5.spikeStaySaid = bar
							print("[TRAP] hover spot under a falling spike trap - no ground beside it, staying under it")
						end
						return nil -- no ground beside it: stay
					end
				end
			end
			return nil
		end
		local function zephyronHover(hrp, mob, mhrp, dt)
			ZQ5.vdodge = nil
			-- a fruit-user skill dodge still flying out (FRUIT-USER SKILL DODGE): that comes before the block stand
			local fd = ZQ5.fruitDodge
			local fruitFlying = fd ~= nil and fd.target ~= nil and not fd.arrived and tick() < (fd.untilT or 0)
				and not fd.blockMove -- (Pika's Jewels of Light: carried out on the block stand instead, see below)
			-- BLOCK STAND (tested on Llinaratostape 2026-10-27, blocktest3: a pad 6 up, PlatformStand off,
			-- the root CFrame pinned every frame held block 3.9s of 4; a velocity reset every frame dropped
			-- it at 1.8s, re-equipping the weapon dropped it at once). While a block hold runs: stand on a
			-- pad right where we are, CFrame-only pin, facing fixed at the start of the hold. No velocity
			-- writes, no following the boss. Back to the normal Zephyron hover when the hold ends.
			if tick() < (ZQ5.blockHoldUntil or 0) and tick() >= (ZQ5.jStepUntil or 0) and not fruitFlying
				and not (tick() < (ZQ5.iceAgeUntil or 0)) then -- (Hie's Ice Age: up to the stun spot, not the block stand)
				local hum = Character and Character:FindFirstChildOfClass("Humanoid")
				local pad = ZQ5.hoverPad
				if not (pad and pad.Parent) then
					pad = newHoverPad(hrp)
					local flat = Vector3.new(mhrp.Position.X, hrp.Position.Y, mhrp.Position.Z)
					ZQ5.blockStandRot = (flat - hrp.Position).Magnitude > 0.1
							and (CFrame.lookAt(hrp.Position, flat) - hrp.Position)
						or (hrp.CFrame - hrp.CFrame.Position)
				end
				if hum and hum.PlatformStand then
					hum.PlatformStand = false
				end
				-- an "above" rule (Blugori's spin): the pad carries us up to that spot while we block -- the
				-- pin stays CFrame-only, moving keeps block up
				if tick() < (ZQ5.aboveUntil or 0) and ZQ5.aboveMob == mob then
					local want = mhrp.Position + Vector3.new(0, (ZQ5.aboveH or 30) - HOVER_PAD_STAND, 0)
					local d = want - pad.Position
					if d.Magnitude > 0.05 then
						-- 30/s at most while blocking (user 2026-10-28: Blugori's first engage -- he was walking at us,
						-- the pad chased him at 50/s, blocking caps the allowance at ~37 -> the server snapped us back
						-- 74 studs, the hover let go, block dropped mid-air -> flight strike + the walker took over)
						local spd = math.min(CFG.ZephyronSpeed or 50, CFG.BlockMoveSpeed or 30)
						pad.Position = pad.Position + d.Unit * math.min(spd * (dt or 1 / 60), d.Magnitude)
					end
				elseif fd and fd.blockMove and fd.target and not fd.arrived then
					-- PIKA JEWELS OF LIGHT: BLOCK WHILE GOING AWAY (user 2026-11-01). The block stand's pad carries us
					-- to the dodge spot at BlockMoveSpeed (30/s, under the blocking allowance), CFrame-only pin like the
					-- Blugori spin, never into geometry; there / stuck 0.3s / 4s gone -> the stand stays put as before.
					local want = fd.target - Vector3.new(0, HOVER_PAD_STAND, 0)
					local d = want - pad.Position
					local moved = false
					if d.Magnitude > 0.05 then
						local spd = math.min(CFG.ZephyronSpeed or 50, CFG.BlockMoveSpeed or 30)
						local nextPad = pad.Position + d.Unit * math.min(spd * (dt or 1 / 60), d.Magnitude)
						local clear = true
						if ZQ5.zephOP then
							local ok, parts = pcall(function()
								return workspace:GetPartBoundsInBox(CFrame.new(nextPad + Vector3.new(0, HOVER_PAD_STAND, 0)), Vector3.new(3, 5.5, 3), ZQ5.zephOP)
							end)
							for _, part in ipairs(ok and parts or {}) do
								if part ~= pad then
									clear = false
									break
								end
							end
						end
						if clear then
							pad.Position = nextPad
							moved = true
						end
					end
					if moved then
						fd.stuckAt = nil
					else
						fd.stuckAt = fd.stuckAt or tick()
					end
					if d.Magnitude < 1 or (fd.stuckAt and tick() - fd.stuckAt > 0.3) or tick() - fd.startedAt > 4 then
						fd.arrived = true
						ZQ5.blockHoldUntil = math.max(ZQ5.blockHoldUntil or 0, fd.untilT)
						print(string.format("[DODGE] Jewels of Light: %s, blocking the whole way - holding block", d.Magnitude < 1 and "there" or "stopped short"))
					end
				elseif string.find(mob.Name, "Vera", 1, true) and CFG.VeraBlockFollow ~= false and not (fd and fd.arrived) then
					-- VERA BLOCK FOLLOW (user 2026-10-29): blocking on her keeps us on her normal hover spot -- her
					-- zephyronOffset (10 up, 3 behind; Venom Demon form 3 up, 9 behind), yaw only -- instead of standing
					-- still. The pad carries us at BlockMoveSpeed (30/s, the blocking allowance ~37) and never into
					-- geometry; the facing stays fixed (turning while blocking drew strikes). VeraBlockFollow = false: off.
					local o = zephyronOffset(mob)
					if mob:FindFirstChild("VenomDemonModel") then
						-- (user 2026-11-01) Venom Demon form: blocking / dodging her sits 10 up, 3 behind and follows her;
						-- the fight spot stays 0 up, 13 behind. ZephyronCombat.VeraDemonBlockOffset overrides.
						o = typeof(CFG.VeraDemonBlockOffset) == "Vector3" and CFG.VeraDemonBlockOffset or Vector3.new(0, 10, 3)
					end
					local lv = mhrp.CFrame.LookVector
					local spot = (CFrame.new(mhrp.Position) * CFrame.Angles(0, math.atan2(-lv.X, -lv.Z), 0) * CFrame.new(o.X, o.Y, o.Z)).Position
					local d = (spot - Vector3.new(0, HOVER_PAD_STAND, 0)) - pad.Position
					if d.Magnitude > 0.05 and spot.X == spot.X and spot.Y == spot.Y and spot.Z == spot.Z then
						local spd = math.min(CFG.ZephyronSpeed or 50, CFG.BlockMoveSpeed or 30)
						local nextPad = pad.Position + d.Unit * math.min(spd * (dt or 1 / 60), d.Magnitude)
						local clear = true
						if ZQ5.zephOP then
							local ok, parts = pcall(function()
								return workspace:GetPartBoundsInBox(CFrame.new(nextPad + Vector3.new(0, HOVER_PAD_STAND, 0)), Vector3.new(3, 5.5, 3), ZQ5.zephOP)
							end)
							for _, part in ipairs(ok and parts or {}) do
								if part ~= pad then
									clear = false
									break
								end
							end
						end
						if clear then
							pad.Position = nextPad
						end
					end
				end
				local standAt = pad.Position + Vector3.new(0, HOVER_PAD_STAND, 0)
				-- (user 2026-10-28: the face-the-boss turn / tilt while blocking is REVERTED -- blocking drew
				-- flight strikes with it, never before. Back to the facing fixed at the start of the hold.)
				-- (The Head Jailer "7 behind him" during his skills was removed the same day: he snaps to face
				-- us every frame, so his slash comes straight at us wherever we are -- the block is what works.)
				hrp.CFrame = CFrame.new(standAt) * (ZQ5.blockStandRot or (hrp.CFrame - hrp.CFrame.Position))
				ZQ5.lastPin = standAt
				return
			end
			hoverPadStop() -- no pad in this mode
			-- (KRAMPRUS: hovered 8 up like the other bosses now, user 2026-10-28 -- was Zephyron's ground fight)
			local hum = Character and Character:FindFirstChildOfClass("Humanoid")
			if hum and not hum.PlatformStand then
				hum.PlatformStand = true
			end
			ZQ5.zephPS = true
			for _, mover in ipairs(hrp:GetChildren()) do
				if mover:IsA("BodyMover") then
					mover:Destroy()
				end
			end
			local goal
			if tick() < (ZQ5.aboveUntil or 0) and ZQ5.aboveMob == mob then
				goal = mhrp.Position + Vector3.new(0, ZQ5.aboveH or 30, 0) -- a boss move rule (Blugori's spin)
				-- up there: block for the rest of the move (the block stand takes over next frame, on a pad)
				if ZQ5.aboveBlock and (goal - hrp.Position).Magnitude < 3 then
					ZQ5.blockHoldUntil = math.max(ZQ5.blockHoldUntil or 0, ZQ5.aboveUntil)
				end
			elseif fruitFlying then
				goal = fd.target -- a fruit-user skill dodge (Flame Pillar / Jewels of Light), any mob we're on
			elseif ZQ5.jStepTarget and ZQ5.jStepMob == mob and tick() < (ZQ5.jStepUntil or 0) then
				goal = ZQ5.jStepTarget -- the Head Jailer flying-slash sidestep (no block)
			elseif tick() < (ZQ5.iceAgeUntil or 0) then
				goal = mhrp.Position + Vector3.new(0, 20, 0) -- Hie's Ice Age: the stun spot (user 2026-10-31)
			elseif tick() < (ZQ5.stunUntil or 0) then
				goal = mhrp.Position + Vector3.new(0, 20, 0)
			else
				local o = zephyronOffset(mob)
				goal = (mhrp.CFrame * CFrame.new(o.X, o.Y, o.Z)).Position
			end
			if goal.X ~= goal.X or goal.Y ~= goal.Y or goal.Z ~= goal.Z then
				goal = mhrp.Position + Vector3.new(0, 8, 0)
			end
			if not (tick() < (ZQ5.aboveUntil or 0)) and not fruitFlying then
				goal = spikeShift(goal) or goal -- (never under a falling spike trap while fighting)
			end
			-- CLEAR SPOT (user 2026-10-27, Floor 4: mobs under a building's overhang put the hover spot inside
			-- the building -> noclip check). If the spot overlaps solid world geometry, try lower / higher and
			-- around the mob (left, right, front); the first clear one wins. Kept 0.5s so it doesn't flicker.
			local op = ZQ5.zephOP
			if not op then
				op = OverlapParams.new()
				op.FilterType = Enum.RaycastFilterType.Exclude
				pcall(function()
					op.RespectCanCollide = true
				end)
				ZQ5.zephOP = op
			end
			op.FilterDescendantsInstances = {
				Character, workspace:FindFirstChild("NPCs"), workspace:FindFirstChild("Effects"),
				workspace:FindFirstChild("PlayerCharacters"), ZQ5.hoverPad,
			}
			-- REAL SHAPE, not the bounding box (user 2026-11-01, Floor 4: a flat snow "Lump" MeshPart's box is 94 x 11 x
			-- 87, so every spot up to 10 over the mob standing on it read "inside something" and the hover jumped to
			-- 14 up -- out of M1 reach. Stairs the same). A reused invisible probe part (CanQuery / CanCollide /
			-- CanTouch off) and GetPartsInPart test the parts' real collision shapes. Bounding box only as a fallback.
			local function spotClear(p)
				local probe = ZQ5.zephProbe
				if not (probe and probe.Parent) then
					pcall(function()
						probe = Instance.new("Part")
						probe.Name = "ZQ5Probe"
						probe.Anchored, probe.CanCollide, probe.CanQuery, probe.CanTouch = true, false, false, false
						probe.Transparency = 1
						probe.Size = Vector3.new(3, 5.5, 3)
						probe.Parent = workspace
						ZQ5.zephProbe = probe
					end)
				end
				if probe and probe.Parent then
					local ok, parts = pcall(function()
						probe.CFrame = CFrame.new(p)
						return workspace:GetPartsInPart(probe, op)
					end)
					if ok then
						return #parts == 0
					end
				end
				local ok, parts = pcall(function()
					return workspace:GetPartBoundsInBox(CFrame.new(p), Vector3.new(3, 5.5, 3), op)
				end)
				return not ok or #parts == 0
			end
			if ZQ5.zephAltMob == mob and tick() < (ZQ5.zephAltUntil or 0) and ZQ5.zephAltOff then
				local a = ZQ5.zephAltOff
				goal = (mhrp.CFrame * CFrame.new(a.X, a.Y, a.Z)).Position
			elseif not fruitFlying and not spotClear(goal) and not (tick() < (ZQ5.aboveUntil or 0)) then
				local base = zephyronOffset(mob)
				-- (user 2026-11-01: ~11 up is the M1 reach limit -- the fallback never goes above HoverMaxUp (11) over the
				-- mob; the same height around it first, then lower. Was -3, +4, -6, +8: 14 / 18 up, out of reach.)
				local maxUp = tonumber(CFG.HoverMaxUp) or 11
				for _, dy in ipairs({ 0, -3, 1, -6 }) do
					local found
					for _, ang in ipairs({ 0, 90, -90, 180 }) do
						local o = CFrame.Angles(0, math.rad(ang), 0) * Vector3.new(base.X, math.min(base.Y + dy, maxUp), math.max(base.Z, 4))
						local g = (mhrp.CFrame * CFrame.new(o.X, o.Y, o.Z)).Position
						if spotClear(g) then
							found = o
							break
						end
					end
					if found then
						ZQ5.zephAltMob, ZQ5.zephAltOff, ZQ5.zephAltUntil = mob, found, tick() + 0.5
						goal = (mhrp.CFrame * CFrame.new(found.X, found.Y, found.Z)).Position
						if tick() - (ZQ5.zephAltLog or 0) > 5 then
							ZQ5.zephAltLog = tick()
							print(string.format("[HOVER] usual spot over %s is inside something, using %s instead", tostring(mob.Name), tostring(found)))
						end
						break
					end
				end
			end
			local cur = hrp.Position
			local d = goal - cur
			local newPos
			local stepping = (ZQ5.jStepTarget ~= nil and goal == ZQ5.jStepTarget) or fruitFlying
			if not stepping and Vector3.new(d.X, 0, d.Z).Magnitude <= 8 and d.Magnitude <= 8 and tick() - (ZQ5.zephSnapAt or 0) >= 3 then
				ZQ5.zephSnapAt = tick()
				newPos = goal
			elseif d.Magnitude > 1e-3 then
				-- (the sidestep moves at JailerStepSpeed, 40/s, never snaps)
				local spd = (fruitFlying and (CFG.FruitDodgeSpeed or 42)) or (stepping and (CFG.JailerStepSpeed or 40)) or (CFG.ZephyronSpeed or 50)
				newPos = cur + d.Unit * math.min(spd * (dt or 1 / 60), d.Magnitude)
			else
				newPos = cur
			end
			-- never step INTO geometry: if the next position overlaps something and where we are doesn't, hold
			if newPos ~= cur and not spotClear(newPos) and spotClear(cur) then
				newPos = cur
			end
			-- fruit dodge: there (or stuck 0.3s / 3s gone) -> block on a pad right here for the rest of it
			if fruitFlying then
				if newPos == cur then
					fd.stuckAt = fd.stuckAt or tick()
				else
