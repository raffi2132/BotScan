					local result = nil
					pcall(function()
						local statsFolder = getStatsFolder()
						if statsFolder and statsFolder:FindFirstChild("Stats") then
							local peli = statsFolder.Stats:FindFirstChild("Peli")
							if peli then
								result = peli.Value
