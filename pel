		local function inZone(zone, p, margin)
			local rel = zone.CFrame:PointToObjectSpace(p)
			local half = zone.Size / 2
			return math.abs(rel.X) <= half.X + margin and math.abs(rel.Y) <= half.Y + margin and math.abs(rel.Z) <= half.Z + margin
		end

		-- where the straight walk from `a` to `b` is inside `zone` (grown by `margin`): returns the
		-- distances along it at which it enters and leaves, or nil when it never touches the box.
		-- (A segment test in the zone's own space -- the "raycast" through the trap's hitbox.)
		local function segmentThrough(zone, a, b, margin)
			local la = zone.CFrame:PointToObjectSpace(a)
			local lb = zone.CFrame:PointToObjectSpace(b)
			local half = zone.Size / 2 + Vector3.new(margin, margin, margin)
			local d = lb - la
			local t0, t1 = 0, 1
			for _, axis in ipairs({ "X", "Y", "Z" }) do
				local p, dd, h = la[axis], d[axis], half[axis]
				if math.abs(dd) < 1e-6 then
					if math.abs(p) > h then
						return nil
					end
				else
					local ta, tb = (-h - p) / dd, (h - p) / dd
					if ta > tb then
						ta, tb = tb, ta
					end
					t0, t1 = math.max(t0, ta), math.min(t1, tb)
					if t0 > t1 then
						return nil
					end
				end
			end
			local len = (b - a).Magnitude
			return t0 * len, t1 * len
		end

		-- true = don't walk from `pos` toward `dest` yet. Looks along the WHOLE straight leg to the
		-- next waypoint (not just this frame's step): if it passes through a trap's box, we only go
		-- when the trap is out now AND stays out until we're through the box plus a latency margin
		-- (the emitters flip when the server's state reaches us, a beat after the damage does).
		-- A leg that starts inside a box keeps going (waiting there would be standing in it).
		-- TrapMargin: extra seconds of safety (default 0.6). TrapWait = false turns it off.
		ZQ5.trapBlocks = function(pos, nextPos, speed, dest)
			if CFG.TrapWait == false then
				return false
			end
			-- FLOOR 5: never wait (user 2026-10-27). Its falling spike traps sit in Traps too, and "waiting at
			-- the edge of the zone" parked us right under the spike -- it dropped again and again, big damage.
			-- Walk straight through instead.
			local isl = workspace:FindFirstChild("Islands")
			if isl and isl:FindFirstChild("Impel Base - Floor 5") then
				return false
			end
			local to = (dest or nextPos)
			if (to - pos).Magnitude < 0.05 then
				return false
			end
			local spd = math.max(speed or 40, 1)
			local safety = CFG.TrapMargin or 0.6
			local insideAny = false
			for _, t in pairs(traps) do
				if t.zone.Parent and inZone(t.zone, pos, 3) then
					insideAny = true
					break
				end
			end
			if insideAny then
				return false -- already in a box: walk on out of it, never hold in the flames
			end
			for model, t in pairs(traps) do
				if t.zone.Parent then
					local dIn, dOut = segmentThrough(t.zone, pos, to, 3)
					if dIn then
						if t.on or not t.seen then
							return true, model
						end
						local offLen = t.offDur or t.duration
						local left = offLen - (tick() - t.changedAt)
						-- time until we're clear of the box (+ the 2.5-stud margin already in the box)
						local need = dOut / spd + safety
						if left < need then
							return true, model
						end
					end
				end
			end
			return false
		end
		end)()

