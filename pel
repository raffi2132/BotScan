		["Dark Blade"] = 1100,
		["Hollow's Great Sword"] = 1000,
		["Kraken Blade"] = 100,
		["Vrael's Pipe"] = 90,
		["Golden Hook"] = 95,
		["Knight's Gauntlet"] = 85,
	}
	local WeaponsToFarm = {
		["Dark Blade"] = true,
