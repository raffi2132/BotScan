				local function where()
					local isl = workspace:FindFirstChild("Islands")
					local best
					for _, c in ipairs(isl and isl:GetChildren() or {}) do
						local n = tonumber(string.match(c.Name, "^Impel Base %- Floor (%d+)"))
						if n and (not best or n > best) then
							best = n
						end
					end
					if isl and isl:FindFirstChild("Impel Base - Finished") then
						return "Finished", nil
					end
					if best then
						return "Floor " .. best, best
					end
					local id = game.PlaceId
					if id == 1730877806 then
						return "Main menu", nil
					elseif id == 6360478118 then
						return "Universe Hub", nil
					elseif id == 11424731604 then
						return "Impel (start)", nil
					end
					return "Elsewhere", nil
				end
				local function floorTimer(n)
					local ui = lp.PlayerGui:FindFirstChild("ImpelDownUI")
					local timers = ui and ui:FindFirstChild("Info") and ui.Info:FindFirstChild("Timers")
					if not timers then
						return nil
					end
					local pick, pickN
					for _, f in ipairs(timers:GetChildren()) do
						local fn = tonumber(string.match(f.Name, "^Floor (%d+)"))
						if fn and (n == nil and (not pickN or fn > pickN) or fn == n) then
							pick, pickN = f, fn
						end
					end
					local tl = pick and pick:FindFirstChild("Inner") and pick.Inner:FindFirstChild("Time")
					return tl and tostring(tl.Text) or nil
				end

				-- STATUS (2026-11-07): what it's doing, from the fight state (Npc, ZQ5) -- read only
				local function statusText()
					local ch = lp.Character
					if ch and ch:FindFirstChild("Cuffed") then
						return "cuffed - getting the key"
					end
					local Z = ZQ5
					if Z and Z.goroHopFlying then
						return "Goro hop"
					end
					local tgt = Npc
					local th = tgt and tgt.Parent and tgt:FindFirstChildOfClass("Humanoid")
					if th and th.Health > 0 then
						local txt = string.format("fighting %s %d%%", tostring(tgt:GetAttribute("RealName") or tgt.Name),
							th.MaxHealth > 0 and math.floor(100 * th.Health / th.MaxHealth + 0.5) or 0)
						if Z and tick() < (Z.blockHoldUntil or 0) then
							txt = txt .. " (block)"
						end
						return txt
					end
					if Z and Z.reenter then
						return "stepping out of a zone and back in"
					end
					if Z and Z.moving then
						return "walking"
					end
					return "standing"
				end
				-- PROGRESS: the floor's barriers still shut vs the most seen shut on this floor (the game's own state;
				-- a barrier counts as shut while it's a solid, visible part). Floor 3 adds its route stage.
				local barMax, barFloor = {}, nil
				local function progressText(n)
					if n ~= barFloor then
						barMax, barFloor = {}, n
					end
					local isl = workspace:FindFirstChild("Islands")
					local fl = n and isl and isl:FindFirstChild("Impel Base - Floor " .. n)
					local b = fl and fl:FindFirstChild("Barriers")
					if not b then
						return "--"
					end
					local shut = 0
					for _, c in ipairs(b:GetChildren()) do
						local part = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
						if part and part.CanCollide and part.Transparency < 1 then
							shut = shut + 1
						end
					end
					barMax[n] = math.max(barMax[n] or 0, shut)
					local txt = string.format("%d/%d barriers open", barMax[n] - shut, barMax[n])
					if n == 3 and ZQ5 and ZQ5.F3_ROUTE then
						txt = txt .. string.format(" | stage %d/%d", ZQ5.f3Reached or 0, #ZQ5.F3_ROUTE)
					end
					return txt
				end
				local movedPos, movedAt = nil, os.clock()

				local mythical, lastMyth = "--", 0
				local lastT, lastFrames = os.clock(), 0
				local runStart, runFrozen, lastV1
				while gui.Parent do
					task.wait(0.5)
					pcall(function()
						local now = os.clock()
						local fps = (frames - lastFrames) / math.max(now - lastT, 0.001)
						lastT, lastFrames = now, frames
						rows.FPS.Text = string.format("FPS       %d", math.floor(fps + 0.5))
						rows.FPS.TextColor3 = fps >= 25 and Color3.fromRGB(120, 220, 140)
							or fps >= 15 and Color3.fromRGB(240, 200, 90)
							or Color3.fromRGB(235, 90, 80)

						-- the account's Impel points: Stats<name>.DungeonPoints["Impel Down"] (BattleReportGui only
						-- exists on the end-of-run screen -- used only if that stat isn't there)
						local pts = "--"
						local st = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. lp.Name)
						local dp = st and st:FindFirstChild("DungeonPoints")
						local iv = dp and dp:FindFirstChild("Impel Down")
						if iv then
							pts = tostring(iv.Value)
						else
							local br = lp.PlayerGui:FindFirstChild("BattleReportGui")
							if br and br:FindFirstChild("Points") then
								pts = tostring(br.Points.Text)
							end
						end
						-- thousands separators: 212000 -> 212,000 (user 2026-11-02)
						local num = tonumber((string.gsub(tostring(pts), ",", "")))
						if num then
							local str = tostring(math.floor(num))
							repeat
								local k
								str, k = string.gsub(str, "^(-?%d+)(%d%d%d)", "%1,%2")
							until k == 0
							pts = str
						end
						rows.Points.Text = "Points    " .. pts

						if now - lastMyth > 2 then
							lastMyth = now
							pcall(function()
								local st = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. lp.Name)
								local inv = st and st:FindFirstChild("Inventory") and st.Inventory:FindFirstChild("Inventory")
								if inv then
									local c = tonumber(string.match(tostring(inv.Value), '"Mythical Fruit Chest":(%d+)')) or 0
									-- (user 2026-11-02, Llinaratostape: 1 chest owned, the panel said 0) inside Impel the owned chest
									-- isn't in Inventory at all -- only its name in HotbarOrder, with no count: shown as 1+
									local hb = st.Inventory:FindFirstChild("HotbarOrder")
									if c == 0 and hb and string.find(tostring(hb.Value), '"Mythical Fruit Chest"', 1, true) then
										mythical = "1+/10"
									else
										mythical = c .. "/10"
									end
								end
							end)
						end
						rows.Mythical.Text = "Mythical  " .. mythical

						local w, n = where()
						-- (user 2026-11-02) one line, no labels: "Floor 1  02:23" (or "Main menu" / "Universe Hub")
						local tt = n and floorTimer(n)
						rows.Floor.Text = w .. (tt and ("  " .. tt) or "")

						-- the run's mode. The script itself only knows NM+ 110s into a run (no BackpackCleared by then);
						-- before that it's "checking". Outside Impel: --
						local mode = "--"
						local forced = string.lower(tostring((getgenv().ZephyronCombat or {}).Difficulty or ""))
						if forced == "nightmare+" then
							mode = "NM+"
						elseif forced == "normal" then
							mode = "Normal"
						elseif game.PlaceId == 11424731604 then
							if lp:GetAttribute("BackpackCleared") == true then
								mode = "Normal"
							elseif (workspace:GetAttribute("serverAge") or 0) >= 110 then
								mode = "NM+"
							else
								mode = "checking..."
							end
						end
						rows.Mode.Text = "Mode      " .. mode

						local lives = "--"
						local ls = lp:FindFirstChild("leaderstats")
						local lv = ls and ls:FindFirstChild("Lives")
						if lv then
							lives = tostring(lv.Value)
						end
						rows.Lives.Text = "Lives     " .. lives

						rows.Progress.Text = "Progress  " .. (n and progressText(n) or "--")
						rows.Status.Text = "Status    " .. statusText()
						local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
						if hrp and (not movedPos or (hrp.Position - movedPos).Magnitude > 8) then
							movedPos, movedAt = hrp.Position, now
						end
						local still = math.floor(now - movedAt)
						rows.Moved.Text = still < 3 and "Moved     now" or string.format("Moved     %d:%02d ago", still // 60, still % 60)
						rows.Moved.TextColor3 = still >= 90 and Color3.fromRGB(235, 90, 80)
							or still >= 30 and Color3.fromRGB(240, 200, 90) or Color3.fromRGB(235, 232, 245)
						rows.Last.Text = tostring(HauLastLine or "")

						-- TOTAL (user 2026-11-02): this run's time since the Floor 1 timer started (start = now - the
						-- Floor 1 timer's reading, fixed once known; a smaller reading later = a new run). Frozen at the
						-- finished base. Outside a run: --
						local function secs(t)
							local h, m, x = string.match(tostring(t or ""), "^%s*(%d+):(%d+):(%d+)%s*$")
							if h then
								return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(x)
							end
							m, x = string.match(tostring(t or ""), "^%s*(%d+):(%d+)%s*$")
							return m and (tonumber(m) * 60 + tonumber(x)) or nil
						end
						local v1 = secs(floorTimer(1))
						if v1 and v1 > 0 then
							if not runStart or (lastV1 and v1 < lastV1 - 5) then
								runStart, runFrozen = now - v1, nil
							end
							lastV1 = v1
						end
						if w == "Finished" and runStart and not runFrozen then
							runFrozen = now - runStart
						end
						local total = runFrozen or (runStart and game.PlaceId == 11424731604 and (now - runStart)) or nil
						if total then
							local t = math.floor(total)
							rows.Total.Text = "Total     "
								.. (t >= 3600 and string.format("%d:%02d:%02d", t // 3600, (t % 3600) // 60, t % 60) or string.format("%02d:%02d", t // 60, t % 60))
						else
							rows.Total.Text = "Total     --"
						end
						show3d()
					end)
				end
			end)
		end)
	end

	if misc.TrackStats then
		local TrackStatsApiKey = getgenv().Config and getgenv().Config.Misc and getgenv().Config.Misc.TrackStats

		if TrackStatsApiKey and TrackStatsApiKey ~= "" then
			local HttpService = game:GetService("HttpService")
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local Players = game:GetService("Players")
			local Player = Players.LocalPlayer

			local SEA_PLACES = {
				[3978370137] = 1,
				[6811831486] = 1,
				[7465136166] = 2,
				[11424731604] = 2,
			}

			local GAME_PLACE_ID = game.PlaceId

			if SEA_PLACES[GAME_PLACE_ID] then
				local config = {
					API_KEY = TrackStatsApiKey,
					Send_Interval_Seconds = math.random(200, 300),
					Max_Retries = 3,
					Retry_Delay = 5,
					Debug_Mode = false,
				}

				local API_URL = nil

				local function getStatsFolder()
					return ReplicatedStorage:FindFirstChild("Stats" .. Player.Name)
				end

				local function getPlayerLevel()
					local result = nil
					pcall(function()
						local statsFolder = getStatsFolder()
						if statsFolder and statsFolder:FindFirstChild("Stats") then
							local level = statsFolder.Stats:FindFirstChild("Level")
