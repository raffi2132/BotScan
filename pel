	-- Vera: no distance gates, no tween. Hand her straight to the hover engine (quest5 style) so it
	-- flies to a point above her and follows her; the m1 loop swings while it does.
	local lastVeraLog = 0
	-- REGEN BEFORE VERA (user 2026-10-28): once the last mob group before her (Part4, Barrier6) is cleared
	-- and the walk to her arena (Part5) is next, stand still until HP is back to max, then go. Vera only
	-- spawns when her fight starts, so this is the step-5 walk, never with a Vera around. Once per run; ends
	-- early if we take damage (something's on us) or after VeraRegenMax (180s). Returns true while waiting.
	-- ZephyronCombat.VeraRegen = false: off.
	ZQ5 = ZQ5 or {}
	function ZQ5.preVeraRegen()
		local cfg = getgenv().ZephyronCombat or {}
		local st = ZQ5.veraRegen
		if cfg.VeraRegen == false or (st and st.done) then
			return false
		end
		local hum = Character and Character:FindFirstChildOfClass("Humanoid")
		if not (hum and PlayerHumpart) or hum.Health <= 0 then
			return false
		end
		local function finish(why)
			ZQ5.veraRegen = { done = true }
			print(string.format("[VERA] regen: %s (%.0f / %.0f HP), walking to her arena", why, hum.Health, hum.MaxHealth))
			return false
		end
		if hum.Health >= hum.MaxHealth - 1 then
			if st then
				return finish("full")
			end
			ZQ5.veraRegen = { done = true }
			return false
		end
		if not st then
			-- start only right where the last group was (Part4), with no live mob within 150 -- never halfway
			-- down the walk to the arena
			if (PlayerHumpart.Position - Vector3.new(9677.1, 512.7, -28457.7)).Magnitude > 80 then
				return false
			end
			for _, n in ipairs(workspace.NPCs:GetChildren()) do
				local h = n:FindFirstChildOfClass("Humanoid")
				local r = n:FindFirstChild("HumanoidRootPart")
				if h and r and h.Health > 0 and (r.Position - PlayerHumpart.Position).Magnitude <= 150 then
					return false
				end
			end
			st = { at = tick(), hp = hum.Health }
			ZQ5.veraRegen = st
			print(string.format("[VERA] regen: last group cleared, waiting for full HP before her arena (%.0f / %.0f)", hum.Health, hum.MaxHealth))
		end
		if hum.Health < st.hp - 1 then
			return finish("took damage while waiting")
		end
		st.hp = hum.Health
		if tick() - st.at > (cfg.VeraRegenMax or 180) then
			return finish("time cap")
		end
		task.wait(0.5)
		return true
	end

	-- VERA KILLED (user 2026-11-01: after the Floor 5 Vera died it Goro-hopped 364 studs to a leftover mob until the
	-- game's teleport to the finished base). Her Humanoid's Died (we're alive, on Floor 5) marks it; for 60s, while no
	-- live Vera is around, every picker returns nothing and the Floor 5 steps wait for the teleport.
	function ZQ5.watchVera(v)
		if not v or ZQ5.veraHooked == v then
			return
		end
		ZQ5.veraHooked = v
		local h = v:FindFirstChildOfClass("Humanoid")
		if h then
			h.Died:Connect(function()
				pcall(ZQ5.veraKilled, "died")
			end)
			h:GetPropertyChangedSignal("Health"):Connect(function()
				if h.Health <= 0 then
					pcall(ZQ5.veraKilled, "health 0")
				end
			end)
		end
	end
	function ZQ5.veraKilled(how)
		if ZQ5.veraKilledAt and tick() - ZQ5.veraKilledAt < 60 then
			return
		end
		local me = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if workspace.Islands:FindFirstChild("Impel Base - Floor 5") and me and me.Health > 0 then
			ZQ5.veraKilledAt = tick()
			print("[VERA] killed (" .. tostring(how) .. ") - fighting nothing else, waiting for the teleport to the finished base")
		end
	end
	task.spawn(function()
		while task.wait(0.5) do
			pcall(function()
				if not workspace.Islands:FindFirstChild("Impel Base - Floor 5") then
					ZQ5.veraLastSeen = nil
					return
				end
				local v
				for _, n in ipairs(workspace.NPCs:GetChildren()) do
					if string.find(n.Name, "Vera", 1, true) or string.find(tostring(n:GetAttribute("RealName") or ""), "Vera", 1, true) then
						v = n
						break
					end
				end
				local h = v and v:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then
					ZQ5.watchVera(v)
					ZQ5.veraLastSeen, ZQ5.veraLastHp = tick(), h.Health / math.max(h.MaxHealth, 1)
				elseif ZQ5.veraLastSeen and tick() - ZQ5.veraLastSeen < 3 and (ZQ5.veraLastHp or 1) < 0.1 then
					ZQ5.veraLastSeen = nil
					ZQ5.veraKilled("gone at low HP")
				end
			end)
		end
	end)
	function ZQ5.veraDone()
		if not (ZQ5.veraKilledAt and tick() - ZQ5.veraKilledAt < 60) then
			return false
		end
		local v = workspace.NPCs:FindFirstChild("Warden of Impel Down, Vera")
		local h = v and v:FindFirstChildOfClass("Humanoid")
