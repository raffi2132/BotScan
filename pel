				end

				local function getPlayerBounty()
					local result = nil
					pcall(function()
						local statsFolder = getStatsFolder()
						if statsFolder and statsFolder:FindFirstChild("Stats") then
							local bounty = statsFolder.Stats:FindFirstChild("Bounty")
							if bounty then
								result = bounty.Value
							end
						end
					end)
