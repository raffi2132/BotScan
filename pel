		end
		return tick() - (ZQ5.cutsceneAt or 0) < 1.5
	end
	-- RESPAWN (user 2026-10-27: TP Check right after dying and respawning): nothing cleared the old fight
	-- state, so the hover / walker (and the hover grace's held spot) could act on the new character
	-- toward the old fight. Clear it all and hold still ~3s (the cutscene hold) while the game places us.
	game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function(newChar)
