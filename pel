	-- STALE MARKER (user 2026-11-01: Llinaratostape stood 17+ min on Floor 3 under 7 copies of the FourthStageZone
	-- marker -- no NPC alive, ThirdStageBarrier2 open; normal runs saw the marker move on to FifthStageZone). A marker
	-- we've stood within 15 (flat) of for 20s with no live mob within 200 is stale: ignored from then on, and on
	-- Floor 3's later stages the next zone in order is the target instead (where the marker would have gone).
	ZQ5.staleMarkers = ZQ5.staleMarkers or {}
	local function markerKey(p)
		return string.format("%d,%d,%d", math.floor(p.X + 0.5), math.floor(p.Y + 0.5), math.floor(p.Z + 0.5))
	end
	function ZQ5.isStaleMarker(p)
		return ZQ5.staleMarkers[markerKey(p)] == true
	end
	local F3_STAGE_ORDER = { "ThirdStageZone", "FourthStageZone", "FifthStageZone", "BossStartZone", "End" }
	local function inZone(z, p, margin)
		local l = z.CFrame:PointToObjectSpace(p)
		margin = margin or 0
		return math.abs(l.X) <= z.Size.X / 2 + margin and math.abs(l.Z) <= z.Size.Z / 2 + margin
			and math.abs(l.Y) <= z.Size.Y / 2 + margin
	end
	-- RE-ENTER (user 2026-11-01: on Llinaratostape, walking out of the stuck zone and back in spawned the mob --
	-- the stage spawns on ENTERING its zone, and we'd been standing in it). For a stale marker in a stage zone:
	-- the zone, and a spot 12 outside its edge toward the stage before (the way we came in).
	function ZQ5.reenterPlan(markerPos)
		local zones = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("Zones")
		if not zones then
			return nil
		end
		for i, name in ipairs(F3_STAGE_ORDER) do
			local z = zones:FindFirstChild(name)
			if z and z:IsA("BasePart") and inZone(z, markerPos) then
				local prev = i > 1 and zones:FindFirstChild(F3_STAGE_ORDER[i - 1])
				if not (prev and prev:IsA("BasePart")) then
					return nil
				end
				local d = Vector3.new(prev.Position.X - z.Position.X, 0, prev.Position.Z - z.Position.Z)
				if d.Magnitude < 1 then
					return nil
				end
				d = d.Unit
				-- step out along d until outside the zone's footprint, then 12 more
				local out = Vector3.new(z.Position.X, PlayerHumpart.Position.Y, z.Position.Z)
				for _ = 1, 200 do
					out = out + d * 2
					if not inZone(z, Vector3.new(out.X, z.Position.Y, out.Z)) then
						break
					end
				end
				return z, out + d * 12
			end
		end
		return nil
	end
