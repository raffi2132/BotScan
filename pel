				local conn = pg and pg.ChildAdded:Connect(function(c)
					if c.Name == "DiffChooser" then
						sawPicker = true
					end
				end)
				if pg and pg:FindFirstChild("DiffChooser") then
					sawPicker = true
				end
				task.wait(90)
				if conn then
					conn:Disconnect()
				end
				local rows = { "==== " .. os.date("%Y-%m-%d %H:%M:%S") .. " | job " .. tostring(game.JobId) .. " | difficulty picker seen in the first 90s: " .. tostring(sawPicker) }
				local function attrs(label, inst)
					local a = {}
					pcall(function()
						for k, v in pairs(inst:GetAttributes()) do
							a[#a + 1] = k .. "=" .. tostring(v)
						end
					end)
					if #a > 0 then
						rows[#rows + 1] = label .. " attrs: " .. table.concat(a, ", ")
					end
				end
				attrs("workspace", workspace)
				attrs("player", LocalPlayer)
				attrs("ReplicatedStorage", game:GetService("ReplicatedStorage"))
				attrs("Lighting", game:GetService("Lighting"))
				local isl = workspace:FindFirstChild("Islands")
				local names = {}
				for _, c in ipairs(isl and isl:GetChildren() or {}) do
					names[#names + 1] = c.Name
				end
				rows[#rows + 1] = "islands: " .. table.concat(names, ", ")
				local function scan(label, root, limit)
					local n = 0
					for i, d in ipairs(root:GetDescendants()) do
						if i % 300 == 0 then
							task.wait()
						end
						local t, v = "", nil
						pcall(function()
							if d:IsA("TextLabel") or d:IsA("TextButton") then
								t = d.Text
							elseif d:IsA("ValueBase") then
								v = tostring(d.Value)
							end
						end)
						local hay = string.lower(d.Name .. " " .. t .. " " .. (v or ""))
						-- (whole words for hard / normal / mode: "shards", "abnormal", "model" are noise)
						if string.find(hay, "nightmare") or string.find(hay, "difficult") or string.find(hay, "%f[%a]hard%f[%A]")
							or string.find(hay, "%f[%a]normal%f[%A]") or string.find(hay, "%f[%a]mode%f[%A]") then
							n = n + 1
							if n <= limit then
								rows[#rows + 1] = string.format("%s: %s %s%s%s", label, d.ClassName, d:GetFullName(),
									t ~= "" and (" | text " .. string.format("%q", t)) or "", v and (" | value " .. v) or "")
							end
						end
					end
				end
				scan("gui", pg, 40)
				scan("RS", game:GetService("ReplicatedStorage"), 40)
				local st = game:GetService("ReplicatedStorage"):FindFirstChild("Stats" .. LocalPlayer.Name)
				if st then
					scan("stats", st, 40)
				end
				local old = ""
				pcall(function()
					old = readfile("impel_runs_" .. LocalPlayer.Name .. ".txt")
				end)
				if #old > 80000 then
					old = string.sub(old, -40000)
				end
				writefile("impel_runs_" .. LocalPlayer.Name .. ".txt", old .. table.concat(rows, string.char(10)) .. string.char(10))
			end)
