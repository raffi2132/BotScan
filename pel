-- RUN LOG (2026-11-03): every line this script prints / warns is also saved, time-stamped, to
-- workspace\runlog_<name>.txt (flushed every 3s), so a whole run can be read back afterwards -- the
-- executor console only keeps the last few minutes. Logging only: nothing here changes what the script
-- does, and every file call is pcall'd (no appendfile -> no log). The file is cut back to its last 2 MB
-- when it passes 4 MB.
-- (NO new locals at this level: the main body sits at Luau's 200-locals limit -- `local print, warn`
-- here broke the whole script with "Out of local registers". print / warn are swapped in this script's
-- environment instead; the originals are kept in getgenv so a re-run doesn't wrap them twice.)
do
	local rawPrint = getgenv().HauRawPrint or print
	local rawWarn = getgenv().HauRawWarn or warn
	getgenv().HauRawPrint, getgenv().HauRawWarn = rawPrint, rawWarn
	local buf, fname, trimmed = {}, nil, false
	local sinceTrim = 0
	-- HauLog(file, line) (2026-11-07, phone lag spikes / memory): APPEND a line. jailer_slash, boss_skills and
	-- fruit_skills used to READ the whole file and WRITE it all back for every line, with no size cap --
	-- jailer_slash reached 10 MB, boss_skills 2.4 MB (~25 rewrites a Vera fight, a burst when Hydra's new
	-- animations show up). Now: the first line of a session cuts a file over 1 MB back to its last 300 KB
	-- (one read), every line after that is a plain append.
	local cutFiles = {}
	function HauLog(file, line)
		pcall(function()
			if typeof(appendfile) ~= "function" then
				return
			end
			if not cutFiles[file] then
				cutFiles[file] = true
				if isfile(file) then
					local old = readfile(file)
					if #old > 1000000 then
						writefile(file, string.sub(old, -300000))
					end
				else
					writefile(file, "")
				end
			end
			appendfile(file, line .. string.char(10))
		end)
	end
	local function add(tag, ...)
		local args = table.pack(...) -- (an inner function can't use the outer `...`)
		pcall(function()
			local n = args.n
			local parts = table.create(n)
			for i = 1, n do
				parts[i] = tostring(args[i])
			end
			if #buf < 3000 then
				buf[#buf + 1] = os.date("%m-%d %H:%M:%S ") .. tag .. table.concat(parts, " ")
			end
		end)
	end
	local function flush()
		pcall(function()
			if typeof(appendfile) ~= "function" then
				return
			end
			if not fname then
				local lp = game:GetService("Players").LocalPlayer
				if not lp then
					return
				end
				fname = "runlog_" .. lp.Name .. ".txt"
			end
			-- (also mid-session: one session grew a run log to 9.9 MB, read back whole at the next start)
			if sinceTrim > 1500000 then
				trimmed, sinceTrim = false, 0
			end
			if not trimmed then
				trimmed = true
				pcall(function()
					if isfile(fname) then
						local old = readfile(fname)
						if #old > 3000000 then
							writefile(fname, string.sub(old, -1500000))
						end
					else
						writefile(fname, "")
					end
				end)
				table.insert(buf, 1, os.date("%m-%d %H:%M:%S ") .. "==== script start (or log trim) | place " .. tostring(game.PlaceId) .. " | job " .. tostring(game.JobId))
			end
			if #buf > 0 then
				local out = table.concat(buf, string.char(10)) .. string.char(10)
				buf = {}
				appendfile(fname, out)
				sinceTrim = sinceTrim + #out
			end
		end)
	end
	task.spawn(function()
		while true do
			task.wait(3)
			flush()
		end
	end)
	print = function(...)
		add("", ...)
		local first0 = (...) -- (taken out here: an inner function can't use the outer `...`)
		pcall(function()
			local first = tostring(first0)
			if not (string.find(first, "^%[STATE%]") or string.find(first, "^%[M1%]") or string.find(first, "^%[ANIM%]")) then
				HauLastLine = os.date("%H:%M:%S ") .. string.sub(first, 1, 90)
			end
		end)
		return rawPrint(...)
	end
	warn = function(...)
		add("WARN ", ...)
		return rawWarn(...)
	end
end

