		local route = ZQ5.F3_ROUTE
		local reached = ZQ5.f3Reached or 0
		local idx
		if pos then
			for i, name in ipairs(route) do
				if (ThirdFloor[name].Position - pos).Magnitude < 1 then
					idx = i
					break
				end
			end
		end
		local out = pos
		if not idx then
			if reached > 0 then
				out = ThirdFloor[route[reached]].Position
