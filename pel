	function HauWebhook(url, embed, content)
		pcall(function()
			url = tostring(url or "")
			if not string.find(url, "discord", 1, true) or not string.find(url, "webhooks", 1, true) then
				return
			end
			local req = (typeof(http_request) == "function" and http_request)
				or (typeof(request) == "function" and request)
				or (syn and typeof(syn.request) == "function" and syn.request)
			if not req then
				return
			end
			local misc = getgenv().Config and getgenv().Config.Misc or {}
			local icon = type(misc.WebhookIcon) == "string" and misc.WebhookIcon ~= "" and misc.WebhookIcon or nil
			embed.author = { name = HAU.name, icon_url = icon }
			embed.footer = { text = HAU.name .. " \u{2022} Impel Down", icon_url = icon }
			embed.timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
			for _, f in ipairs(embed.fields or {}) do
				f.name = tostring(f.name)
				f.value = string.sub(tostring(f.value), 1, 1000)
			end
			local body = game:GetService("HttpService"):JSONEncode({
				username = HAU.name,
				avatar_url = icon,
				content = content,
				embeds = { embed },
			})
			req({ Url = url, Body = body, Method = "POST", Headers = { ["content-type"] = "application/json" } })
		end)
	end
